@{
    ViewData["Title"] = "Circuit Board";
}

@section Styles {
    <style>
        /* ---- Circuit Board viewer: the live schematic ---- */
        .cb-toolbar {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            padding: 10px 12px;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            background: var(--bg-card-alt);
            margin-bottom: 10px;
        }

            .cb-toolbar select, .cb-toolbar button {
                padding: 6px 12px;
                border: 1px solid var(--border-light);
                border-radius: var(--radius-md);
                background: var(--bg-card);
                color: var(--text-primary);
                font-size: 12.5px;
                cursor: pointer;
            }

                .cb-toolbar button:hover { border-color: var(--accent); }
                .cb-toolbar button.cb-active { border-color: var(--accent); color: var(--accent); }

        .cb-status { font-size: 12px; color: var(--text-secondary); margin-left: auto; }

        /* overlay — absolutely positioned over the board so showing/hiding NEVER shifts layout */
        .cb-wedge {
            display: none;
            position: absolute;
            top: 8px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 5;
            max-width: 90%;
            padding: 7px 14px;
            border: 1px solid var(--danger, #f7768e);
            border-radius: var(--radius-md);
            color: var(--danger, #f7768e);
            background: var(--bg-card-alt);
            box-shadow: 0 4px 14px rgba(0,0,0,0.35);
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            pointer-events: none;
        }

        .cb-band { fill: var(--bg-card-alt); fill-opacity: 0.45; stroke: var(--border-light); stroke-width: 1; }

        /* ── the two programs, told apart at a glance ──────────────────────
           C# keeps the house accent; C++ gets its own hue, so a wedge whose
           cause lives on the far side of the wire is visible from across the
           room. Both are theme variables with literal fallbacks. */
        .cb-band.cb-side-cpp { fill: var(--info, #7aa2f7); fill-opacity: 0.10; stroke: var(--info, #7aa2f7); stroke-opacity: 0.35; }
        .cb-lane-head.cb-side-cpp { fill: var(--info, #7aa2f7); }
        .cb-node.cb-side-cpp .cb-rect { fill: var(--info, #7aa2f7); stroke: var(--info, #7aa2f7); stroke-opacity: 0.45; }
        .cb-node.cb-side-cpp .cb-rect.cb-on { stroke: var(--info, #7aa2f7); stroke-opacity: 1; stroke-width: 2; }

        .cb-sec-head {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            fill: var(--text-secondary);
            pointer-events: none;
        }

            .cb-sec-head.cb-side-cpp { fill: var(--info, #7aa2f7); }

        /* The wire itself: the boundary the whole instrument was built to see across. */
        .cb-wire { fill: var(--accent); fill-opacity: 0.14; stroke: var(--accent); stroke-opacity: 0.5; stroke-dasharray: 6 4; }

            .cb-wire.cb-wire-quiet { fill: var(--text-secondary); fill-opacity: 0.06; stroke: var(--text-secondary); stroke-opacity: 0.3; }

        .cb-wire-head {
            fill: var(--accent);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-anchor: middle;
            pointer-events: none;
        }

            .cb-wire-head.cb-wire-quiet-head { fill: var(--text-secondary); font-weight: 600; letter-spacing: 0.5px; }

        /* A chain link — the same command seen from both sides. */
        .cb-edge.cb-chain { stroke: var(--warning, #e0af68); stroke-opacity: 0.9; stroke-dasharray: 5 4; }

        .cb-chain-tag {
            fill: var(--warning, #e0af68);
            font-size: 10px;
            font-weight: 700;
            text-anchor: middle;
            pointer-events: none;
        }

        #cbSides { font-weight: 700; white-space: nowrap; }

        .cb-two-sided { color: var(--info, #7aa2f7); }
        .cb-one-sided { color: var(--text-secondary); }

        .cb-seg.cb-side-cpp { border-left: 3px solid var(--info, #7aa2f7); }

        /* A hit another thread wrote into this segment: present in the recording,
           but NOT a step in this path. Shown, dimmed, never joined by an edge. */
        .cb-hit.cb-foreign { opacity: 0.55; font-style: italic; }

        #cbSteady { color: var(--text-secondary); font-weight: 700; min-width: 34px; }

        .cb-stage { position: relative; }

        .cb-board {
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            background: var(--bg-card);
            height: calc(100vh - 265px);
            min-height: 420px;
            overflow: hidden;
            cursor: grab;
        }

            .cb-board:active { cursor: grabbing; }

            .cb-board svg { width: 100%; height: 100%; display: block; }

        .cb-lane-head {
            fill: var(--accent);
            font-size: 13px;
            font-weight: 700;
            text-anchor: middle;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .cb-rect {
            fill: var(--accent);
            fill-opacity: 0;
            stroke: var(--border-light);
            stroke-width: 1;
        }

            .cb-rect.cb-on { stroke: var(--accent); stroke-width: 2; }
            .cb-rect.cb-sel { stroke: var(--warning, #e0af68); stroke-width: 2.5; }

        .cb-node { cursor: pointer; }

            .cb-node text {
                fill: var(--text-primary);
                font-family: var(--font-mono, ui-monospace, monospace);
                font-size: 10.5px;
                pointer-events: none;
            }

        .cb-dim { opacity: 0.25; }

        .cb-edge {
            fill: none;
            stroke: var(--text-secondary);
            stroke-opacity: 0.30;
            stroke-linecap: round;
        }

            .cb-edge.cb-edge-on { stroke: var(--accent); stroke-opacity: 0.95; }

        .cb-detail {
            display: none;
            position: absolute;
            top: 10px;
            right: 10px;
            width: 270px;
            padding: 12px;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            background: var(--bg-card-alt);
            font-size: 12px;
            box-shadow: 0 4px 14px rgba(0,0,0,0.25);
        }

            .cb-detail .cbd-lane { color: var(--accent); font-weight: 700; text-transform: uppercase; font-size: 11px; }
            .cb-detail .cbd-desc { margin: 4px 0 8px; color: var(--text-primary); font-weight: 600; }
            .cb-detail .cbd-row { color: var(--text-secondary); margin: 2px 0; }
            .cb-detail .cbd-close { margin-top: 8px; color: var(--text-secondary); font-size: 10.5px; font-style: italic; }

        .cb-footer {
            display: flex;
            gap: 14px;
            align-items: baseline;
            padding: 8px 12px;
            margin-top: 8px;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            background: var(--bg-card-alt);
            font-family: var(--font-mono, ui-monospace, monospace);
            font-size: 11.5px;
        }

            .cb-footer .cb-now-label { color: var(--accent); font-weight: 700; white-space: nowrap; }
            .cb-footer #cbNow { color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
            .cb-footer #cbPos { color: var(--text-secondary); white-space: nowrap; }

        /* feed tab (the opt-in raw wall) */
        .cb-feed {
            display: none;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            background: var(--bg-card);
            font-family: var(--font-mono, ui-monospace, monospace);
            font-size: 12px;
            height: calc(100vh - 265px);
            min-height: 420px;
            overflow-y: auto;
        }

        .cb-seg { padding: 6px 12px; border-bottom: 1px solid var(--border-light); }

        .cb-seg-head { color: var(--text-secondary); margin-bottom: 3px; font-size: 11px; }

            .cb-seg-head .cb-kind { color: var(--accent); font-weight: 600; margin-right: 8px; }

        .cb-hit { padding: 1px 0 1px 16px; color: var(--text-primary); }

            .cb-hit b { color: var(--accent); }

        .cb-cycle { border-left: 3px solid var(--danger, #f7768e); }

        .cb-empty { padding: 30px; text-align: center; color: var(--text-secondary); font-size: 13px; }
    </style>
}

<div class="cb-toolbar">
    <select id="cbBot"><option value="0">— pick a bot —</option></select>
    <button id="cbArm" title="Write this bot's trace to the daily file continuously">Arm</button>
    <button id="cbDisarm" title="Stop writing (ring keeps recording in shadow)">Disarm</button>
    <button id="cbDump" title="Flush this bot's whole ring to the daily file now">Dump</button>
    <button id="cbShadow" title="Global: shadow rings record every bot in memory">Shadow: ?</button>
    <span style="width:1px;height:20px;background:var(--border-light)"></span>
    <button id="cbTabBoard" class="cb-active" title="The schematic: lanes light up as the bot decides">Board</button>
    <button id="cbTabFeed" title="Raw decoded segment feed">Feed</button>
    <button id="cbAllLanes" title="Show every registered lane, not just active ones">All lanes</button>
    <button id="cbFit" title="Fit the board to the window width">Fit</button>
    <button id="cbPause">Pause</button>
    <button id="cbPacket" title="Download the whole decoded window as a markdown packet — paste it to an LLM">Packet ⭳</button>
    <span class="cb-status" id="cbStatus">—</span>
</div>

<div class="cb-stage">
    <div class="cb-wedge" id="cbWedge"></div>
    <div class="cb-board" id="cbBoardWrap">
        <div id="cbBoard" style="width:100%;height:100%">
            <svg id="cbSvg" xmlns="http://www.w3.org/2000/svg">
                <g id="cbBands"></g>
                <g id="cbEdges"></g>
                <g id="cbHeads"></g>
                <g id="cbNodes"></g>
            </svg>
        </div>
    </div>
    <div class="cb-feed" id="cbFeed"></div>
    <div class="cb-detail" id="cbDetail"></div>
</div>

<div class="cb-footer">
    <span class="cb-now-label">this tick</span>
    <span id="cbSteady"></span>
    <span id="cbSides" title="Whether this window actually contains BOTH programs"></span>
    <span id="cbNow">pick a bot — shadow mode must be on for anything to record</span>
    <span id="cbPos"></span>
</div>

@section Scripts {
    <script src="~/js/circuittrace.js" asp-append-version="true"></script>
}
