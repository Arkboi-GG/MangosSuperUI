@model MangosSuperUI.Services.CircuitTraceSourceSetupStatus

@{
    ViewData["Title"] = "Circuit Board";
    string? circuitAppRevision = MangosSuperUI.Services.CircuitTraceSourceService.InstalledApplicationRevision;
    string? circuitAppArchiveUrl = MangosSuperUI.Services.CircuitTraceSourceService.InstalledApplicationSourceArchiveUrl;
    string circuitAppRevisionShort = circuitAppRevision is { Length: > 12 }
        ? circuitAppRevision[..12]
        : circuitAppRevision ?? "unknown";
}

@section Styles {
    <style>
        .cb-source-setup {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: clamp(24px, 6vw, 72px);
            background:
                radial-gradient(circle at 50% 28%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 38%),
                var(--bg-body);
        }

        .cb-source-setup-card {
            width: min(680px, 100%);
            padding: clamp(26px, 5vw, 46px);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-lg);
            background: var(--bg-card);
            box-shadow: var(--shadow-lg);
            text-align: center;
        }

        .cb-source-setup-icon {
            display: grid;
            place-items: center;
            width: 58px;
            height: 58px;
            margin: 0 auto 18px;
            border-radius: 50%;
            background: var(--accent-light);
            color: var(--accent);
            font-size: 24px;
        }

        .cb-source-setup h1 {
            margin: 0;
            color: var(--text-primary);
            font-size: clamp(24px, 4vw, 34px);
            line-height: 1.15;
        }

        .cb-source-setup-intro {
            max-width: 560px;
            margin: 12px auto 0;
            color: var(--text-secondary);
            font-size: 14px;
            line-height: 1.65;
        }

        .cb-source-setup-list {
            display: grid;
            gap: 10px;
            margin: 24px 0;
            padding: 0;
            list-style: none;
            text-align: left;
        }

        .cb-source-setup-list li {
            display: grid;
            grid-template-columns: 22px minmax(0, 1fr);
            gap: 10px;
            padding: 13px 15px;
            border: 1px solid color-mix(in srgb, var(--status-warning) 38%, var(--border-light));
            border-radius: var(--radius-md);
            background: color-mix(in srgb, var(--status-warning) 7%, var(--bg-card-alt));
        }

        .cb-source-setup-list i { margin-top: 2px; color: var(--status-warning); }
        .cb-source-setup-list strong { display: block; color: var(--text-primary); font-size: 13.5px; }
        .cb-source-setup-list span { display: block; margin-top: 3px; color: var(--text-secondary); font-size: 12.5px; line-height: 1.45; }
        .cb-source-setup-list a { color: var(--accent); }

        .cb-source-setup-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 17px;
            border: 1px solid var(--accent);
            border-radius: var(--radius-md);
            background: var(--accent);
            color: var(--text-on-accent);
            font-weight: 700;
            text-decoration: none;
        }

        .cb-source-setup-action:hover {
            border-color: var(--accent-hover);
            background: var(--accent-hover);
            color: var(--text-on-accent);
        }

        .cb-source-setup-note {
            margin: 16px 0 0;
            color: var(--text-muted);
            font-size: 11.5px;
            line-height: 1.5;
        }

        /* ---- Circuit Board viewer: the live schematic ---- */
        .cb-toolbar {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            padding: 10px 12px;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            background: var(--bg-card-alt);
            margin-bottom: 10px;
        }

            .cb-toolbar select, .cb-toolbar button {
                padding: 6px 12px;
                border: 1px solid var(--border-light);
                border-radius: var(--radius-md);
                background: var(--bg-card);
                color: var(--text-primary);
                font-size: 12.5px;
                cursor: pointer;
            }

                .cb-toolbar button:hover { border-color: var(--accent); }
                .cb-toolbar button.cb-active { border-color: var(--accent); color: var(--accent); }

        .cb-status { font-size: 12px; color: var(--text-secondary); margin-left: auto; }

        /* overlay — absolutely positioned over the board so showing/hiding NEVER shifts layout */
        .cb-wedge {
            display: none;
            position: absolute;
            top: 8px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 5;
            max-width: 90%;
            padding: 7px 14px;
            border: 1px solid var(--danger, #f7768e);
            border-radius: var(--radius-md);
            color: var(--danger, #f7768e);
            background: var(--bg-card-alt);
            box-shadow: 0 4px 14px rgba(0,0,0,0.35);
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            pointer-events: none;
        }

        .cb-band { fill: var(--bg-card-alt); fill-opacity: 0.45; stroke: var(--border-light); stroke-width: 1; }

        /* ── the two programs, told apart at a glance ──────────────────────
           C# keeps the house accent; C++ gets its own hue, so a wedge whose
           cause lives on the far side of the wire is visible from across the
           room. Both are theme variables with literal fallbacks. */
        .cb-band.cb-side-cpp { fill: var(--info, #7aa2f7); fill-opacity: 0.10; stroke: var(--info, #7aa2f7); stroke-opacity: 0.35; }
        .cb-lane-head.cb-side-cpp { fill: var(--info, #7aa2f7); }
        .cb-node.cb-side-cpp .cb-rect { fill: var(--info, #7aa2f7); stroke: var(--info, #7aa2f7); stroke-opacity: 0.45; }
        .cb-node.cb-side-cpp .cb-rect.cb-on { stroke: var(--info, #7aa2f7); stroke-opacity: 1; stroke-width: 2; }

        .cb-sec-head {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            fill: var(--text-secondary);
            pointer-events: none;
        }

            .cb-sec-head.cb-side-cpp { fill: var(--info, #7aa2f7); }

        /* The wire itself: the boundary the whole instrument was built to see across. */
        .cb-wire { fill: var(--accent); fill-opacity: 0.14; stroke: var(--accent); stroke-opacity: 0.5; stroke-dasharray: 6 4; }

            .cb-wire.cb-wire-quiet { fill: var(--text-secondary); fill-opacity: 0.06; stroke: var(--text-secondary); stroke-opacity: 0.3; }

        .cb-wire-head {
            fill: var(--accent);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-anchor: middle;
            pointer-events: none;
        }

            .cb-wire-head.cb-wire-quiet-head { fill: var(--text-secondary); font-weight: 600; letter-spacing: 0.5px; }

        /* A chain link — the same command seen from both sides. */
        .cb-edge.cb-chain { stroke: var(--warning, #e0af68); stroke-opacity: 0.9; stroke-dasharray: 5 4; }

        .cb-chain-tag {
            fill: var(--warning, #e0af68);
            font-size: 10px;
            font-weight: 700;
            text-anchor: middle;
            pointer-events: none;
        }

        #cbSides { font-weight: 700; white-space: nowrap; }

        .cb-two-sided { color: var(--info, #7aa2f7); }
        .cb-one-sided { color: var(--text-secondary); }

        .cb-seg.cb-side-cpp { border-left: 3px solid var(--info, #7aa2f7); }

        /* A hit another thread wrote into this segment: present in the recording,
           but NOT a step in this path. Shown, dimmed, never joined by an edge. */
        .cb-hit.cb-foreign { opacity: 0.55; font-style: italic; }

        #cbSteady { color: var(--text-secondary); font-weight: 700; min-width: 34px; }

        .cb-stage { position: relative; }

        .cb-board {
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            background: var(--bg-card);
            height: calc(100vh - 265px);
            min-height: 420px;
            overflow: hidden;
            cursor: grab;
        }

            .cb-board:active { cursor: grabbing; }

            .cb-board svg { width: 100%; height: 100%; display: block; }

        .cb-lane-head {
            fill: var(--accent);
            font-size: 13px;
            font-weight: 700;
            text-anchor: middle;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .cb-rect {
            fill: var(--accent);
            fill-opacity: 0;
            stroke: var(--border-light);
            stroke-width: 1;
        }

            .cb-rect.cb-on { stroke: var(--accent); stroke-width: 2; }
            .cb-rect.cb-sel { stroke: var(--warning, #e0af68); stroke-width: 2.5; }

        .cb-node { cursor: pointer; }

            .cb-node text {
                fill: var(--text-primary);
                font-family: var(--font-mono, ui-monospace, monospace);
                font-size: 10.5px;
                pointer-events: none;
            }

        .cb-dim { opacity: 0.25; }

        .cb-edge {
            fill: none;
            stroke: var(--text-secondary);
            stroke-opacity: 0.30;
            stroke-linecap: round;
        }

            .cb-edge.cb-edge-on { stroke: var(--accent); stroke-opacity: 0.95; }

        .cb-detail {
            display: none;
            position: absolute;
            top: 10px;
            right: 10px;
            width: 270px;
            padding: 12px;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            background: var(--bg-card-alt);
            font-size: 12px;
            box-shadow: 0 4px 14px rgba(0,0,0,0.25);
        }

            .cb-detail .cbd-lane { color: var(--accent); font-weight: 700; text-transform: uppercase; font-size: 11px; }
            .cb-detail .cbd-desc { margin: 4px 0 8px; color: var(--text-primary); font-weight: 600; }
            .cb-detail .cbd-row { color: var(--text-secondary); margin: 2px 0; }
            .cb-detail .cbd-close { margin-top: 8px; color: var(--text-secondary); font-size: 10.5px; font-style: italic; }

        .cb-footer {
            display: flex;
            gap: 14px;
            align-items: baseline;
            padding: 8px 12px;
            margin-top: 8px;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            background: var(--bg-card-alt);
            font-family: var(--font-mono, ui-monospace, monospace);
            font-size: 11.5px;
        }

            .cb-footer .cb-now-label { color: var(--accent); font-weight: 700; white-space: nowrap; }
            .cb-footer #cbNow { color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
            .cb-footer #cbPos { color: var(--text-secondary); white-space: nowrap; }

        /* feed tab (the opt-in raw wall) */
        .cb-feed {
            display: none;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            background: var(--bg-card);
            font-family: var(--font-mono, ui-monospace, monospace);
            font-size: 12px;
            height: calc(100vh - 265px);
            min-height: 420px;
            overflow-y: auto;
        }

        .cb-seg { padding: 6px 12px; border-bottom: 1px solid var(--border-light); }

        .cb-seg-head { color: var(--text-secondary); margin-bottom: 3px; font-size: 11px; }

            .cb-seg-head .cb-kind { color: var(--accent); font-weight: 600; margin-right: 8px; }

        .cb-hit { padding: 1px 0 1px 16px; color: var(--text-primary); }

            .cb-hit b { color: var(--accent); }

        .cb-cycle { border-left: 3px solid var(--danger, #f7768e); }

        .cb-empty { padding: 30px; text-align: center; color: var(--text-secondary); font-size: 13px; }

        /* ── Activity reader ─────────────────────────────────────────────────
           A human-scale view of the trace: repeated healthy work is one quiet,
           collapsed episode; its decisions are readable in order; the literal
           source around the selected probe gets the largest reading surface. */
        .cb-history {
            display: grid;
            grid-template-columns: minmax(230px, .72fr) minmax(310px, 1fr) minmax(460px, 1.6fr);
            grid-template-rows: auto minmax(0, 1fr);
            gap: 10px;
            height: calc(100vh - 265px);
            min-height: 540px;
        }

        .cb-reader-pane,
        .cb-hist-list {
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            background: var(--bg-card);
            min-width: 0;
            min-height: 0;
        }

        .cb-reader-pane {
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .cb-pane-head {
            flex: 0 0 auto;
            padding: 10px 12px 9px;
            border-bottom: 1px solid var(--border-light);
            background: var(--bg-card-alt);
        }

        .cb-pane-title {
            display: flex;
            align-items: center;
            gap: 7px;
            color: var(--text-primary);
            font-size: 12px;
            font-weight: 750;
            letter-spacing: .25px;
        }

        .cb-pane-kicker {
            margin-top: 2px;
            color: var(--text-muted);
            font-size: 10.5px;
            line-height: 1.35;
        }

        .cb-hist-list-wrap { overflow: hidden; }

        .cb-hist-list {
            flex: 1 1 auto;
            border: 0;
            border-radius: 0;
            overflow-y: auto;
            font-size: 12px;
        }

        /* Old decision rows remain styled while the reader data migrates to
           macro episodes. New episode rows deliberately default to collapsed. */
        .cb-hist-row {
            padding: 7px 10px;
            border-bottom: 1px solid var(--border-light);
            border-left: 3px solid transparent;
            cursor: pointer;
        }

            .cb-hist-row:hover { background: var(--bg-card-alt); }
            .cb-hist-row.cb-hist-sel { border-left-color: var(--accent); background: var(--accent-light, rgba(122,162,247,0.12)); }
            .cb-hist-row.cb-side-cpp { border-left-color: var(--info, #7aa2f7); }
            .cb-hist-row.cb-hist-sel.cb-side-cpp { background: rgba(122,162,247,0.16); }

        .cb-hist-row-top { display: flex; align-items: baseline; gap: 8px; }
        .cb-hist-time { color: var(--text-secondary); font-family: var(--font-mono, ui-monospace, monospace); font-size: 11px; }
        .cb-hist-held { margin-left: auto; color: var(--text-muted); font-size: 10.5px; white-space: nowrap; }
        .cb-hist-label { margin-top: 2px; color: var(--text-primary); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .cb-hist-delta { margin-top: 3px; font-size: 10.5px; font-family: var(--font-mono, ui-monospace, monospace); }

        .cb-episode {
            border-bottom: 1px solid var(--border-light);
            border-left: 3px solid transparent;
            cursor: pointer;
            background: var(--bg-card);
        }

            .cb-episode:hover { background: var(--bg-card-alt); }
            .cb-episode.cb-selected,
            .cb-episode[aria-selected="true"] {
                border-left-color: var(--accent);
                background: color-mix(in srgb, var(--accent) 9%, var(--bg-card));
            }

            .cb-episode.cb-episode-normal { border-left-color: color-mix(in srgb, var(--success, #9ece6a) 45%, transparent); }
            .cb-episode.cb-episode-attention,
            .cb-episode.cb-attention,
            .cb-episode[data-attention="true"] {
                border-left-color: var(--danger, #f7768e);
                background: color-mix(in srgb, var(--danger, #f7768e) 6%, var(--bg-card));
            }

        .cb-episode-summary { padding: 9px 10px 8px; }
        .cb-episode-top { display: flex; flex-wrap: wrap; align-items: center; gap: 5px 7px; }
        .cb-episode-title { flex: 1 1 90px; min-width: 0; color: var(--text-primary); font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .cb-episode-time { margin-left: auto; color: var(--text-muted); font: 10.5px var(--font-mono, ui-monospace, monospace); white-space: nowrap; }
        .cb-episode-meta { display: flex; flex-wrap: wrap; gap: 4px 8px; margin-top: 4px; color: var(--text-secondary); font-size: 10.5px; }
        .cb-episode-status {
            flex: 0 0 auto;
            padding: 1px 6px;
            border: 1px solid var(--border-light);
            border-radius: 99px;
            color: var(--text-secondary);
            font-size: 9.5px;
            font-weight: 750;
            text-transform: uppercase;
        }
        .cb-episode-status.cb-status-ongoing {
            border-color: color-mix(in srgb, var(--danger, #f7768e) 60%, var(--border-light));
            color: var(--danger, #f7768e);
        }
        .cb-episode-status.cb-status-resolved { color: var(--success, #9ece6a); }
        .cb-episode-reason,
        .cb-episode-events { margin-top: 5px; color: var(--danger, #f7768e); font-size: 10.5px; line-height: 1.4; }
        .cb-episode-events { color: var(--text-secondary); }
        .cb-episode-state { color: var(--success, #9ece6a); font-weight: 700; }
        .cb-episode-attention .cb-episode-state,
        .cb-episode.cb-attention .cb-episode-state,
        .cb-episode[data-attention="true"] .cb-episode-state { color: var(--danger, #f7768e); }

        .cb-episode-body { display: none; padding: 0 10px 9px; }
        .cb-episode[aria-expanded="true"] .cb-episode-body,
        .cb-episode.cb-expanded .cb-episode-body { display: block; }

        .cb-activity-strip {
            display: flex;
            align-items: center;
            gap: 3px;
            min-width: 0;
            margin-top: 7px;
            overflow: hidden;
        }

        .cb-activity-chip {
            display: inline-flex;
            align-items: center;
            min-width: 5px;
            height: 6px;
            padding: 0;
            border-radius: 99px;
            background: var(--accent);
            color: transparent;
            font-size: 0;
            opacity: .75;
        }

            .cb-activity-chip.cb-search { background: var(--info, #7aa2f7); }
            .cb-activity-chip.cb-combat { background: var(--warning, #e0af68); }
            .cb-activity-chip.cb-loot { background: var(--accent); }
            .cb-activity-chip.cb-heal { background: var(--success, #9ece6a); }
            .cb-activity-chip.cb-wait { background: var(--text-muted); }
            .cb-activity-chip.cb-attention { min-width: 9px; background: var(--danger, #f7768e); opacity: 1; }

        .cb-hist-main {
            display: grid;
            grid-template-rows: auto auto minmax(130px, .9fr) minmax(150px, 1.1fr);
        }

        .cb-hist-bar {
            grid-column: 1 / -1;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            background: var(--bg-card-alt);
        }

            .cb-hist-bar button {
                padding: 5px 11px;
                border: 1px solid var(--border-light);
                border-radius: var(--radius-md);
                background: var(--bg-card);
                color: var(--text-primary);
                font-size: 12.5px;
                cursor: pointer;
            }

                .cb-hist-bar button:hover:not(:disabled) { border-color: var(--accent); }
                .cb-hist-bar button:disabled { opacity: 0.4; cursor: default; }

        .cb-hist-count { font-weight: 700; color: var(--text-primary); min-width: 96px; }
        #cbHistRefresh { margin-left: auto; }

        .cb-hist-new {
            display: none;
            padding: 2px 7px;
            border-radius: 99px;
            background: var(--accent);
            color: var(--bg-card);
            font-size: 10px;
            font-weight: 800;
            white-space: nowrap;
        }

            .cb-hist-new.cb-show { display: inline-flex; }

        .cb-hist-live {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            color: var(--text-secondary);
            font-size: 11px;
            white-space: nowrap;
        }

            .cb-hist-live::before {
                content: '';
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--success, #9ece6a);
                box-shadow: 0 0 0 3px color-mix(in srgb, var(--success, #9ece6a) 15%, transparent);
            }

            .cb-hist-live.cb-frozen::before,
            .cb-hist-live[data-state="frozen"]::before { background: var(--warning, #e0af68); box-shadow: none; }

        .cb-hist-hint { color: var(--text-muted); font-size: 11px; }

        .cb-hist-detail { padding: 12px 14px; overflow-y: auto; font-size: 12px; }
        .cb-hist-detail .cb-hd-head { color: var(--text-secondary); font-size: 11px; margin-bottom: 8px; }
        .cb-hist-detail .cb-hd-head b { color: var(--accent); }

        /* what actually changed at this decision */
        .cb-hd-diff { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 12px; }
        .cb-chip {
            display: inline-flex; align-items: center; gap: 4px;
            padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600;
            border: 1px solid var(--border-light);
        }
            .cb-chip.cb-chip-in { color: var(--success, #9ece6a); border-color: color-mix(in srgb, var(--success, #9ece6a) 45%, transparent); }
            .cb-chip.cb-chip-out { color: var(--danger, #f7768e); border-color: color-mix(in srgb, var(--danger, #f7768e) 45%, transparent); text-decoration: line-through; }
            .cb-chip.cb-chip-none { color: var(--text-muted); border-style: dashed; }

        .cb-hd-hit { padding: 1px 0 1px 14px; color: var(--text-primary); }
            .cb-hd-hit b { color: var(--accent); }
            .cb-hd-hit.cb-enter { border-left: 2px solid var(--success, #9ece6a); background: color-mix(in srgb, var(--success, #9ece6a) 8%, transparent); }
            .cb-hd-hit.cb-foreign { opacity: 0.55; font-style: italic; }

        .cb-decision-list { min-height: 0; padding: 0 10px 10px; overflow-y: auto; }
        .cb-decision-row {
            display: grid;
            grid-template-columns: 34px minmax(0, 1fr) auto;
            gap: 7px;
            align-items: start;
            padding: 8px;
            margin-top: 5px;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            color: var(--text-primary);
            cursor: pointer;
        }

            .cb-decision-row:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--border-light)); }
            .cb-decision-row.cb-selected,
            .cb-decision-row[aria-selected="true"] { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); }
            .cb-decision-row.cb-attention { border-color: color-mix(in srgb, var(--danger, #f7768e) 70%, var(--border-light)); }
            .cb-decision-row.cb-decision-transition { border-left: 3px solid var(--accent); }
            .cb-decision-row.cb-decision-event { border-left: 3px solid var(--danger, #f7768e); }
            .cb-decision-row.cb-raw-confirmation { opacity: .76; border-style: dashed; }

        .cb-decision-index { color: var(--text-muted); font: 9.5px var(--font-mono, ui-monospace, monospace); font-weight: 700; }
        .cb-decision-copy { min-width: 0; line-height: 1.35; }
        .cb-decision-copy strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .cb-decision-copy span { display: block; color: var(--text-secondary); font-size: 10.5px; }
        .cb-decision-meta { color: var(--text-muted); font-size: 10.5px; white-space: nowrap; }

        .cb-confirmation-group {
            display: grid;
            grid-template-columns: 34px minmax(0, 1fr) auto;
            gap: 7px;
            align-items: start;
            width: 100%;
            margin-top: 5px;
            padding: 8px;
            border: 1px dashed var(--border-light);
            border-radius: var(--radius-md);
            background: color-mix(in srgb, var(--bg-card-alt) 64%, transparent);
            color: var(--text-primary);
            text-align: left;
            cursor: pointer;
        }
        .cb-confirmation-group:hover { border-color: var(--accent); }
        .cb-confirmation-group.cb-selected { background: color-mix(in srgb, var(--accent) 7%, var(--bg-card)); }

        .cb-hd-events {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            margin: 7px 0;
            color: var(--text-secondary);
            font-size: 10.5px;
        }
        .cb-hd-events strong { width: 100%; color: var(--text-primary); }
        .cb-hd-events span { padding: 2px 7px; border: 1px solid color-mix(in srgb, var(--danger, #f7768e) 45%, var(--border-light)); border-radius: 99px; }

        .cb-path-list {
            list-style: none;
            margin: 0;
            padding: 0 12px 14px;
            counter-reset: cb-path;
            min-height: 0;
            overflow-y: auto;
            border-top: 1px solid var(--border-light);
        }

        .cb-path-step {
            position: relative;
            display: grid;
            grid-template-columns: 24px minmax(0, 1fr);
            gap: 8px;
            padding: 7px 8px;
            border-left: 2px solid var(--border-light);
            cursor: pointer;
            counter-increment: cb-path;
        }

            .cb-path-step::before {
                content: counter(cb-path);
                display: grid;
                place-items: center;
                width: 20px;
                height: 20px;
                margin-left: -19px;
                border: 2px solid var(--bg-card);
                border-radius: 50%;
                background: var(--bg-card-alt);
                color: var(--text-muted);
                font: 9px var(--font-mono, ui-monospace, monospace);
            }

            .cb-path-step:hover { background: var(--bg-card-alt); }
            .cb-path-step.cb-selected,
            .cb-path-step[aria-current="step"] { border-left-color: var(--accent); background: color-mix(in srgb, var(--accent) 9%, transparent); }
            .cb-path-step.cb-selected::before,
            .cb-path-step[aria-current="step"]::before { background: var(--accent); color: var(--bg-card); }

        .cb-path-copy { min-width: 0; color: var(--text-primary); line-height: 1.35; }
        .cb-path-copy small { display: block; color: var(--text-muted); font: 10px var(--font-mono, ui-monospace, monospace); }

        .cb-source { background: color-mix(in srgb, var(--bg-card) 88%, #000); }
        #cbSourceHeader { font-family: var(--font-mono, ui-monospace, monospace); }

        #cbSourceBody {
            flex: 1 1 auto;
            min-height: 0;
            overflow: auto;
            padding: 8px 0 18px;
            background: color-mix(in srgb, var(--bg-card) 91%, #000);
            font: 12px/1.55 var(--font-mono, ui-monospace, SFMono-Regular, Consolas, monospace);
            tab-size: 4;
        }

        .cb-code-line,
        .cb-source-line {
            display: grid;
            grid-template-columns: 54px minmax(max-content, 1fr);
            min-height: 20px;
            border-left: 3px solid transparent;
        }

            .cb-code-line:hover,
            .cb-source-line:hover { background: color-mix(in srgb, var(--text-primary) 4%, transparent); }
            .cb-code-line.cb-target,
            .cb-source-line.cb-target,
            .cb-source-line[data-target="true"] {
                border-left-color: var(--warning, #e0af68);
                background: color-mix(in srgb, var(--warning, #e0af68) 13%, transparent);
            }

        .cb-code-no,
        .cb-source-number {
            padding: 1px 11px 1px 6px;
            border-right: 1px solid var(--border-light);
            color: var(--text-muted);
            text-align: right;
            user-select: none;
        }

        .cb-code-text,
        .cb-source-text {
            padding: 1px 14px;
            color: var(--text-primary);
            white-space: pre;
        }

        .cb-reader-empty {
            display: grid;
            place-items: center;
            align-content: center;
            gap: 5px;
            min-height: 130px;
            padding: 22px;
            color: var(--text-muted);
            text-align: center;
            font-size: 11.5px;
            line-height: 1.45;
        }

            .cb-reader-empty strong { color: var(--text-secondary); font-size: 12.5px; }

        @@media (max-width: 1100px) {
            .cb-history {
                grid-template-columns: minmax(240px, .8fr) minmax(360px, 1.2fr);
                grid-template-rows: auto minmax(420px, 1fr) minmax(360px, .85fr);
                height: auto;
            }

            .cb-source { grid-column: 1 / -1; min-height: 360px; }
        }

        @@media (max-width: 720px) {
            .cb-history { grid-template-columns: 1fr; grid-template-rows: auto repeat(3, minmax(320px, auto)); }
            .cb-hist-bar { align-items: stretch; }
            .cb-hist-count { min-width: 0; }
            .cb-hist-hint { display: none; }
            #cbHistRefresh { margin-left: 0; }
            .cb-source { grid-column: auto; }
        }

        /* ── "Traced…" modal ─────────────────────────────────────────────── */
        .cb-modal {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 50;
            background: rgba(0,0,0,0.45);
            align-items: flex-start;
            justify-content: center;
        }
            .cb-modal.cb-open { display: flex; }

        .cb-modal-card {
            margin-top: 8vh;
            width: min(560px, 92vw);
            max-height: 80vh;
            display: flex;
            flex-direction: column;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            background: var(--bg-card);
            box-shadow: 0 12px 40px rgba(0,0,0,0.45);
            overflow: hidden;
        }

        .cb-modal-head {
            display: flex; align-items: center;
            padding: 12px 16px;
            border-bottom: 1px solid var(--border-light);
            font-weight: 700;
            color: var(--text-primary);
        }
        .cb-modal-x {
            margin-left: auto;
            background: none; border: none; cursor: pointer;
            color: var(--text-secondary); font-size: 15px;
        }
            .cb-modal-x:hover { color: var(--text-primary); }

        .cb-modal-sub { padding: 8px 16px; color: var(--text-secondary); font-size: 12px; border-bottom: 1px solid var(--border-light); }
        .cb-modal-body { padding: 6px 0; overflow-y: auto; }

        .cb-who-row {
            display: flex; align-items: center; gap: 10px;
            padding: 8px 16px;
            cursor: pointer;
            border-left: 3px solid var(--danger, #f7768e);
        }
            .cb-who-row:hover { background: var(--bg-card-alt); }
        .cb-who-rec { color: var(--danger, #f7768e); font-size: 10px; }
        .cb-who-name { color: var(--text-primary); font-weight: 600; }
        .cb-who-guid { color: var(--text-muted); font-size: 11px; }
        .cb-who-go { margin-left: auto; color: var(--accent); font-size: 11px; }
        .cb-who-empty { padding: 20px 16px; color: var(--text-secondary); font-size: 12.5px; text-align: center; }
    </style>
}

@if (!Model.Ready)
{
    <main class="cb-source-setup" aria-labelledby="cbSourceSetupTitle">
        <section class="cb-source-setup-card">
            <div class="cb-source-setup-icon" aria-hidden="true">
                <i class="fa-solid fa-code"></i>
            </div>
            <h1 id="cbSourceSetupTitle">Source code is required</h1>
            <p class="cb-source-setup-intro">
                Circuit Board needs two separate codebases to show the literal decision behind every trace step.
                Choose a server folder or upload the matching repository ZIP for each missing item below.
            </p>
            <ul class="cb-source-setup-list" aria-label="Missing source code">
                @if (!Model.CSharp.Ready)
                {
                    <li>
                        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                        <div>
                            <strong>@Model.CSharp.Label</strong>
                            <span>
                                Get the source ZIP from the same MangosSuperUI release you installed. It must contain
                                <code>MangosSuperUI.csproj</code> and <code>BotLogic</code>.
                                @if (circuitAppArchiveUrl != null)
                                {
                                    <text>
                                        This build records base commit <code title="@circuitAppRevision">@circuitAppRevisionShort</code>;
                                        <a href="@circuitAppArchiveUrl" target="_blank" rel="noopener">download that commit's source ZIP</a>.
                                        For a build with uncommitted changes, use its original checkout instead.
                                    </text>
                                }
                            </span>
                        </div>
                    </li>
                }
                @if (!Model.Cpp.Ready)
                {
                    <li>
                        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                        <div>
                            <strong>@Model.Cpp.Label</strong>
                            <span>
                                Use the SuperUI-Core checkout that built your running <code>mangosd</code>, or upload that
                                repository revision from
                                <a href="https://github.com/Yafrovon/SuperUI-Core" target="_blank" rel="noopener">SuperUI-Core</a>.
                                It must contain <code>src/game/SuperUiContent/SuiBots</code>. The Dashboard shows the running Core Revision.
                            </span>
                        </div>
                    </li>
                }
            </ul>
            <a class="cb-source-setup-action" href="/Settings#circuit-source">
                <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
                Open source setup instructions
            </a>
            <p class="cb-source-setup-note">
                The application/release ZIP is not source code. Settings links to both repositories and accepts one source ZIP per row.
                Matching revisions matter because trace probes record file names and line numbers.
            </p>
        </section>
    </main>
}
else
{
<div class="cb-toolbar">
    <select id="cbBot"><option value="0">— pick a bot —</option></select>
    <button id="cbArm" title="Write this bot's trace to the daily file continuously">Arm</button>
    <button id="cbDisarm" title="Stop writing (ring keeps recording in shadow)">Disarm</button>
    <button id="cbDump" title="Flush this bot's whole ring to the daily file now">Dump</button>
    <button id="cbShadow" title="Global: shadow rings record every bot in memory">Shadow: ?</button>
    <button id="cbWho" title="Who is armed / being traced right now">Traced…</button>
    <span style="width:1px;height:20px;background:var(--border-light)"></span>
    <button id="cbTabHistory" class="cb-active" title="Routine activity collapsed into episodes, with each decision and its source">Activity</button>
    <button id="cbTabBoard" title="The schematic: lanes light up as the bot decides">Circuit map</button>
    <button id="cbTabFeed" title="Raw decoded segment feed">Raw feed</button>
    <button id="cbAllLanes" title="Show every registered lane, not just active ones">All lanes</button>
    <button id="cbFit" title="Fit the board to the window width">Fit</button>
    <button id="cbPause">Pause</button>
    <button id="cbPacket" title="Download the whole decoded window as a markdown packet — paste it to an LLM">Packet ⭳</button>
    <span class="cb-status" id="cbStatus">—</span>
</div>

<div class="cb-stage">
    <div class="cb-wedge" id="cbWedge"></div>
    <div class="cb-board" id="cbBoardWrap" style="display:none">
        <div id="cbBoard" style="width:100%;height:100%">
            <svg id="cbSvg" xmlns="http://www.w3.org/2000/svg">
                <g id="cbBands"></g>
                <g id="cbEdges"></g>
                <g id="cbHeads"></g>
                <g id="cbNodes"></g>
            </svg>
        </div>
    </div>
    <div class="cb-feed" id="cbFeed"></div>

    <!-- Activity reader. Routine repetition, sustained conditions, and point-event bursts
         are human-scale rows on the left. The middle prioritizes meaningful transitions
         while keeping confirming frames available; the literal source stays at right. -->
    <div class="cb-history" id="cbHistory">
        <div class="cb-hist-bar" aria-label="Meaningful change navigation">
            <button id="cbHistPrev" title="Previous meaningful change (←)">◀ Prev change</button>
            <button id="cbHistNext" title="Next meaningful change (→)">Next change ▶</button>
            <span class="cb-hist-count" id="cbHistCount">—</span>
            <span class="cb-hist-new" id="cbHistNew" aria-live="polite">new activity</span>
            <button id="cbHistRefresh" title="Return to the newest meaningful change and resume following">Jump to now</button>
            <span class="cb-hist-live" id="cbHistLive" data-state="live">live · stepping back freezes this view</span>
            <span class="cb-hist-hint">use ← → to teach through meaningful changes</span>
        </div>

        <section class="cb-reader-pane cb-hist-list-wrap" aria-labelledby="cbEpisodesTitle">
            <div class="cb-pane-head">
                <div class="cb-pane-title" id="cbEpisodesTitle">Activity &amp; incidents</div>
                <div class="cb-pane-kicker">One row per routine, sustained condition, or event burst—not one row per observation.</div>
            </div>
            <div class="cb-hist-list" id="cbHistList">
                <div class="cb-reader-empty">
                    <strong>Pick a bot to read its activity.</strong>
                    Find → fight → loot → heal loops stay routine; a sustained problem stays one condition until it clears.
                </div>
            </div>
        </section>

        <section class="cb-reader-pane cb-hist-main" aria-labelledby="cbDecisionTitle">
            <div class="cb-pane-head">
                <div class="cb-pane-title" id="cbDecisionTitle">Decision flow</div>
                <div class="cb-pane-kicker">Meaningful transitions first. Unchanged confirmations remain folded unless you ask for raw evidence.</div>
            </div>
            <div class="cb-hist-detail" id="cbHistDetail">
                <div class="cb-reader-empty">
                    <strong>Select an activity episode.</strong>
                    Its transitions, events, and literal probe flow will appear here.
                </div>
            </div>
            <div class="cb-decision-list" id="cbDecisionList" aria-label="Decisions in selected episode"></div>
            <ol class="cb-path-list" id="cbPathList" aria-label="Ordered probe path"></ol>
        </section>

        <section class="cb-reader-pane cb-source" id="cbSource" aria-labelledby="cbSourceHeader" data-source-version="@Model.SourceVersion">
            <div class="cb-pane-head" id="cbSourceHeader">
                <div class="cb-pane-title">Source at this step</div>
                <div class="cb-pane-kicker">A few lines before the probe show the branch that led here; the fired line is highlighted.</div>
            </div>
            <div id="cbSourceBody" aria-live="polite">
                <div class="cb-reader-empty">
                    <strong>Choose a decision step to read its code.</strong>
                    Source is read only from the registered C# or C++ source roots.
                </div>
            </div>
        </section>
    </div>

    <div class="cb-detail" id="cbDetail"></div>
</div>

<!-- "Traced…" modal: who is armed / recording right now. -->
<div class="cb-modal" id="cbWhoModal">
    <div class="cb-modal-card">
        <div class="cb-modal-head">
            <span>Circuit — who is traced</span>
            <button id="cbWhoClose" class="cb-modal-x" title="Close">✕</button>
        </div>
        <div class="cb-modal-sub" id="cbWhoSub"></div>
        <div class="cb-modal-body" id="cbWhoBody"></div>
    </div>
</div>

<div class="cb-footer">
    <span class="cb-now-label">this tick</span>
    <span id="cbSteady"></span>
    <span id="cbSides" title="Whether this window actually contains BOTH programs"></span>
    <span id="cbNow">pick a bot — shadow mode must be on for anything to record</span>
    <span id="cbPos"></span>
</div>
}

@section Scripts {
    @if (Model.Ready)
    {
        <script src="~/js/circuittrace.js" asp-append-version="true"></script>
    }
}
