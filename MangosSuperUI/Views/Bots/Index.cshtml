@{
    ViewData["Title"] = "Bot Cockpit";
}

@section Styles {
    <style>
        /* ====== Bot Monitor / Cockpit ====== */

        /* --- Header Stats --- */
        .bt-stat {
            font-size: 13px;
            font-weight: 500;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 5px;
        }

            .bt-stat i {
                font-size: 12px;
                color: var(--text-muted);
            }

        .bt-stat-val {
            font-weight: 700;
        }

        /* --- Engine Toggle --- */
        .bt-engine-toggle {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 12px;
            border-radius: var(--radius-md);
            border: 1px solid var(--border-light);
            cursor: pointer;
            transition: all var(--transition-fast);
            user-select: none;
        }

            .bt-engine-toggle.active {
                border-color: var(--status-online);
                background: rgba(34,197,94,0.08);
            }

            .bt-engine-toggle .bt-engine-dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: var(--status-offline);
                transition: background var(--transition-fast);
            }

            .bt-engine-toggle.active .bt-engine-dot {
                background: var(--status-online);
            }

            .bt-engine-toggle .bt-engine-label {
                font-size: 12px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                color: var(--text-muted);
            }

            .bt-engine-toggle.active .bt-engine-label {
                color: var(--status-online);
            }

        /* --- Cockpit strip (fleet census + filter control) --- */
        .bt-cockpit {
            background: var(--bg-card);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            margin-bottom: 12px;
        }

        .bt-cockpit-head {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 7px 12px;
            border-bottom: 1px solid var(--border-light);
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-muted);
        }

            .bt-cockpit-head i.head-i {
                color: var(--accent);
            }

        .bt-cockpit-spacer {
            flex: 1;
        }

        #cockpitFilterPill {
            display: none;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 600;
            text-transform: none;
            letter-spacing: 0;
            color: var(--accent);
            background: var(--accent-subtle);
            border: 1px solid var(--accent);
            border-radius: 20px;
            padding: 2px 10px;
            cursor: pointer;
        }

        #cockpitToggle {
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 12px;
            padding: 2px 4px;
        }

            #cockpitToggle:hover {
                color: var(--text-primary);
            }

        .bt-page.cockpit-off .bt-cockpit-body {
            display: none;
        }

        .bt-cockpit-body {
            padding: 10px 12px;
        }

        .bt-tiles {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .bt-tile {
            flex: 1 1 92px;
            min-width: 92px;
            background: var(--bg-card-alt);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-sm);
            padding: 7px 6px;
            text-align: center;
            transition: border-color var(--transition-fast), background var(--transition-fast);
        }

            .bt-tile.clickable {
                cursor: pointer;
            }

                .bt-tile.clickable:hover {
                    border-color: var(--accent);
                }

            .bt-tile.on {
                border-color: var(--accent);
                background: var(--accent-light);
            }

        .bt-tile-val {
            font-size: 17px;
            font-weight: 800;
            line-height: 1.1;
        }

        .bt-tile-lbl {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-top: 3px;
        }

        .bt-chiprow {
            display: flex;
            align-items: center;
            gap: 5px;
            flex-wrap: wrap;
            margin-top: 8px;
        }

        .bt-chiprow-h {
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-muted);
            min-width: 74px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

            .bt-chiprow-h i {
                color: var(--accent);
                font-size: 10px;
            }

        .bt-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            padding: 2px 8px;
            border-radius: 20px;
            border: 1px solid var(--border-light);
            background: var(--bg-card-alt);
            color: var(--text-secondary);
            cursor: pointer;
            white-space: nowrap;
            transition: all var(--transition-fast);
        }

            .bt-chip:hover {
                border-color: var(--accent);
                color: var(--text-primary);
            }

            .bt-chip b {
                font-variant-numeric: tabular-nums;
                color: var(--text-primary);
            }

            .bt-chip.on {
                border-color: var(--accent);
                background: var(--accent-light);
                color: var(--accent);
            }

                .bt-chip.on b {
                    color: var(--accent);
                }

        /* --- Layout --- */
        .bt-layout {
            display: grid;
            grid-template-columns: 340px 1fr;
            gap: 16px;
            height: calc(100vh - 360px);
            min-height: 420px;
        }

        .bt-page.cockpit-off .bt-layout {
            height: calc(100vh - 215px);
        }

        /* --- Roster toolbar --- */
        .bt-roster-bar {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            margin-bottom: 8px;
            flex-shrink: 0;
        }

            .bt-roster-bar .form-input {
                font-size: 11px;
                padding: 2px 6px;
                height: 26px;
            }

        .bt-roster-count {
            margin-left: auto;
            font-size: 11px;
            font-weight: 700;
            color: var(--text-muted);
            font-variant-numeric: tabular-nums;
        }

        /* --- Bot Roster (Left) --- */
        .bt-roster {
            overflow-y: auto;
            padding-right: 4px;
        }

        .bt-roster-ghead {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-muted);
            padding: 8px 2px 4px;
            display: flex;
            align-items: center;
            gap: 8px;
            border-bottom: 1px solid var(--border-light);
            margin-bottom: 6px;
        }

        .bt-roster-gcount {
            margin-left: auto;
            background: var(--bg-card-alt);
            border-radius: 10px;
            padding: 0 7px;
            font-variant-numeric: tabular-nums;
        }

        .bt-roster-card {
            background: var(--bg-card);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            padding: 8px 10px;
            margin-bottom: 6px;
            cursor: pointer;
            transition: border-color var(--transition-fast), background var(--transition-fast);
            display: flex;
            align-items: center;
            gap: 9px;
        }

            .bt-roster-card:hover {
                border-color: var(--accent);
            }

            .bt-roster-card.selected {
                border-color: var(--accent);
                background: var(--accent-light);
            }

            .bt-roster-card.disconnected {
                opacity: 0.45;
            }

        .bt-roster-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            flex-shrink: 0;
        }

            .bt-roster-dot.alive {
                background: #9ece6a;
            }

            .bt-roster-dot.dead {
                background: #f7768e;
            }

            .bt-roster-dot.offline {
                background: var(--text-muted);
            }

        .bt-roster-info {
            flex: 1;
            min-width: 0;
        }

        .bt-roster-name {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-primary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .bt-roster-lvl {
            font-size: 10px;
            font-weight: 700;
            color: var(--text-muted);
            font-variant-numeric: tabular-nums;
        }

        .bt-roster-meta {
            font-size: 10.5px;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 2px;
            white-space: nowrap;
            overflow: hidden;
        }

        .bt-roster-zone {
            max-width: 128px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .bt-roster-zone i {
                font-size: 9px;
                opacity: 0.7;
            }

        .bt-roster-race {
            opacity: 0.7;
        }

        .bt-roster-right {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }

        .bt-roster-ctl {
            background: var(--bg-card-alt);
            border: 1px solid var(--border-light);
            color: var(--text-muted);
            border-radius: 4px;
            width: 24px;
            height: 24px;
            font-size: 11px;
            cursor: pointer;
            line-height: 1;
            transition: all var(--transition-fast);
        }

            .bt-roster-ctl:hover {
                color: var(--accent);
                border-color: var(--accent);
            }

        .bt-roster-activity {
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            padding: 2px 6px;
            border-radius: 3px;
            flex-shrink: 0;
        }

        .bt-act-idle, .bt-act-offline {
            background: rgba(141,150,160,0.12);
            color: var(--text-muted);
        }

        .bt-act-questing {
            background: rgba(122,162,247,0.12);
            color: #7aa2f7;
        }

        .bt-act-grinding {
            background: rgba(247,118,142,0.12);
            color: #f7768e;
        }

        .bt-act-exploring {
            background: rgba(42,195,222,0.12);
            color: #2ac3de;
        }

        .bt-act-socializing {
            background: rgba(187,154,247,0.12);
            color: #bb9af7;
        }

        .bt-act-vendoring, .bt-act-auctionhouse {
            background: rgba(224,175,104,0.12);
            color: #e0af68;
        }

        .bt-act-eating {
            background: rgba(158,206,106,0.12);
            color: #9ece6a;
        }

        .bt-act-training, .bt-act-travelingtotrainer {
            background: rgba(255,158,100,0.12);
            color: #ff9e64;
        }

        .bt-act-following {
            background: rgba(115,218,202,0.12);
            color: #73daca;
        }

        .bt-act-maintenance {
            background: rgba(255,158,100,0.12);
            color: #ff9e64;
        }

        /* --- Detail Panel (Right) --- */
        .bt-detail {
            overflow-y: auto;
            padding-right: 4px;
        }

        .bt-detail-empty {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            color: var(--text-muted);
            text-align: center;
        }

            .bt-detail-empty i {
                font-size: 48px;
                margin-bottom: 12px;
            }

        .bt-section {
            background: var(--bg-card);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            margin-bottom: 12px;
        }

        .bt-section-header {
            padding: 10px 14px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .bt-section-body {
            padding: 14px;
        }

        /* --- Personality Trait Bars --- */
        .bt-trait {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
        }

            .bt-trait:last-child {
                margin-bottom: 0;
            }

        .bt-trait-icon {
            width: 20px;
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            flex-shrink: 0;
        }

        .bt-trait-label {
            width: 90px;
            font-size: 12px;
            font-weight: 500;
            color: var(--text-secondary);
            flex-shrink: 0;
        }

        .bt-trait-bar-track {
            flex: 1;
            height: 6px;
            border-radius: 3px;
            background: var(--bg-card-alt);
            position: relative;
            overflow: hidden;
        }

        .bt-trait-bar-fill {
            height: 100%;
            border-radius: 3px;
            transition: width 0.4s ease;
        }

        .bt-trait-val {
            width: 34px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-primary);
            text-align: right;
            flex-shrink: 0;
        }

        /* --- Quirk Badges --- */
        .bt-quirk {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 500;
            background: var(--accent-subtle);
            color: var(--accent);
            margin: 2px;
        }

        /* --- Activity Timeline --- */
        .bt-timeline {
            font-family: 'Consolas', 'Courier New', monospace;
            font-size: 11.5px;
            line-height: 1.7;
            background: #0f1319;
            color: #c8d0da;
            padding: 10px 12px;
            border-radius: var(--radius-md);
            max-height: 200px;
            overflow-y: auto;
        }

        .bt-tl-switch {
            color: #7aa2f7;
        }

        .bt-tl-stay {
            color: #5f6b7a;
        }

        .bt-tl-event {
            color: #e0af68;
        }

        .bt-tl-error {
            color: #f7768e;
        }

        /* --- Weight Breakdown --- */
        .bt-weights {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4px 12px;
        }

        .bt-weight-row {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
        }

        .bt-weight-label {
            flex: 1;
            color: var(--text-secondary);
        }

        .bt-weight-bar-track {
            width: 60px;
            height: 4px;
            border-radius: 2px;
            background: var(--bg-card-alt);
            overflow: hidden;
            flex-shrink: 0;
        }

        .bt-weight-bar-fill {
            height: 100%;
            border-radius: 2px;
            background: var(--accent);
            transition: width 0.3s ease;
        }

        .bt-weight-val {
            width: 30px;
            font-size: 10px;
            font-weight: 600;
            color: var(--text-muted);
            text-align: right;
            flex-shrink: 0;
        }

        /* --- Economy Summary --- */
        .bt-econ-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 8px;
        }

        .bt-econ-item {
            text-align: center;
            padding: 8px;
            background: var(--bg-card-alt);
            border-radius: var(--radius-sm);
        }

        .bt-econ-val {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .bt-econ-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: var(--text-muted);
            margin-top: 2px;
        }

        /* --- Control suite (inside the bot modal) --- */
        .bc-target {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
            background: var(--bg-card-alt);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            padding: 8px 12px;
            margin-bottom: 10px;
        }

        .bc-target-l {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-muted);
        }

        .bc-radio {
            font-size: 12px;
            color: var(--text-secondary);
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin: 0;
            cursor: pointer;
        }

        .bc-target-n {
            margin-left: auto;
            font-size: 11px;
            font-weight: 700;
            color: var(--accent);
        }

        .bc-vitals {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 12px;
            padding: 0 2px;
        }

        .bc-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
            gap: 10px;
        }

        .bc-card {
            background: var(--bg-card-alt);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            overflow: hidden;
        }

        .bc-card-h {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 12px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-secondary);
            border-bottom: 1px solid var(--border-light);
        }

            .bc-card-h i {
                color: var(--accent);
            }

        .bc-note {
            margin-left: auto;
            font-size: 10px;
            font-weight: 400;
            text-transform: none;
            letter-spacing: 0;
            color: var(--text-muted);
        }

        .bc-card-b {
            padding: 10px 12px;
        }

        .bc-row {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            margin-bottom: 7px;
        }

            .bc-row:last-child {
                margin-bottom: 0;
            }

        .bc-in {
            font-size: 12px;
            padding: 3px 7px;
            height: 28px;
        }

        .bc-lbl {
            font-size: 11px;
            color: var(--text-muted);
        }

        .bc-btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 12px;
            font-weight: 600;
            padding: 5px 11px;
            border-radius: 6px;
            border: 1px solid var(--border-light);
            background: var(--bg-card);
            color: var(--text-secondary);
            cursor: pointer;
            transition: all var(--transition-fast);
        }

            .bc-btn:hover {
                border-color: var(--accent);
                color: var(--accent);
            }

            .bc-btn.primary {
                border-color: var(--accent);
                background: var(--accent-light);
                color: var(--accent);
            }

            .bc-btn.danger {
                border-color: #f7768e66;
                color: #f7768e;
            }

                .bc-btn.danger:hover {
                    border-color: #f7768e;
                    background: rgba(247,118,142,0.10);
                }

            /* A toggle that is currently ON (circuit armed, shadow recording). */
            .bc-btn.bc-on {
                border-color: var(--accent);
                background: var(--accent-light);
                color: var(--accent);
            }

        /* When the selected bot is circuit-armed, the whole card reads as "recording"
           so it's obvious at a glance which bot is being written to disk. */
        .bc-card.bc-armed {
            border-color: rgba(247,118,142,0.55);
            box-shadow: 0 0 0 1px rgba(247,118,142,0.30), 0 0 14px rgba(247,118,142,0.20);
        }

            .bc-card.bc-armed .bc-card-h,
            .bc-card.bc-armed .bc-card-h i {
                color: #f7768e;
            }

        #bcCircuitState.bc-rec {
            color: #f7768e;
            font-weight: 600;
        }

        .bc-rec-dot { animation: bcRecPulse 1.6s ease-in-out infinite; }

        @@keyframes bcRecPulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }

        /* --- Inventory Panel --- */
        .bt-inv-section-title {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

            .bt-inv-section-title i {
                margin-right: 4px;
                font-size: 10px;
            }

        .bt-inv-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
        }

        .bt-inv-item {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 8px 3px 4px;
            background: var(--bg-card-alt);
            border: 1px solid var(--border-light);
            border-radius: 3px;
            font-size: 11px;
            cursor: default;
            transition: border-color var(--transition-fast);
        }

            .bt-inv-item:hover {
                border-color: var(--accent);
            }

        /* icon + stack-count badge (the JS emits these; they had no CSS before, so the
                   count floated as loose text next to the icon and pushed the name out of view) */
        .bt-inv-icon-wrap {
            position: relative;
            width: 20px;
            height: 20px;
            flex-shrink: 0;
            line-height: 0;
        }

        .bt-inv-icon {
            width: 20px;
            height: 20px;
            border-radius: 2px;
            flex-shrink: 0;
            image-rendering: pixelated;
        }

        .bt-inv-count {
            position: absolute;
            right: -3px;
            bottom: -4px;
            font-size: 9px;
            font-weight: 700;
            line-height: 1;
            padding: 1px 3px;
            border-radius: 3px;
            background: rgba(0,0,0,0.72);
            color: #fff;
            font-variant-numeric: tabular-nums;
        }

        .bt-inv-name {
            font-weight: 500;
            white-space: nowrap;
            max-width: 190px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .bt-inv-slot {
            font-size: 9px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.03em;
            flex-shrink: 0;
        }

        .bt-inv-stat {
            font-size: 9px;
            color: var(--text-muted);
            flex-shrink: 0;
        }

        /* --- Authoritative Talents tab --- */
        #detailTabBody {
            --bt-info: var(--accent);
            --bt-success: var(--status-online);
            --bt-warning: var(--status-warning);
            --bt-danger: var(--status-error);
            --bt-offline: var(--status-offline);
            --bt-info-ink: color-mix(in srgb, var(--bt-info) 58%, var(--text-primary));
            --bt-success-ink: color-mix(in srgb, var(--bt-success) 58%, var(--text-primary));
            --bt-warning-ink: color-mix(in srgb, var(--bt-warning) 58%, var(--text-primary));
            --bt-danger-ink: color-mix(in srgb, var(--bt-danger) 58%, var(--text-primary));
        }

        .bt-talent-loading {
            padding: 34px 12px;
            text-align: center;
            color: var(--text-muted);
            font-size: 12px;
        }

            .bt-talent-loading i {
                color: var(--accent);
                margin-right: 7px;
            }

        .bt-talent-error,
        .bt-talent-compat,
        .bt-talent-warning,
        .bt-talent-next {
            display: flex;
            align-items: center;
            gap: 10px;
            border: 1px solid var(--border-light);
            background: var(--bg-card-alt);
            border-radius: 6px;
            padding: 10px 12px;
            margin-bottom: 10px;
            font-size: 11px;
        }

            .bt-talent-error > i,
            .bt-talent-compat > i,
            .bt-talent-next > i {
                font-size: 18px;
                flex: 0 0 22px;
                text-align: center;
            }

            .bt-talent-error div,
            .bt-talent-compat div,
            .bt-talent-next div {
                display: flex;
                min-width: 0;
                flex-direction: column;
                gap: 2px;
            }

            .bt-talent-error b,
            .bt-talent-compat b,
            .bt-talent-next b {
                color: var(--text-primary);
                font-size: 12px;
            }

            .bt-talent-error span,
            .bt-talent-compat span,
            .bt-talent-next span,
            .bt-talent-next small,
            .bt-talent-error small {
                color: var(--text-muted);
            }

        .bt-talent-error,
        .bt-talent-compat.bad {
            border-color: color-mix(in srgb, var(--bt-danger) 44%, var(--border-light));
            background: color-mix(in srgb, var(--bt-danger) 7%, var(--bg-card-alt));
        }

            .bt-talent-error > i,
            .bt-talent-compat.bad > i {
                color: var(--bt-danger-ink);
            }

        .bt-talent-compat.ok {
            border-color: color-mix(in srgb, var(--bt-success) 40%, var(--border-light));
            background: color-mix(in srgb, var(--bt-success) 6%, var(--bg-card-alt));
        }

            .bt-talent-compat.ok > i {
                color: var(--bt-success-ink);
            }

        .bt-talent-compat.warn,
        .bt-talent-warning {
            border-color: color-mix(in srgb, var(--bt-warning) 40%, var(--border-light));
            background: color-mix(in srgb, var(--bt-warning) 6%, var(--bg-card-alt));
        }

            .bt-talent-compat.warn > i,
            .bt-talent-warning i {
                color: var(--bt-warning-ink);
            }

        .bt-talent-warning {
            padding: 7px 10px;
            color: var(--text-secondary);
        }

        .bt-talent-summary {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 8px;
            margin-bottom: 10px;
        }

        .bt-talent-summary-card {
            display: flex;
            align-items: center;
            gap: 9px;
            min-width: 0;
            padding: 9px 10px;
            border: 1px solid var(--border-light);
            border-radius: 6px;
            background: var(--bg-card-alt);
        }

            .bt-talent-summary-card > i {
                color: var(--accent);
                font-size: 15px;
            }

            .bt-talent-summary-card div {
                min-width: 0;
                display: flex;
                flex-direction: column;
            }

            .bt-talent-summary-card span,
            .bt-talent-summary-card small {
                overflow: hidden;
                color: var(--text-muted);
                font-size: 10px;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .bt-talent-summary-card b {
                overflow: hidden;
                color: var(--text-primary);
                font-size: 12px;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

        /* --- Effective rotation + guarded build editor --- */
        .bt-rotation-card {
            --rotation-color: var(--accent);
            --rotation-ink: color-mix(in srgb, var(--rotation-color) 58%, var(--text-primary));
            display: grid;
            grid-template-columns: 44px minmax(0, 1fr) auto;
            align-items: center;
            gap: 12px;
            margin-bottom: 10px;
            padding: 12px 14px;
            border: 1px solid color-mix(in srgb, var(--rotation-color) 42%, var(--border-light));
            border-radius: 8px;
            background: linear-gradient(110deg,
                color-mix(in srgb, var(--rotation-color) 10%, var(--bg-card)),
                color-mix(in srgb, var(--text-primary) 3%, var(--bg-card)));
            box-shadow: inset 3px 0 var(--rotation-color);
        }

        .bt-rotation-card.source-custom {
            --rotation-color: var(--accent-hover);
        }

        .bt-rotation-card.source-legacy {
            --rotation-color: var(--status-warning);
        }

        .bt-rotation-card.source-offline {
            --rotation-color: var(--status-offline);
        }

        .bt-rotation-icon {
            display: grid;
            width: 42px;
            height: 42px;
            place-items: center;
            border: 1px solid color-mix(in srgb, var(--rotation-color) 48%, var(--border-light));
            border-radius: 50%;
            background: color-mix(in srgb, var(--rotation-color) 12%, var(--bg-card));
            color: var(--rotation-ink);
            font-size: 17px;
        }

        .bt-rotation-copy {
            display: flex;
            min-width: 0;
            flex-direction: column;
            gap: 1px;
        }

            .bt-rotation-copy > span {
                color: var(--rotation-ink);
                font-size: 10px;
                font-weight: 700;
                letter-spacing: .08em;
                text-transform: uppercase;
            }

            .bt-rotation-copy > b {
                overflow: hidden;
                color: var(--text-primary);
                font-size: 14px;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .bt-rotation-copy > p {
                margin: 2px 0 0;
                color: var(--text-secondary);
                font-size: 10px;
                line-height: 1.45;
            }

            .bt-rotation-copy > small {
                color: var(--text-secondary);
                font-size: 10px;
            }

        .bt-rotation-badge {
            padding: 4px 8px;
            border: 1px solid color-mix(in srgb, var(--rotation-color) 42%, var(--border-light));
            border-radius: 999px;
            background: color-mix(in srgb, var(--rotation-color) 9%, var(--bg-card));
            color: var(--rotation-ink);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .05em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .bt-build-workshop {
            overflow: hidden;
            margin-bottom: 10px;
            border: 1px solid color-mix(in srgb, var(--accent) 38%, var(--border-light));
            border-radius: 8px;
            background: color-mix(in srgb, var(--accent) 4%, var(--bg-card));
        }

            .bt-build-workshop.applying {
                border-color: color-mix(in srgb, var(--accent) 64%, var(--border-light));
            }

            .bt-build-workshop > header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding: 10px 12px;
                border-bottom: 1px solid var(--border-light);
                background: linear-gradient(90deg,
                    color-mix(in srgb, var(--accent) 11%, var(--bg-card)),
                    color-mix(in srgb, var(--accent) 3%, var(--bg-card)));
            }

                .bt-build-workshop > header > div {
                    display: flex;
                    min-width: 0;
                    align-items: center;
                    gap: 9px;
                }

                .bt-build-workshop > header i {
                    color: var(--accent);
                    font-size: 15px;
                }

                .bt-build-workshop > header span {
                    display: flex;
                    min-width: 0;
                    flex-direction: column;
                }

                .bt-build-workshop > header b {
                    color: var(--text-primary);
                    font-size: 12px;
                }

                .bt-build-workshop > header small {
                    color: var(--text-secondary);
                    font-size: 10px;
                    font-weight: 400;
                }

        .bt-build-status {
            padding: 3px 7px;
            border: 1px solid color-mix(in srgb, var(--bt-success) 36%, var(--border-light));
            border-radius: 999px;
            background: color-mix(in srgb, var(--bt-success) 8%, var(--bg-card));
            color: var(--bt-success-ink);
            font-size: 10px;
            font-style: normal;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

            .bt-build-status.blocked {
                border-color: color-mix(in srgb, var(--bt-warning) 38%, var(--border-light));
                background: color-mix(in srgb, var(--bt-warning) 8%, var(--bg-card));
                color: var(--bt-warning-ink);
            }

            .bt-build-status.applying,
            .bt-build-status.saving {
                border-color: color-mix(in srgb, var(--accent) 42%, var(--border-light));
                background: color-mix(in srgb, var(--accent) 9%, var(--bg-card));
                color: var(--bt-info-ink);
            }

            .bt-build-status.queued {
                border-color: color-mix(in srgb, var(--bt-warning) 42%, var(--border-light));
                background: color-mix(in srgb, var(--bt-warning) 9%, var(--bg-card));
                color: var(--bt-warning-ink);
            }

        .bt-build-blocker {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-bottom: 1px solid color-mix(in srgb, var(--bt-warning) 22%, var(--border-light));
            background: color-mix(in srgb, var(--bt-warning) 7%, var(--bg-card));
            color: var(--bt-warning-ink);
            font-size: 11px;
        }

        .bt-build-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 9px;
            padding: 12px;
        }

            .bt-build-grid > label {
                display: flex;
                min-width: 0;
                flex-direction: column;
                gap: 4px;
                margin: 0;
            }

                .bt-build-grid > label > span {
                    color: var(--text-secondary);
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: .04em;
                    text-transform: uppercase;
                }

                .bt-build-grid > label > small {
                    min-height: 24px;
                    color: var(--text-secondary);
                    font-size: 10px;
                    line-height: 13px;
                }

        .bt-build-select {
            width: 100%;
            min-width: 0;
            height: 30px;
            padding: 4px 7px;
            font-size: 10px;
        }

        .bt-build-preview {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 28px minmax(0, 1fr);
            align-items: center;
            gap: 8px;
            margin: 0 12px 10px;
            padding: 9px 10px;
            border: 1px solid var(--border-light);
            border-radius: 6px;
            background: var(--bg-card-alt);
        }

            .bt-build-preview > div {
                display: flex;
                min-width: 0;
                flex-direction: column;
                gap: 2px;
            }

                .bt-build-preview > div > span {
                    color: var(--text-secondary);
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: .07em;
                    text-transform: uppercase;
                }

                .bt-build-preview > div > b {
                    overflow: hidden;
                    color: var(--text-primary);
                    font-size: 10px;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                }

            .bt-build-preview > i {
                color: var(--accent);
                text-align: center;
            }

        .bt-build-danger,
        .bt-build-notice {
            display: flex;
            align-items: center;
            gap: 9px;
            margin: 0 12px 8px;
            padding: 9px 10px;
            border: 1px solid var(--border-light);
            border-radius: 6px;
            background: var(--bg-card-alt);
        }

        .bt-build-danger,
        .bt-build-notice[data-kind="error"] {
            border-color: color-mix(in srgb, var(--bt-danger) 36%, var(--border-light));
            background: color-mix(in srgb, var(--bt-danger) 7%, var(--bg-card));
        }

        .bt-build-notice[data-kind="success"] {
            border-color: color-mix(in srgb, var(--bt-success) 36%, var(--border-light));
            background: color-mix(in srgb, var(--bt-success) 7%, var(--bg-card));
        }

        .bt-build-notice[data-kind="warning"],
        .bt-build-notice[data-kind="uncertain"] {
            border-color: color-mix(in srgb, var(--bt-warning) 36%, var(--border-light));
            background: color-mix(in srgb, var(--bt-warning) 7%, var(--bg-card));
        }

            .bt-build-danger > i,
            .bt-build-notice > i {
                flex: 0 0 18px;
                color: var(--bt-danger-ink);
                font-size: 15px;
                text-align: center;
            }

            .bt-build-notice[data-kind="success"] > i {
                color: var(--bt-success-ink);
            }

            .bt-build-notice[data-kind="warning"] > i,
            .bt-build-notice[data-kind="uncertain"] > i {
                color: var(--bt-warning-ink);
            }

            .bt-build-danger > div,
            .bt-build-notice > div {
                display: flex;
                min-width: 0;
                flex-direction: column;
                gap: 1px;
            }

            .bt-build-danger b,
            .bt-build-notice b {
                color: var(--text-primary);
                font-size: 10px;
            }

            .bt-build-danger span,
            .bt-build-notice span,
            .bt-build-notice small {
                color: var(--text-secondary);
                font-size: 10px;
                line-height: 14px;
            }

        .bt-build-notice[hidden] {
            display: none;
        }

        .bt-build-confirm {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin: 0 12px 10px;
            color: var(--text-secondary);
            font-size: 10px;
            line-height: 14px;
            cursor: pointer;
        }

            .bt-build-confirm input {
                margin-top: 1px;
                accent-color: var(--bt-danger);
            }

            .bt-build-confirm:has(input:disabled) {
                opacity: .5;
                cursor: not-allowed;
            }

        .bt-build-workshop > footer {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 8px;
            padding: 9px 12px;
            border-top: 1px solid var(--border-light);
            background: var(--bg-card-alt);
        }

        .bt-build-apply,
        .bt-build-secondary {
            display: inline-flex;
            height: 28px;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 5px;
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
        }

        .bt-build-apply {
            border: 1px solid color-mix(in srgb, var(--bt-danger) 62%, var(--border-light));
            background: color-mix(in srgb, var(--bt-danger) 16%, var(--bg-card));
            color: var(--bt-danger-ink);
        }

            .bt-build-apply:hover:not(:disabled) {
                background: color-mix(in srgb, var(--bt-danger) 25%, var(--bg-card));
            }

        .bt-build-secondary {
            border: 1px solid var(--border-light);
            background: var(--bg-card-alt);
            color: var(--text-secondary);
            cursor: pointer;
        }

            .bt-build-secondary:hover:not(:disabled) {
                border-color: var(--accent);
                color: var(--accent);
            }

            .bt-build-secondary:disabled,
            .bt-build-apply:disabled {
                opacity: .58;
                cursor: not-allowed;
            }

        .bt-build-queue {
            display: grid;
            grid-template-columns: 24px minmax(0, 1fr) auto;
            align-items: center;
            gap: 9px;
            margin: 0 12px 10px;
            padding: 10px;
            border: 1px solid color-mix(in srgb, var(--bt-warning) 38%, var(--border-light));
            border-radius: 6px;
            background: color-mix(in srgb, var(--bt-warning) 7%, var(--bg-card));
        }

            .bt-build-queue > i {
                color: var(--bt-warning-ink);
                font-size: 16px;
                text-align: center;
            }

            .bt-build-queue-copy {
                display: flex;
                min-width: 0;
                flex-direction: column;
                gap: 2px;
            }

                .bt-build-queue-copy b {
                    color: var(--text-primary);
                    font-size: 11px;
                }

                .bt-build-queue-copy span,
                .bt-build-queue-copy small {
                    overflow: hidden;
                    color: var(--text-secondary);
                    font-size: 10px;
                    line-height: 14px;
                    text-overflow: ellipsis;
                }

                .bt-build-queue-copy small {
                    color: var(--text-secondary);
                }

            .bt-build-queue-actions {
                display: flex;
                align-items: center;
                gap: 6px;
            }

        .bt-build-cancel-queued {
            border-color: color-mix(in srgb, var(--bt-danger) 36%, var(--border-light));
            color: var(--bt-danger-ink);
        }

        .bt-talent-next > i {
            color: var(--bt-info-ink);
        }

        .bt-talent-next.due {
            border-color: color-mix(in srgb, var(--bt-warning) 55%, var(--border-light));
            box-shadow: inset 3px 0 var(--bt-warning);
        }

            .bt-talent-next.due > i {
                color: var(--bt-warning-ink);
            }

        .bt-talent-next.complete > i {
            color: var(--bt-success-ink);
        }

        .bt-talent-trees {
            display: grid;
            grid-template-columns: repeat(3, minmax(210px, 1fr));
            align-items: start;
            gap: 9px;
        }

        .bt-talent-tree {
            min-width: 0;
            overflow: hidden;
            border: 1px solid var(--border-light);
            border-radius: 7px;
            background: color-mix(in srgb, var(--text-primary) 3%, var(--bg-card));
        }

            .bt-talent-tree > header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 8px 10px;
                border-bottom: 1px solid var(--border-light);
                background: var(--bg-card-alt);
            }

                .bt-talent-tree > header div {
                    min-width: 0;
                    display: flex;
                    flex-direction: column;
                }

                .bt-talent-tree > header b {
                    overflow: hidden;
                    color: var(--text-primary);
                    font-size: 12px;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                }

                .bt-talent-tree > header span,
                .bt-talent-tree > header small,
                .bt-talent-tree > footer {
                    color: var(--text-muted);
                    font-size: 10px;
                    font-weight: 400;
                }

                .bt-talent-tree > header strong {
                    color: var(--accent);
                    font-size: 16px;
                    font-variant-numeric: tabular-nums;
                }

            .bt-talent-tree > footer {
                padding: 6px 8px;
                border-top: 1px solid var(--border-light);
                text-align: center;
            }

        .bt-talent-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(42px, 1fr));
            grid-template-rows: repeat(7, 70px);
            gap: 4px;
            padding: 8px 5px;
        }

        .bt-talent-node {
            position: relative;
            display: flex;
            min-width: 0;
            align-items: center;
            flex-direction: column;
            text-align: center;
        }

            .bt-talent-node .bt-talent-icon {
                opacity: .42;
            }

            .bt-talent-node.planned .bt-talent-icon {
                opacity: .72;
            }

            .bt-talent-node.learned .bt-talent-icon {
                opacity: 1;
            }

            .bt-talent-node > span,
            .bt-talent-node > small {
                width: 100%;
                overflow: hidden;
                font-size: 9px;
                line-height: 12px;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .bt-talent-node > span {
                color: var(--text-secondary);
            }

            .bt-talent-node > small {
                color: var(--text-muted);
            }

        .bt-talent-icon {
            position: relative;
            width: 34px;
            height: 34px;
            margin-bottom: 2px;
            border: 2px solid var(--border-medium);
            border-radius: 5px;
            background: var(--bg-body);
        }

            .bt-talent-icon img {
                width: 30px;
                height: 30px;
                border-radius: 3px;
                image-rendering: pixelated;
            }

            .bt-talent-icon em {
                position: absolute;
                right: -4px;
                bottom: -4px;
                padding: 1px 3px;
                border-radius: 3px;
                background: rgba(0,0,0,.88);
                color: #fff;
                font-size: 9px;
                font-style: normal;
                font-weight: 700;
                line-height: 11px;
            }

        .bt-talent-node.learned .bt-talent-icon {
            border-color: var(--bt-success);
            box-shadow: 0 0 7px color-mix(in srgb, var(--bt-success) 24%, transparent);
        }

        .bt-talent-node.missing .bt-talent-icon {
            border-color: var(--bt-warning);
        }

        .bt-talent-node.conflict .bt-talent-icon {
            border-color: var(--bt-danger);
            box-shadow: 0 0 8px color-mix(in srgb, var(--bt-danger) 38%, transparent);
        }

        .bt-talent-node.next .bt-talent-icon {
            outline: 2px solid var(--bt-info);
            outline-offset: 2px;
        }

        .bt-talent-source {
            margin-top: 9px;
            color: var(--text-muted);
            font-size: 10px;
            text-align: center;
        }

            .bt-talent-source i {
                margin-right: 4px;
            }

        @@media (max-width: 1050px) {
            .bt-talent-trees {
                grid-template-columns: 1fr;
            }

            .bt-talent-summary {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .bt-build-grid {
                grid-template-columns: 1fr;
            }

                .bt-build-grid > label > small {
                    min-height: 0;
                }
        }

        @@media (max-width: 620px) {
            .bt-talent-summary {
                grid-template-columns: 1fr;
            }

            .bt-rotation-card {
                grid-template-columns: 36px minmax(0, 1fr);
            }

            .bt-rotation-icon {
                width: 34px;
                height: 34px;
            }

            .bt-rotation-badge {
                grid-column: 1 / -1;
                justify-self: start;
            }

            .bt-build-preview {
                grid-template-columns: 1fr;
            }

                .bt-build-preview > i {
                    transform: rotate(90deg);
                }

            .bt-build-workshop > footer {
                align-items: stretch;
                flex-direction: column;
            }

            .bt-build-queue {
                grid-template-columns: 24px minmax(0, 1fr);
            }

            .bt-build-queue-actions {
                grid-column: 1 / -1;
                justify-content: stretch;
            }

                .bt-build-queue-actions > button {
                    flex: 1;
                }
        }

        /* --- Spellbook tab (learned character_spell projection) --- */
        .bt-spell-toolbar {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px 14px;
            margin: 10px 0 8px;
            padding: 9px 11px;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            background: var(--bg-card-alt);
        }

            .bt-spell-toolbar label {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                margin: 0;
                color: var(--text-secondary);
                cursor: pointer;
                font-size: 11px;
                white-space: nowrap;
            }

            .bt-spell-toolbar input[type=checkbox] {
                margin: 0;
                accent-color: var(--accent);
                cursor: pointer;
            }

        .bt-spell-search {
            position: relative;
            flex: 1 1 210px;
            min-width: 170px;
        }

            .bt-spell-search > i {
                position: absolute;
                top: 50%;
                left: 9px;
                color: var(--text-muted);
                font-size: 11px;
                pointer-events: none;
                transform: translateY(-50%);
            }

            .bt-spell-search > input {
                width: 100%;
                padding: 5px 9px 5px 26px;
                font-size: 11px;
            }

        .bt-spell-count {
            margin: 0 0 8px;
            color: var(--text-muted);
            font-size: 10px;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .bt-spell-group {
            margin-bottom: 8px;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            background: var(--bg-card);
            overflow: hidden;
        }

            .bt-spell-group > header {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 8px 11px;
                border-bottom: 1px solid var(--border-light);
                background: var(--bg-card-alt);
                cursor: pointer;
                user-select: none;
            }

            .bt-spell-group.collapsed > header {
                border-bottom: 0;
            }

                .bt-spell-group > header > i {
                    width: 10px;
                    color: var(--text-muted);
                    font-size: 10px;
                }

                .bt-spell-group > header > b {
                    color: var(--text-primary);
                    font-size: 12px;
                }

                .bt-spell-group > header > span {
                    flex: 1;
                    color: var(--text-muted);
                    font-size: 10px;
                    letter-spacing: .05em;
                    text-transform: uppercase;
                }

                .bt-spell-group > header > strong {
                    padding: 1px 7px;
                    border-radius: 999px;
                    background: var(--accent-subtle);
                    color: var(--accent);
                    font-size: 10px;
                    font-weight: 700;
                }

        .bt-spell-list {
            display: flex;
            flex-direction: column;
        }

        .bt-spell-row {
            display: grid;
            align-items: center;
            gap: 9px;
            padding: 5px 11px;
            border-bottom: 1px solid color-mix(in srgb, var(--border-light) 55%, transparent);
            grid-template-columns: 28px minmax(0, 1fr) auto auto;
        }

            .bt-spell-row:last-child {
                border-bottom: 0;
            }

            .bt-spell-row:hover {
                background: var(--accent-subtle);
            }

            .bt-spell-row.old {
                opacity: .58;
            }

            .bt-spell-row.rot {
                box-shadow: inset 3px 0 var(--bt-info);
            }

        .bt-spell-icon {
            width: 26px;
            height: 26px;
            border: 1px solid var(--border-medium);
            border-radius: 4px;
            background: var(--bg-body);
        }

            .bt-spell-row.rot .bt-spell-icon {
                border-color: var(--bt-info);
            }

            .bt-spell-row.passive .bt-spell-icon {
                border-style: dashed;
            }

            .bt-spell-icon img {
                display: block;
                width: 24px;
                height: 24px;
                border-radius: 3px;
                image-rendering: pixelated;
            }

        .bt-spell-main {
            display: flex;
            min-width: 0;
            flex-direction: column;
        }

            .bt-spell-main > b {
                overflow: hidden;
                color: var(--text-primary);
                font-size: 12px;
                font-weight: 600;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .bt-spell-main > small {
                color: var(--text-muted);
                font-size: 10px;
            }

        .bt-spell-tags {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 4px;
            justify-content: flex-end;
        }

        .bt-spell-tag {
            padding: 1px 6px;
            border: 1px solid var(--border-light);
            border-radius: 999px;
            color: var(--text-secondary);
            font-size: 9px;
            font-weight: 700;
            letter-spacing: .04em;
            white-space: nowrap;
        }

            .bt-spell-tag.rot {
                border-color: var(--bt-info);
                background: color-mix(in srgb, var(--bt-info) 14%, transparent);
                color: var(--bt-info-ink);
            }

            .bt-spell-tag.talent {
                border-color: var(--bt-success);
                background: color-mix(in srgb, var(--bt-success) 14%, transparent);
                color: var(--bt-success-ink);
            }

            .bt-spell-tag.old {
                border-color: var(--bt-warning);
                color: var(--bt-warning-ink);
            }

            .bt-spell-tag.bad {
                border-color: var(--bt-danger);
                background: color-mix(in srgb, var(--bt-danger) 14%, transparent);
                color: var(--bt-danger-ink);
            }

            .bt-spell-tag.passive,
            .bt-spell-tag.muted {
                color: var(--text-muted);
            }

        .bt-spell-id {
            min-width: 52px;
            padding: 2px 7px;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-sm);
            background: var(--bg-body);
            color: var(--text-secondary);
            cursor: pointer;
            font-family: Consolas, "Courier New", monospace;
            font-size: 10px;
            transition: var(--transition-fast);
        }

            .bt-spell-id:hover {
                border-color: var(--accent);
                background: var(--accent-subtle);
                color: var(--accent);
            }

        @@media (max-width: 900px) {
            .bt-spell-row {
                grid-template-columns: 28px minmax(0, 1fr) auto;
            }

            /* Explicit placement, not auto-flow: the tags precede the id button in
               source order, so left to itself the button is pushed onto a third row. */
            .bt-spell-tags {
                grid-area: 2 / 1 / 3 / -1;
                justify-content: flex-start;
            }

            .bt-spell-id {
                grid-area: 1 / 3 / 2 / 4;
            }

            .bt-spell-tags:empty {
                display: none;
            }
        }

        /* --- WoW Class Colors --- */
        .class-warrior {
            background: #C69B6D22;
            color: #C79C6E;
        }

        .class-paladin {
            background: #F48CBA22;
            color: #F58CBA;
        }

        .class-hunter {
            background: #AAD37222;
            color: #ABD473;
        }

        .class-rogue {
            background: #FFF46822;
            color: #FFF569;
        }

        .class-priest {
            background: #FFFFFF22;
            color: #cccccc;
        }

        .class-shaman {
            background: #0070DD22;
            color: #0070DE;
        }

        .class-mage {
            background: #3FC7EB22;
            color: #40C7EB;
        }

        .class-warlock {
            background: #8788EE22;
            color: #8787EE;
        }

        .class-druid {
            background: #FF7C0A22;
            color: #FF7D0A;
        }

        .bt-class-badge {
            font-size: 10px;
            font-weight: 600;
            padding: 2px 6px;
            border-radius: 3px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        /* --- Scrollbar Styling --- */
        .bt-roster::-webkit-scrollbar,
        .bt-detail::-webkit-scrollbar,
        .bt-timeline::-webkit-scrollbar {
            width: 4px;
        }

        .bt-roster::-webkit-scrollbar-thumb,
        .bt-detail::-webkit-scrollbar-thumb {
            background: var(--border-light);
            border-radius: 2px;
        }

        .bt-timeline::-webkit-scrollbar-thumb {
            background: #2a3341;
            border-radius: 2px;
        }
    </style>
}

<div class="app-shell">
    <partial name="_Sidebar" />

    <div class="main-content">
        <div class="content-header d-flex align-items-start justify-content-between">
            <div>
                <h1><i class="fa-solid fa-brain" style="color: var(--accent);"></i> Bot Cockpit</h1>
                <p>Fleet census, roster and per-bot control — personality, decisions, economy, live spine state</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <button id="btnFleetControl" class="btn-accent" style="font-size:11px;padding:4px 10px;height:26px;white-space:nowrap;" title="Broadcast a command to every connected bot">
                    <i class="fa-solid fa-sliders"></i> Fleet Control
                </button>
                <button id="btnAddBots" class="btn-accent" style="font-size:11px;padding:4px 10px;height:26px;white-space:nowrap;" title="Quick-spawn bots via .bot addai">
                    <i class="fa-solid fa-user-plus"></i> Add Bots
                </button>
                <button id="btnManageGroups" class="btn-accent" style="font-size:11px;padding:4px 10px;height:26px;white-space:nowrap;" title="Search bot groups by member name, disband one, or dissolve them all">
                    <i class="fa-solid fa-people-group"></i> Manage Bot Groups
                </button>
                <button id="btnLoadSuperuiBots" class="btn-accent" style="font-size:11px;padding:4px 10px;height:26px;white-space:nowrap;" title="Re-add every persisted SuperUI bot to the world via .bot add_all — use after a server reset">
                    <i class="fa-solid fa-users-rays"></i> Load SuperUI Bots
                </button>
                <button id="btnReaddBot" class="btn-accent" style="font-size:11px;padding:4px 10px;height:26px;white-space:nowrap;" title="Bring a single persisted bot back online, picked from the roster">
                    <i class="fa-solid fa-user-check"></i> Re-add Bot
                </button>
                <span class="bt-stat" title="Tracked bots">
                    <i class="fa-solid fa-robot"></i> <span class="bt-stat-val" id="statTracked">0</span>
                </span>
                <span class="bt-stat" title="Active brains">
                    <i class="fa-solid fa-brain"></i> <span class="bt-stat-val" id="statBrains">0</span>
                </span>
                <span class="bt-stat" title="Decisions/min">
                    <i class="fa-solid fa-gauge-high"></i> <span class="bt-stat-val" id="statDpm">0</span>
                </span>
                <div class="bt-engine-toggle" id="engineToggle" title="Toggle brain engine">
                    <span class="bt-engine-dot"></span>
                    <span class="bt-engine-label">Engine Off</span>
                </div>
                <div style="display:inline-flex;align-items:center;gap:6px;margin-left:4px;">
                    <label style="color:var(--text-muted);font-size:11px;margin:0;white-space:nowrap;">Grouping:</label>
                    <select id="groupingMode" class="form-input" style="width:auto;font-size:11px;padding:2px 6px;height:26px;">
                        <option value="0">Off</option>
                        <option value="1">Sticky</option>
                        <option value="2">Opportunistic</option>
                    </select>
                    <button id="autoFormGroups" class="btn-accent" style="font-size:10px;padding:2px 8px;height:26px;white-space:nowrap;" title="Auto-pair ungrouped bots by class">
                        <i class="fa-solid fa-users"></i> Auto-Form
                    </button>
                </div>
                <span class="status-dot offline" id="bridgeStatus"></span>
                <span id="bridgeStatusText" style="font-weight:500;font-size:13px;">Connecting...</span>
            </div>
        </div>

        <div class="content-body bt-page">

            <!-- Fleet cockpit: census + filter control. Every tile and chip is a roster filter. -->
            <div class="bt-cockpit">
                <div class="bt-cockpit-head">
                    <i class="fa-solid fa-gauge head-i"></i> Fleet
                    <div class="bt-cockpit-spacer"></div>
                    <span id="cockpitFilterPill"></span>
                    <button id="cockpitToggle" title="Collapse / expand the fleet strip"><i class="fa-solid fa-chevron-up"></i></button>
                </div>
                <div class="bt-cockpit-body">
                    <div class="bt-tiles" id="fleetTiles"></div>
                    <div id="fleetBreakdown"></div>
                </div>
            </div>

            <!-- Main Layout -->
            <div class="bt-layout">
                <!-- Left: Roster toolbar + Bot Roster + Groups -->
                <div style="display:flex;flex-direction:column;overflow:hidden;">

                    <div class="bt-roster-bar">
                        <input type="text" class="form-input" id="rosterSearch" placeholder="Search name..." style="width:120px;" />
                        <select class="form-input" id="rosterSort" title="Sort order" style="width:auto;">
                            <option value="level_desc">Level ↓</option>
                            <option value="level_asc">Level ↑</option>
                            <option value="name">Name</option>
                            <option value="class">Class</option>
                            <option value="zone">Zone</option>
                            <option value="activity">Doing</option>
                            <option value="gold">Gold</option>
                            <option value="hp">Lowest HP</option>
                            <option value="group">Group</option>
                        </select>
                        <select class="form-input" id="rosterGroup" title="Group the roster by" style="width:auto;">
                            <option value="none">No grouping</option>
                            <option value="zone">By zone</option>
                            <option value="level">By level band</option>
                            <option value="class">By class</option>
                            <option value="activity">By activity</option>
                            <option value="group">By party</option>
                        </select>
                        <span class="bt-roster-count" id="rosterCount">0</span>
                    </div>

                    <div class="bt-roster" id="botRoster" style="flex:1;overflow-y:auto;">
                        <div class="bt-detail-empty" id="rosterEmpty">
                            <i class="fa-solid fa-robot"></i>
                            <div style="font-size:14px;">No bots connected</div>
                            <div style="font-size:12px;margin-top:4px;">Waiting for AiBotAI on TCP 3444...</div>
                        </div>
                    </div>

                    <!-- Groups Panel -->
                    <div class="bt-section" style="margin-top:8px;flex-shrink:0;max-height:200px;overflow-y:auto;">
                        <div class="bt-section-header">
                            <span><i class="fa-solid fa-users" style="color:var(--accent);margin-right:6px;"></i>Groups</span>
                            <span id="groupCount" style="font-size:10px;color:var(--text-muted);">0</span>
                        </div>
                        <div id="groupList" style="padding:6px 10px;">
                            <div style="color:var(--text-muted);font-size:12px;">No active groups</div>
                        </div>
                    </div>
                </div>

                <!-- Right: Detail Panel -->
                <div class="bt-detail" id="detailPanel">
                    <div class="bt-detail-empty" id="detailEmpty">
                        <i class="fa-solid fa-brain"></i>
                        <div style="font-size:14px;">Select a bot to inspect</div>
                        <div style="font-size:12px;margin-top:4px;">Click the <i class="fa-solid fa-sliders"></i> button on any bot to drive it</div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/bots.js" asp-append-version="true"></script>
}
