@{
    ViewData["Title"] = "Settings";
    string? circuitAppRevision = MangosSuperUI.Services.CircuitTraceSourceService.InstalledApplicationRevision;
    string? circuitAppArchiveUrl = MangosSuperUI.Services.CircuitTraceSourceService.InstalledApplicationSourceArchiveUrl;
    string circuitAppRevisionShort = circuitAppRevision is { Length: > 12 }
        ? circuitAppRevision[..12]
        : circuitAppRevision ?? "unknown";
}

<div class="app-shell">
    <partial name="_Sidebar" />

    <div class="main-content">
        <div class="content-header">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1>Settings</h1>
                    <p>Server connection and path configuration</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn-outline-subtle" id="btnResetConfig" title="Remove override file and revert to appsettings.json">
                        <i class="fa-solid fa-rotate-left"></i> Reset to Defaults
                    </button>
                    @* Shown by settings.js only while the form has unsaved edits. *@
                    <button class="btn-outline-subtle" id="btnRevertConfig" style="display: none;" title="Discard unsaved edits and reload the running configuration">
                        <i class="fa-solid fa-arrow-rotate-left"></i> Discard Changes
                    </button>
                    <button class="btn-accent" id="btnSaveConfig">
                        <i class="fa-solid fa-floppy-disk"></i> Save Settings
                    </button>
                </div>
            </div>
        </div>

        <div class="content-body">
            @Html.AntiForgeryToken()

            <!-- Status Banner -->
            <div class="card mb-4" id="configStatusCard">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="fa-solid fa-circle-info" style="color: var(--accent); font-size: 18px;"></i>
                    <div>
                        <div style="font-weight: 600; font-size: 13.5px;" id="configStatusTitle">Loading configuration...</div>
                        <div style="font-size: 12.5px; color: var(--text-secondary);" id="configStatusDetail"></div>
                    </div>
                </div>
            </div>

            <!-- Circuit Board source code -->
            <div class="card mb-4 source-setup-card" id="circuit-source">
                <div class="card-header d-flex align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-code-branch" style="color: var(--accent);"></i>
                        Circuit Board Source Code
                    </div>
                    <a class="btn-outline-subtle btn-xs" id="btnOpenCircuit" href="/CircuitTrace">
                        Open Circuit Board <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
                <div class="card-body">
                    <p class="source-setup-intro">
                        Circuit Board explains each decision beside the exact code that made it. It needs
                        <strong>two different source code packages</strong>&mdash;one from MangosSuperUI and one from
                        SuperUI-Core. A published application ZIP contains compiled files, not source, and will not work here.
                    </p>

                    <div class="source-package-guide">
                        <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        <div>
                            <strong>Use the source versions that built this installation.</strong>
                            If the source checkout is on the same machine as the MangosSuperUI service, enter its server path.
                            Otherwise, download the matching repository source ZIP and upload it in the correct row below.
                            A server path is not a folder on the computer running your browser.
                        </div>
                    </div>

                    <div class="source-overall" id="circuitSourceOverall" aria-live="polite">
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        <span>Checking source code...</span>
                    </div>

                    <div class="source-setup-grid">
                        <section class="source-setup-item" data-source-row="csharp">
                            <div class="source-setup-heading">
                                <div>
                                    <div class="source-setup-title">1. MangosSuperUI (C#)</div>
                                    <div class="source-setup-note">
                                        Get the matching source from the
                                        <a href="https://github.com/Yafrovon/MangosSuperUI/releases" target="_blank" rel="noopener">MangosSuperUI release</a>
                                        you installed (the <strong>Source code (zip)</strong> asset), or from your build checkout.
                                        The ZIP must contain <code>MangosSuperUI/MangosSuperUI.csproj</code> and <code>MangosSuperUI/BotLogic</code>.
                                        @if (circuitAppArchiveUrl != null)
                                        {
                                            <span class="source-revision-callout">
                                                This installation records base commit <code title="@circuitAppRevision">@circuitAppRevisionShort</code>.
                                                <a href="@circuitAppArchiveUrl" target="_blank" rel="noopener">Download that commit's source ZIP</a>.
                                                If the application was built with uncommitted changes, use its original build checkout instead.
                                            </span>
                                        }
                                    </div>
                                </div>
                                <span class="source-state" id="circuitCSharpState">Checking</span>
                            </div>
                            <div class="source-method">
                                <label class="source-method-label" for="cfgCircuitCSharpSourcePath">Folder already on the server</label>
                                <input type="text" class="form-input cfg-input" id="cfgCircuitCSharpSourcePath"
                                       aria-label="MangosSuperUI source folder on the server"
                                       placeholder="C:\source\MangosSuperUI\MangosSuperUI or /srv/MangosSuperUI/MangosSuperUI" />
                                <span class="source-method-help">Paste the server path, then click <strong>Save Settings</strong>.</span>
                            </div>
                            <div class="source-method-divider"><span>or</span></div>
                            <div class="source-method">
                                <span class="source-method-label">ZIP from this computer</span>
                                <button type="button" class="btn-outline-subtle btn-source-upload" data-source-kind="csharp"
                                        aria-label="Upload MangosSuperUI C# source ZIP">
                                    <i class="fa-solid fa-file-zipper"></i> Upload MangosSuperUI ZIP
                                </button>
                                <span class="source-method-help">Uploads and installs immediately; no Settings save is needed.</span>
                                <input type="file" class="source-file-input" id="circuitCSharpZip" data-source-kind="csharp" accept=".zip,application/zip" />
                            </div>
                            <div class="source-result" id="circuitCSharpStatus">Waiting for source status.</div>
                        </section>

                        <section class="source-setup-item" data-source-row="cpp">
                            <div class="source-setup-heading">
                                <div>
                                    <div class="source-setup-title">2. SuperUI-Core (VMaNGOS C++)</div>
                                    <div class="source-setup-note">
                                        Prefer the exact checkout that built the running <code>mangosd</code>. Enter its
                                        <code>src</code> folder on this server, or download that revision from the
                                        <a href="https://github.com/Yafrovon/SuperUI-Core" target="_blank" rel="noopener">SuperUI-Core repository</a>
                                        and upload the repository ZIP. It must contain <code>src/game/SuperUiContent/SuiBots</code>.
                                        <span class="source-revision-callout">
                                            The Dashboard's <strong>Core Revision</strong> identifies the commit used by the running server.
                                        </span>
                                    </div>
                                </div>
                                <span class="source-state" id="circuitCppState">Checking</span>
                            </div>
                            <div class="source-method">
                                <label class="source-method-label" for="cfgSourcePath">Folder already on the server</label>
                                <input type="text" class="form-input cfg-input" id="cfgSourcePath"
                                       aria-label="SuperUI-Core src folder on the server"
                                       placeholder="/home/wowvmangos/vmangos/src" />
                                <span class="source-method-help">Paste the server's <code>src</code> path, then click <strong>Save Settings</strong>.</span>
                            </div>
                            <div class="source-method-divider"><span>or</span></div>
                            <div class="source-method">
                                <span class="source-method-label">ZIP from this computer</span>
                                <button type="button" class="btn-outline-subtle btn-source-upload" data-source-kind="cpp"
                                        aria-label="Upload SuperUI-Core C++ source ZIP">
                                    <i class="fa-solid fa-file-zipper"></i> Upload SuperUI-Core ZIP
                                </button>
                                <span class="source-method-help">Uploads and installs immediately; do not use stock VMaNGOS.</span>
                                <input type="file" class="source-file-input" id="circuitCppZip" data-source-kind="cpp" accept=".zip,application/zip" />
                            </div>
                            <div class="source-result" id="circuitCppStatus">Waiting for source status.</div>
                        </section>
                    </div>

                    <p class="source-upload-help">
                        <i class="fa-solid fa-lightbulb" aria-hidden="true"></i>
                        Upload each ZIP in its own row (<span id="circuitUploadLimit">up to 256 MB each</span>).
                        GitHub's downloaded ZIP can be uploaded as-is; the installer finds the project inside its wrapper folder.
                        After a successful upload, that row changes to <strong>Ready</strong>.
                    </p>

                    <details class="source-advanced">
                        <summary>Advanced upload storage</summary>
                        <div class="source-advanced-body">
                            <label class="cmd-label">Uploaded source package directory</label>
                            <input type="text" class="form-input cfg-input" id="cfgCircuitSourcePackageDirectory"
                                   placeholder="(uses the service account's application-data folder)" />
                            <div class="source-setup-note">
                                Leave blank for durable storage outside the published site. A relative path is resolved under the service account's application-data folder.
                            </div>
                        </div>
                    </details>
                </div>
            </div>

            <!-- Database Connections -->
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="fa-solid fa-database" style="color: var(--accent);"></i>
                    Database Connections
                </div>
                <div class="card-body">
                    <p style="font-size: 12.5px; color: var(--text-secondary); margin: 0 0 16px;">
                        Connection strings for the VMaNGOS databases. Use <code>127.0.0.1</code> when the app runs on the same machine as MariaDB.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="cmd-label">Mangos (World DB)</label>
                            <input type="text" class="form-input cfg-input" id="cfgMangos" data-path="connectionStrings.mangos" />
                        </div>
                        <div class="col-md-6">
                            <label class="cmd-label">Characters</label>
                            <input type="text" class="form-input cfg-input" id="cfgCharacters" data-path="connectionStrings.characters" />
                        </div>
                        <div class="col-md-6">
                            <label class="cmd-label">Realmd (Auth DB)</label>
                            <input type="text" class="form-input cfg-input" id="cfgRealmd" data-path="connectionStrings.realmd" />
                        </div>
                        <div class="col-md-6">
                            <label class="cmd-label">Logs</label>
                            <input type="text" class="form-input cfg-input" id="cfgLogs" data-path="connectionStrings.logs" />
                        </div>
                        <div class="col-md-6">
                            <label class="cmd-label">Admin (Custom Tables)</label>
                            <input type="text" class="form-input cfg-input" id="cfgAdmin" data-path="connectionStrings.admin" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Remote Access -->
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="fa-solid fa-plug" style="color: var(--accent);"></i>
                    Remote Access (RA)
                </div>
                <div class="card-body">
                    <p style="font-size: 12.5px; color: var(--text-secondary); margin: 0 0 16px;">
                        TCP connection to mangosd's Remote Access console. Use <code>127.0.0.1</code> when deployed on the same machine.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="cmd-label">Host</label>
                            <input type="text" class="form-input cfg-input" id="cfgRaHost" data-path="remoteAccess.host" />
                        </div>
                        <div class="col-md-2">
                            <label class="cmd-label">Port</label>
                            <input type="number" class="form-input cfg-input" id="cfgRaPort" data-path="remoteAccess.port" />
                        </div>
                        <div class="col-md-3">
                            <label class="cmd-label">Username</label>
                            <input type="text" class="form-input cfg-input" id="cfgRaUser" data-path="remoteAccess.username" />
                        </div>
                        <div class="col-md-2">
                            <label class="cmd-label">Password</label>
                            <input type="text" class="form-input cfg-input" id="cfgRaPass" data-path="remoteAccess.password" />
                        </div>
                        <div class="col-md-2">
                            <label class="cmd-label">Timeout (ms)</label>
                            <input type="number" class="form-input cfg-input" id="cfgRaTimeout" data-path="remoteAccess.commandTimeoutMs" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- VMaNGOS Paths & Processes -->
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="fa-solid fa-folder-open" style="color: var(--accent);"></i>
                    VMaNGOS Paths & Processes
                </div>
                <div class="card-body">
                    <p style="font-size: 12.5px; color: var(--text-secondary); margin: 0 0 16px;">
                        Paths to the VMaNGOS installation on the server. Only used when the app is deployed on the same machine.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="cmd-label">Bin Directory</label>
                            <input type="text" class="form-input cfg-input" id="cfgBinDir" data-path="vmangos.binDirectory" />
                        </div>
                        <div class="col-md-4">
                            <label class="cmd-label">
                                Run Directory
                                <i class="fa-solid fa-circle-question cfg-hint" title="Working directory used when the app launches mangosd/realmd (Windows). mangosd resolves mangosd.conf and data/ relative to this. Leave blank to use the Bin Directory."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgRunDir" data-path="vmangos.runDirectory" placeholder="(defaults to Bin Directory)" />
                        </div>
                        <div class="col-md-4">
                            <label class="cmd-label">Log Directory</label>
                            <input type="text" class="form-input cfg-input" id="cfgLogDir" data-path="vmangos.logDirectory" />
                        </div>
                        <div class="col-md-4">
                            <label class="cmd-label">Config Directory</label>
                            <input type="text" class="form-input cfg-input" id="cfgConfDir" data-path="vmangos.configDirectory" />
                        </div>
                        <div class="col-md-4">
                            <label class="cmd-label">
                                World Server Process Name
                                <i class="fa-solid fa-circle-question cfg-hint" title="The process name as seen by the OS. Run: cat /proc/$(pgrep -f mangosd)/comm to find it. Common values: mangosd, mangosd-main"></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgMangosdProcess" placeholder="mangosd" />
                        </div>
                        <div class="col-md-4">
                            <label class="cmd-label">
                                Auth Server Process Name
                                <i class="fa-solid fa-circle-question cfg-hint" title="The process name as seen by the OS. Run: cat /proc/$(pgrep -f realmd)/comm to find it. Common values: realmd, realmd-main"></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgRealmdProcess" placeholder="realmd" />
                        </div>
                        <div class="col-md-6">
                            <label class="cmd-label">
                                mangosd.conf Path
                                <i class="fa-solid fa-circle-question cfg-hint" title="Full path to mangosd.conf. Used by the Config Editor page. Find it with: find / -name mangosd.conf 2>/dev/null"></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgMangosdConfPath" placeholder="/home/wowvmangos/vmangos/run/etc/mangosd.conf" />
                        </div>
                        <div class="col-md-6">
                            <label class="cmd-label">
                                Server Logs Directory
                                <i class="fa-solid fa-circle-question cfg-hint" title="Directory containing Server.log, Chat.log, etc. Used by the Live Logs page."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgLogsDir" placeholder="/home/wowvmangos/vmangos/run/bin" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- DBC Data Files -->
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="fa-solid fa-icons" style="color: var(--accent);"></i>
                    DBC Data Files
                </div>
                <div class="card-body">
                    <p style="font-size: 12.5px; color: var(--text-secondary); margin: 0 0 16px;">
                        Path to the extracted 1.12.1 DBC files on the server. Used by the Spell/Item/Game Object browsers for icon resolution and auxiliary data lookups.
                        These files are read from the VMaNGOS runtime data directory — they are <strong>not</strong> copied into the MangosSuperUI deployment.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="cmd-label">
                                DBC Directory Path
                                <i class="fa-solid fa-circle-question cfg-hint" title="Directory containing Spell.dbc, ItemDisplayInfo.dbc, SpellIcon.dbc, etc. Usually located at /home/wowvmangos/vmangos/run/data/5875/dbc"></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgDbcPath" placeholder="/home/wowvmangos/vmangos/run/data/5875/dbc" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button class="btn-outline-subtle" id="btnReloadDbc" title="Re-read DBC files from the configured path">
                                <i class="fa-solid fa-arrows-rotate"></i> Reload DBC
                            </button>
                        </div>
                    </div>

                    <!-- DBC Status -->
                    <div class="dbc-status-panel mt-3" id="dbcStatusPanel">
                        <div class="d-flex align-items-center gap-2" id="dbcStatusRow">
                            <i class="fa-solid fa-spinner fa-spin" style="font-size: 13px; color: var(--text-muted);"></i>
                            <span style="font-size: 12.5px; color: var(--text-secondary);">Checking DBC status...</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Maps Data (Heightmaps) -->
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="fa-solid fa-mountain-sun" style="color: var(--accent);"></i>
                    Maps Data (Heightmaps)
                </div>
                <div class="card-body">
                    <p style="font-size: 12.5px; color: var(--text-secondary); margin: 0 0 16px;">
                        Path to the pre-extracted <code>.map</code> files generated by the VMaNGOS map extractor.
                        Used by the World Map page to resolve terrain Z height when placing game objects.
                        Without this, objects placed via the web map will spawn at Z=0 (sea level).
                    </p>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="cmd-label">
                                Maps Directory Path
                                <i class="fa-solid fa-circle-question cfg-hint" title="Directory containing .map files (e.g. 0002730.map). Usually located at /home/wowvmangos/vmangos/run/data/maps — these are the files produced by the ad extractor, not raw ADT files."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgMapsDataPath" placeholder="/home/wowvmangos/vmangos/run/data/maps" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Spell Creator Paths -->
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="fa-solid fa-wand-magic-sparkles" style="color: var(--accent);"></i>
                    Spell Creator Paths
                </div>
                <div class="card-body">
                    <p style="font-size: 12.5px; color: var(--text-secondary); margin: 0 0 16px;">
                        Paths used by the Spell Creator's patch pipeline. M2 particle files are sourced from the pre-extracted directory first,
                        falling back to <code>patch*.MPQ</code> files in the client data directory. The output directory is where <code>patch-3.MPQ</code> is written.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="cmd-label">
                                Pre-extracted M2 Files
                                <i class="fa-solid fa-circle-question cfg-hint" title="Directory containing M2 particle effect files extracted from the client's patch.MPQ via Ladik's MPQ Editor. Preserves MPQ path structure (e.g. Spells/Fire_Cast_Hand.m2). This is the PRIMARY source — model.MPQ is blacklisted."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgClientM2Path" placeholder="/home/wowvmangos/wowclient/m2" />
                        </div>
                        <div class="col-md-6">
                            <label class="cmd-label">
                                Client Data Directory
                                <i class="fa-solid fa-circle-question cfg-hint" title="Directory containing the WoW client's MPQ archives (patch.MPQ, patch-2.MPQ, etc). Used as FALLBACK when an M2 isn't found in the pre-extracted directory. model.MPQ is excluded automatically."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgClientDataPath" placeholder="/home/wowvmangos/wowclient/Data" />
                        </div>
                        <div class="col-md-6">
                            <label class="cmd-label">
                                Patch Output Directory
                                <i class="fa-solid fa-circle-question cfg-hint" title="Where the unified patch-3.MPQ is written. Players download this file and place it in their WoW client's Data folder."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgPatchOutputPath" placeholder="/opt/mangossuperui/wwwroot/patches" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- AI Services (ComfyUI + Ollama) -->
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="fa-solid fa-microchip" style="color: var(--accent);"></i>
                    AI Services
                </div>
                <div class="card-body">
                    <p style="font-size: 12.5px; color: var(--text-secondary); margin: 0 0 16px;">
                        ComfyUI nodes for FLUX image generation (spell icons + particle textures), the Weapon Forge's
                        sketch → 3D reconstruction (Item Assets — needs an image→3D node pack installed once, see the
                        forge's <em>Set up sketch → 3D</em>), and Ollama for prompt crafting.
                        Multiple ComfyUI nodes form a pool — the dispatcher routes jobs to whichever node is idle, enabling parallel generation.
                    </p>

                    <!-- ComfyUI Nodes -->
                    <div style="margin-bottom: 20px;">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <label class="cmd-label" style="margin: 0;">
                                ComfyUI Nodes
                                <i class="fa-solid fa-circle-question cfg-hint" title="Each node is a ComfyUI instance on your network. The dispatcher checks GET /queue on each node and sends work to the first free one. Add more nodes to parallelize generation."></i>
                            </label>
                            <button class="btn-outline-subtle btn-xs" id="btnAddComfyNode" title="Add another ComfyUI node">
                                <i class="fa-solid fa-plus"></i> Add Node
                            </button>
                        </div>
                        <div id="comfyNodesContainer">
                            <!-- Populated by JS -->
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- CLIP Model -->
                        <div class="col-md-6">
                            <label class="cmd-label">
                                CLIP T5 Model
                                <i class="fa-solid fa-circle-question cfg-hint" title="The T5 text encoder model used in the FLUX workflow. Both ComfyUI nodes must have this file in their models/clip/ directory."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgClipModel2" placeholder="t5xxl_fp8_e4m3fn.safetensors" />
                        </div>

                        <!-- Ollama -->
                        <div class="col-md-6">
                            <label class="cmd-label">
                                Ollama Base URL
                                <i class="fa-solid fa-circle-question cfg-hint" title="HTTP endpoint for the Ollama API. Used to generate image prompts for spell icons and optionally refine texture prompts."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgOllamaUrl" placeholder="http://192.168.0.201:11434" />
                        </div>
                        <div class="col-md-6">
                            <label class="cmd-label">
                                Ollama Model
                                <i class="fa-solid fa-circle-question cfg-hint" title="Ollama model tag for prompt generation. Must be pulled on the Ollama server (ollama pull <model>)."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgOllamaModel" placeholder="qwen3:4b-instruct-2507-q4_K_M" />
                        </div>
                        <div class="col-md-6">
                            <label class="cmd-label">
                                Ollama Vision Model
                                <i class="fa-solid fa-circle-question cfg-hint" title="Ollama vision model for texture analysis and palette recoloring. Must support image input. Recommended: qwen3.5:27b (48GB GPU) or qwen3.5:4b (12GB GPU). Must be pulled on the Ollama server."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgOllamaVisionModel" placeholder="qwen3.5:27b" />
                        </div>
                        <!-- Vanilla BLP Reference -->
                        <div class="col-md-6">
                            <label class="cmd-label">
                                Vanilla BLP Directory
                                <i class="fa-solid fa-circle-question cfg-hint" title="Directory containing extracted vanilla BLP files (lowercase filenames). VanillaBlpService reads actual BLP headers from here to match output dimensions, format (DXT1/DXT3), and alpha depth. Without this, all custom textures default to 512×512 DXT3 — causing dark missiles and square artifacts."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgRawBlpPath" placeholder="/home/wowvmangos/wowclient/rawblps/m2_blps" />
                        </div>
                        <div class="col-md-6">
                            <label class="cmd-label">
                                Spell Creator Data
                                <i class="fa-solid fa-circle-question cfg-hint" title="Directory containing m2_texture_graph.json and blp_to_m2_reverse.json. These map M2 files to their vanilla BLP textures for the reference lookup."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgSpellDataPath" placeholder="/opt/mangossuperui/data" />
                        </div>
                    </div>

                    <!-- Pool Status -->
                    <div class="dbc-status-panel mt-3" id="comfyStatusPanel">
                        <div class="d-flex align-items-center gap-2" id="comfyStatusRow">
                            <i class="fa-solid fa-spinner fa-spin" style="font-size: 13px; color: var(--text-muted);"></i>
                            <span style="font-size: 12.5px; color: var(--text-secondary);">Checking ComfyUI pool status...</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- World Viewer / Server Data -->
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="fa-solid fa-mountain-city" style="color: var(--accent);"></i>
                    World Viewer &amp; Server Data
                </div>
                <div class="card-body">
                    <p style="font-size: 12.5px; color: var(--text-secondary); margin: 0 0 16px;">
                        Paths used by the <a href="/WorldViewer" style="color: var(--accent);">3D World Viewer</a>
                        for WMO placement, collision/pathfinding regeneration, and patch-Z.MPQ building.
                        The server data pipeline backs up vanilla originals as <code>.vanilla</code> files before overwriting &mdash;
                        these backups power the Restore Defaults button in the World Viewer placement panel.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="cmd-label">
                                Client Data Path
                                <i class="fa-solid fa-circle-question cfg-hint" title="WoW client Data/ folder containing the MPQ archives. REQUIRED for all game assets: icons, item/game-object 3D models, and minimap tiles are decoded from these archives on demand. Also used for VMapExtractor output, patch-Z.MPQ placement, and ADT reading. Restart after changing."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgVmangosClientDataPath"
                                   placeholder="/home/wowvmangos/wowclient/Data" />
                        </div>
                        <div class="col-md-6">
                            <label class="cmd-label">
                                Extractors Path
                                <i class="fa-solid fa-circle-question cfg-hint" title="Directory containing VMapAssembler and MoveMapGenerator binaries. These are run during server data regeneration after WMO placement commits."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgExtractorsPath"
                                   placeholder="/home/wowvmangos/vmangos/run/bin/Extractors" />
                        </div>
                        <div class="col-md-6">
                            <label class="cmd-label">
                                Server Data Path
                                <i class="fa-solid fa-circle-question cfg-hint" title="VMaNGOS runtime data directory containing maps/, vmaps/, mmaps/ subdirectories. Updated vmaps and mmtiles are copied here after regeneration. mangosd reads from this directory."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgServerDataPath"
                                   placeholder="/home/wowvmangos/vmangos/run/data" />
                        </div>
                        <div class="col-md-6">
                            <label class="cmd-label">
                                Vmaps Data Path <span style="opacity:.6">(optional)</span>
                                <i class="fa-solid fa-circle-question cfg-hint" title="VMaNGOS extracted vmaps directory (the .vmtile / .vmo files), used by the 3D World Editor for real building/tree/interior collision. Leave blank to use the 'vmaps' subfolder of Server Data Path."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgVmapsDataPath"
                                   placeholder="/home/wowvmangos/vmangos/run/data/vmaps" />
                        </div>
                        <div class="col-md-6">
                            <label class="cmd-label">
                                TBC Client Data Path <span style="opacity:.6">(optional)</span>
                                <i class="fa-solid fa-circle-question cfg-hint" title="A TBC (2.4.3) client's Data\ folder containing its MPQ archives. Enables the Weapon Forge's TBC-import section: browse the TBC weapon models and forge them into vanilla items. Read-only; picked up without a restart."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgTbcDataPath"
                                   placeholder="/home/wowvmangos/cmangos" />
                        </div>
                        <div class="col-md-6">
                            <label class="cmd-label">
                                WotLK Client Data Path <span style="opacity:.6">(optional)</span>
                                <i class="fa-solid fa-circle-question cfg-hint" title="A WotLK (3.3.5a) client's Data\ folder containing its MPQ archives (common/expansion/lichking/patch-*.MPQ + the enUS locale folder). Enables the Weapon Forge's and Armor Forge's WotLK-import sections: browse 3.3.5a weapons/armor by item name and forge them into vanilla items. Read-only; picked up without a restart."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgWotlkDataPath"
                                   placeholder="/home/wowvmangos/wrathclient" />
                        </div>
                    </div>

                    <!-- Vanilla Backup Status -->
                    <div class="dbc-status-panel mt-3" id="backupStatusPanel">
                        <div class="d-flex align-items-center gap-2" id="backupStatusRow">
                            <i class="fa-solid fa-spinner fa-spin" style="font-size: 13px; color: var(--text-muted);"></i>
                            <span style="font-size: 12.5px; color: var(--text-secondary);">Checking vanilla backup status...</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- World Storage -->
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="fa-solid fa-layer-group" style="color: var(--accent);"></i>
                    World Storage
                </div>
                <div class="card-body">
                    <p style="font-size: 12.5px; color: var(--text-secondary); margin: 0 0 16px;">
                        Paths used by the <a href="/Worlds" style="color: var(--accent);">World State</a> page.
                        Suspending a world dumps its databases with <code>mysqldump</code> as gzipped SQL and tars the
                        core source tree. The world registry (<code>worlds.json</code>) lives in this directory too —
                        it is deliberately kept out of <code>vmangos_admin</code>, which is itself swapped on every resume.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="cmd-label">
                                World Storage Directory
                                <i class="fa-solid fa-circle-question cfg-hint" title="Where suspended worlds are stored. Each suspend creates a timestamped subfolder containing dump files and a manifest.json, alongside the worlds.json registry."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgBackupDir" placeholder="/home/wowvmangos/backups" />
                        </div>
                        <div class="col-md-6">
                            <label class="cmd-label">
                                VMaNGOS SQL Path
                                <i class="fa-solid fa-circle-question cfg-hint" title="Path to the SQL migrations directory. Included in Core Source backups alongside the source tree."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgSqlPath" placeholder="/home/wowvmangos/vmangos/sql" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Documentation Wiki -->
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="fa-solid fa-book" style="color: var(--accent);"></i>
                    Documentation Wiki
                </div>
                <div class="card-body">
                    <p style="font-size: 12.5px; color: var(--text-secondary); margin: 0 0 16px;">
                        Root folder of the generated documentation corpus rendered by the <a href="/Wiki" style="color: var(--accent);">Wiki</a> page.
                        Point this at the folder containing the <code>.md</code> docs &mdash; the search index builds itself from the corpus
                        automatically (stored in the Admin database) and rebuilds whenever the docs change.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="cmd-label">
                                Docs Root Directory
                                <i class="fa-solid fa-circle-question cfg-hint" title="Directory containing the generated documentation (.md files, folder-mirrored, plus _topics/ guides). The Wiki page and its search read from here. Changing it requires an app restart."></i>
                            </label>
                            <input type="text" class="form-input cfg-input" id="cfgWikiRoot" placeholder="/home/wowvmangos/docs_full" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button class="btn-outline-subtle" id="btnWikiReindex" title="Force a full rebuild of the wiki search index. Needed after changing MariaDB's innodb_ft_min_token_size; otherwise the index maintains itself.">
                                <i class="fa-solid fa-arrows-rotate"></i> Rebuild Search Index
                            </button>
                        </div>
                    </div>

                    <!-- Wiki Status -->
                    <div class="dbc-status-panel mt-3" id="wikiStatusPanel">
                        <div class="d-flex align-items-center gap-2" id="wikiStatusRow">
                            <i class="fa-solid fa-spinner fa-spin" style="font-size: 13px; color: var(--text-muted);"></i>
                            <span style="font-size: 12.5px; color: var(--text-secondary);">Checking wiki status...</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Kestrel -->
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="fa-solid fa-network-wired" style="color: var(--accent);"></i>
                    Web Server (Kestrel)
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="cmd-label">Listen URL</label>
                            <input type="text" class="form-input cfg-input" id="cfgKestrelUrl" data-path="kestrel.url" placeholder="http://0.0.0.0:5000" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Save feedback -->
            <div id="saveMessage" style="display: none;" class="card mb-4">
                <div class="card-body d-flex align-items-center gap-3" id="saveMessageBody">
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .cfg-hint {
            color: var(--text-muted);
            font-size: 11px;
            margin-left: 4px;
            cursor: help;
        }

            .cfg-hint:hover {
                color: var(--accent);
            }

        .dbc-status-panel {
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 10px 14px;
        }

        .source-setup-card {
            scroll-margin-top: 18px;
        }

        .source-setup-intro {
            max-width: 920px;
            margin: 0 0 14px;
            color: var(--text-secondary);
            font-size: 12.75px;
            line-height: 1.55;
        }

        .source-package-guide {
            display: grid;
            grid-template-columns: 18px minmax(0, 1fr);
            gap: 9px;
            margin-bottom: 14px;
            padding: 11px 12px;
            border: 1px solid color-mix(in srgb, var(--accent) 36%, var(--border));
            border-radius: var(--radius-sm);
            background: color-mix(in srgb, var(--accent) 6%, var(--bg-input));
            color: var(--text-secondary);
            font-size: 12px;
            line-height: 1.5;
        }

        .source-package-guide > i {
            margin-top: 2px;
            color: var(--accent);
        }

        .source-package-guide strong {
            color: var(--text-primary);
        }

        .source-overall {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 14px;
            padding: 10px 12px;
            border: 1px solid var(--border);
            border-left: 3px solid var(--accent);
            border-radius: var(--radius-sm);
            background: var(--bg-input);
            color: var(--text-secondary);
            font-size: 12.5px;
        }

        .source-overall.is-ready {
            border-left-color: var(--status-online);
        }

        .source-overall.is-missing {
            border-left-color: var(--status-warning);
        }

        .source-overall.is-error {
            border-left-color: var(--status-error);
            color: var(--status-error);
        }

        .source-setup-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .source-setup-item {
            min-width: 0;
            padding: 14px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            background: color-mix(in srgb, var(--bg-input) 72%, transparent);
        }

        .source-setup-heading {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 11px;
        }

        .source-setup-title {
            color: var(--text-primary);
            font-size: 13px;
            font-weight: 650;
        }

        .source-setup-note,
        .source-result {
            color: var(--text-muted);
            font-size: 11.75px;
            line-height: 1.45;
        }

        .source-setup-note a,
        .source-upload-help a {
            color: var(--accent);
        }

        .source-revision-callout {
            display: block;
            margin-top: 6px;
            color: var(--text-secondary);
        }

        .source-state {
            flex: 0 0 auto;
            padding: 2px 8px;
            border: 1px solid var(--border);
            border-radius: 999px;
            color: var(--text-muted);
            font-size: 10.5px;
            font-weight: 650;
            text-transform: uppercase;
            letter-spacing: .035em;
        }

        .source-state.is-ready {
            border-color: color-mix(in srgb, var(--status-online) 55%, var(--border));
            color: var(--status-online);
        }

        .source-state.is-missing {
            border-color: color-mix(in srgb, var(--status-warning) 55%, var(--border));
            color: var(--status-warning);
        }

        .source-state.is-error {
            border-color: color-mix(in srgb, var(--status-error) 55%, var(--border));
            color: var(--status-error);
        }

        .source-state.is-working {
            border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
            color: var(--accent);
        }

        .source-method {
            display: grid;
            gap: 6px;
            margin-top: 12px;
        }

        .source-method-label {
            color: var(--text-secondary);
            font-size: 11.5px;
            font-weight: 650;
        }

        .source-method-help {
            color: var(--text-muted);
            font-size: 10.75px;
            line-height: 1.4;
        }

        .source-method-divider {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 8px;
            margin: 11px 0 -1px;
            color: var(--text-muted);
            font-size: 10px;
            text-transform: uppercase;
        }

        .source-method-divider::before,
        .source-method-divider::after {
            height: 1px;
            background: var(--border);
            content: "";
        }

        .btn-source-upload {
            width: 100%;
            white-space: nowrap;
        }

        .source-file-input {
            display: none;
        }

        .source-result.is-ready {
            color: var(--text-secondary);
        }

        .source-result.is-error {
            color: var(--status-error);
        }

        .source-result.is-working {
            color: var(--accent);
        }

        .source-upload-help {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin: 11px 2px 0;
            color: var(--text-muted);
            font-size: 11.75px;
            line-height: 1.45;
        }

        .source-upload-help > i {
            margin-top: 2px;
            color: var(--status-warning);
        }

        .source-advanced {
            margin-top: 12px;
            color: var(--text-muted);
            font-size: 11.75px;
        }

        .source-advanced summary {
            cursor: pointer;
            user-select: none;
        }

        .source-advanced-body {
            max-width: 760px;
            margin-top: 9px;
        }

        @@media (max-width: 980px) {
            .source-setup-grid {
                grid-template-columns: 1fr;
            }
        }

        .dbc-count-chip {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 2px 8px;
            font-size: 11.5px;
            color: var(--text-secondary);
        }

            .dbc-count-chip .count-val {
                font-weight: 600;
                color: var(--text-primary);
            }

        .comfy-node-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
        }

            .comfy-node-row .form-input {
                flex: 1;
            }

            .comfy-node-row .node-name-input {
                max-width: 160px;
            }

        .btn-xs {
            padding: 3px 10px;
            font-size: 11.5px;
        }

        .btn-remove-node {
            background: none;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text-muted);
            padding: 4px 8px;
            cursor: pointer;
            font-size: 12px;
        }

            .btn-remove-node:hover {
                color: var(--status-error);
                border-color: var(--status-error);
            }

        .node-status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
            flex-shrink: 0;
        }

        /* Unsaved edit. A background refresh leaves these fields alone rather
           than painting the running config over what you typed. */
        .cfg-input.cfg-dirty {
            border-color: var(--status-warning);
            box-shadow: inset 2px 0 0 var(--status-warning);
        }

        #comfyNodesContainer.cfg-dirty {
            border-left: 2px solid var(--status-warning);
            padding-left: 8px;
        }

        .dirty-badge {
            display: inline-block;
            min-width: 17px;
            padding: 0 5px;
            margin-left: 5px;
            border-radius: 9px;
            background: rgba(0, 0, 0, 0.28);
            font-size: 11px;
            font-weight: 700;
            line-height: 17px;
            text-align: center;
        }

        .chg-list {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            margin-top: 6px;
        }

        .chg-key {
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 1px 6px;
            font-size: 11px;
            color: var(--text-secondary);
        }

        .chg-more {
            font-size: 11px;
            color: var(--text-muted);
            align-self: center;
        }

        .restart-note {
            margin-top: 10px;
            font-size: 12.5px;
            color: var(--text-secondary);
        }

        .restart-cmd {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 5px;
        }

            .restart-cmd code {
                background: var(--bg-input);
                border: 1px solid var(--border);
                border-radius: var(--radius-sm);
                padding: 4px 9px;
                font-size: 12px;
                color: var(--text-primary);
            }

        .btn-copy-cmd {
            background: none;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text-muted);
            cursor: pointer;
        }

            .btn-copy-cmd:hover {
                color: var(--accent);
                border-color: var(--accent);
            }
    </style>
}

@section Scripts {
    <script src="~/js/settings.js" asp-append-version="true"></script>
}
