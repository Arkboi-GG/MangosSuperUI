@{
    ViewData["Title"] = "Item Assets";
}

@section Styles {
    <style>
        .wf-wrap { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
        .wf-header { padding: 20px 28px 14px; border-bottom: 1px solid var(--border-light); }
        .wf-header h1 { font-size: 20px; font-weight: 700; color: var(--text-primary); margin: 0 0 4px; }
        .wf-header-sub { font-size: 13px; color: var(--text-muted); }
        .wf-pills { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
        .wf-pill { font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 999px;
            border: 1px solid var(--border-light); color: var(--text-muted); background: var(--bg-card); }
        .wf-pill.ok { color: #14804a; border-color: #14804a55; background: #14804a14; }
        .wf-pill.bad { color: #b42318; border-color: #b4231855; background: #b4231814; }
        .wf-pill.warn { color: #b54708; border-color: #b5470855; background: #b5470814; }

        .wf-body { flex: 1; display: grid; grid-template-columns: 1fr minmax(400px, 44%);
            gap: 20px; padding: 20px 28px; overflow: hidden; }
        @@media (max-width: 1100px) { .wf-body { grid-template-columns: 1fr; overflow-y: auto; } }

        .wf-controls { overflow-y: auto; padding-right: 6px; display: flex; flex-direction: column; gap: 16px; }
        .wf-card { background: var(--bg-card); border: 1px solid var(--border-light); border-radius: 10px; padding: 16px 18px; }
        .wf-card h3 { font-size: 14px; font-weight: 700; color: var(--text-primary); margin: 0 0 3px; display: flex; align-items: center; gap: 8px; }
        /* Control cards fold to a single header line; click the header to open. */
        .wf-controls > .wf-card > h3 { cursor: pointer; user-select: none; }
        .wf-controls > .wf-card > h3::before { content: '▾'; font-size: 10px; color: var(--text-muted); flex: 0 0 12px; }
        .wf-controls > .wf-card.collapsed > h3 { margin-bottom: 0; }
        .wf-controls > .wf-card.collapsed > h3::before { content: '▸'; }
        .wf-controls > .wf-card.collapsed > :not(h3) { display: none !important; }
        .wf-card .phase { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px;
            color: var(--text-muted); border: 1px solid var(--border-light); border-radius: 4px; padding: 1px 6px; }
        .wf-card p { font-size: 12px; color: var(--text-muted); margin: 0 0 12px; line-height: 1.5; }
        .wf-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; }
        .wf-field { display: flex; flex-direction: column; gap: 4px; }
        .wf-field label { font-size: 11px; color: var(--text-muted); font-weight: 600; }
        .wf-field input[type=text], .wf-field input[type=number], .wf-field select {
            width: 150px; padding: 6px 8px; font-size: 13px; border-radius: 6px;
            border: 1px solid var(--border-light); background: var(--bg-input, var(--bg-card)); color: var(--text-primary); }
        .wf-field input[type=number] { width: 90px; }
        .wf-field select { width: auto; min-width: 120px; }
        .wf-btn { padding: 8px 14px; font-size: 13px; font-weight: 600; border-radius: 7px; cursor: pointer;
            border: 1px solid var(--accent, #2563eb); background: var(--accent, #2563eb); color: #fff; }
        .wf-btn:hover { filter: brightness(1.08); }
        .wf-btn.secondary { background: transparent; color: var(--text-primary); border-color: var(--border-light); }
        .wf-btn:disabled { opacity: .55; cursor: default; }
        .wf-file { font-size: 12px; color: var(--text-muted); }
        .wf-note { font-size: 11px; color: var(--text-muted); margin-top: 10px; padding-top: 10px; border-top: 1px dashed var(--border-light); }

        .wf-preview { display: flex; flex-direction: column; gap: 12px; min-height: 0; overflow-y: auto; padding-right: 6px; }
        .wf-preview > :not(.wf-viewer) { flex-shrink: 0; }
        .wf-viewer { flex: 1; min-height: 420px; border: 1px solid var(--border-light); border-radius: 10px;
            overflow: hidden; background: linear-gradient(180deg, #1a1d24, #0f1115); position: relative; }
        .wf-viewer.expanded { position: fixed; inset: 20px; z-index: 60; min-height: 0; border-radius: 12px;
            box-shadow: 0 20px 60px #000a; }
        .wf-viewer canvas { display: block; width: 100%; height: 100%; }
        .wf-viewer .hint { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
            color: #8a93a6; font-size: 13px; pointer-events: none; }
        .wf-cameras { position:absolute; z-index:2; top:8px; right:8px; display:flex; gap:5px; }
        .wf-cameras button { border:1px solid #ffffff33; background:#111722cc; color:#dce2ee; border-radius:5px;
            padding:4px 7px; font-size:10px; cursor:pointer; }
        .wf-result { max-height: 34%; overflow-y: auto; border: 1px solid var(--border-light); border-radius: 10px;
            padding: 12px 14px; background: var(--bg-card); font-size: 12px; }
        .wf-result .title { font-weight: 700; color: var(--text-primary); margin-bottom: 6px; }
        .wf-kv { display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; color: var(--text-muted); }
        .wf-kv b { color: var(--text-primary); font-weight: 600; }
        .wf-diag { margin-top: 8px; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 11px; line-height: 1.5; color: var(--text-muted); }
        .wf-diag .err { color: #d9534f; }
        .wf-diag .warn { color: #d98800; }
        .wf-dl { display: inline-block; margin-top: 8px; margin-right: 14px; font-size: 13px; font-weight: 600; color: var(--accent, #2563eb); }

        /* Triangle-budget slider */
        .wf-slider { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 260px; }
        .wf-slider input[type=range] { flex: 1; }
        .wf-slider .val { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 12px;
            color: var(--text-primary); min-width: 88px; text-align: right; }

        /* TBC browse modal */
        .wf-modal-backdrop { position: fixed; inset: 0; z-index: 70; background: #000a; display: none; }
        .wf-modal-backdrop.open { display: flex; align-items: center; justify-content: center; }
        .wf-modal { width: min(720px, 92vw); max-height: 84vh; display: flex; flex-direction: column;
            background: var(--bg-card); border: 1px solid var(--border-light); border-radius: 12px;
            box-shadow: 0 20px 60px #000c; padding: 16px 18px; }
        .wf-modal h3 { font-size: 14px; font-weight: 700; color: var(--text-primary); margin: 0 0 10px;
            display: flex; align-items: center; justify-content: space-between; }
        .wf-modal .wf-close { border: none; background: none; color: var(--text-muted); font-size: 16px; cursor: pointer; }
        .wf-modal-list { flex: 1; overflow-y: auto; border: 1px solid var(--border-light); border-radius: 8px; margin-top: 10px; }
        .wf-modal-list table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .wf-modal-list th { position: sticky; top: 0; background: var(--bg-card); text-align: left;
            color: var(--text-muted); font-weight: 600; font-size: 11px; padding: 6px 10px;
            border-bottom: 1px solid var(--border-light); }
        .wf-modal-list td { padding: 5px 10px; color: var(--text-primary); border-bottom: 1px dashed var(--border-light); cursor: pointer; }
        .wf-modal-list tr:hover td { background: #ffffff0d; }
        .wf-modal-list td.muted { color: var(--text-muted); }
        .wf-modal-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 10px;
            font-size: 12px; color: var(--text-muted); }

        /* Forged Weapons registry list */
        .wf-weapons table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .wf-weapons th { text-align: left; color: var(--text-muted); font-weight: 600; font-size: 11px;
            padding: 4px 8px 4px 0; border-bottom: 1px solid var(--border-light); }
        .wf-weapons td { padding: 5px 8px 5px 0; color: var(--text-primary); border-bottom: 1px dashed var(--border-light); }
        .wf-weapons td.muted { color: var(--text-muted); }
        .wf-weapons .wf-del { padding: 3px 9px; font-size: 11.5px; font-weight: 600; border-radius: 6px; cursor: pointer;
            border: 1px solid #b4231855; background: #b4231814; color: #b42318; }
        .wf-weapons .wf-del:hover { background: #b4231828; }
        .wf-weapons .empty { color: var(--text-muted); font-size: 12px; }
    </style>
}

<div class="app-shell">
    <partial name="_Sidebar" />

    <div class="main-content">
<div class="wf-wrap">
    <div class="wf-header">
        <h1><i class="fa-solid fa-hammer"></i> Item Assets — Weapon Forge</h1>
        <div class="wf-header-sub">
            The import station: bring a <strong>finished GLB</strong> (UVs + texture authored elsewhere), decimate it
            to a game budget, and forge it into the game. Forging inserts the item into the world database, reloads
            <code>item_template</code>, and deploys <code>patch-5.MPQ</code> to the client Data folder. Restart the
            client, then <code>.additem</code> the new entry. All build files are also kept in the artifact folder.
        </div>
        <div class="wf-pills" id="wfPills">
            <span class="wf-pill" id="pillFixture">fixture …</span>
            <span class="wf-pill" id="pillDonor">donor …</span>
            <span class="wf-pill" id="pillContract">contract …</span>
        </div>
    </div>

    <div class="wf-body">
        <div class="wf-controls">

            <div class="wf-card">
                <h3><span class="phase">Import</span> Pre-textured GLB → Game item</h3>
                <p>Accepts any triangle count — a ZBrush export, a TRELLIS reconstruction, anything with
                   <strong>UV0 and an embedded texture</strong> already authored. The slider decimates it with a
                   UV-preserving edge collapse (seams locked, the texture never smears), so what you preview is
                   byte-for-byte what forges. Vanilla weapons are ~100–250 triangles; the M2 hard ceiling is 1000.</p>
                <div class="wf-row">
                    <div class="wf-field" style="flex:1;min-width:220px;">
                        <label>Finished GLB (.glb, UVs + texture)</label>
                        <input type="file" id="glbFile" accept=".glb" class="wf-file">
                    </div>
                    <div class="wf-field" title="Drives the gameplay row (subclass/inventory/sheath/delay), the donor scaffold the M2 is built on (bones, attachments, sounds, icon), and where the grip lands — a staff grips mid-shaft, an axe low on the haft">
                        <label>Weapon type</label>
                        <select id="impType"><option value="sword1h" selected>1H Sword</option></select>
                    </div>
                    <div class="wf-field"><label>Name (optional)</label>
                        <input type="text" id="glbName" placeholder="Imported Blade"></div>
                </div>
                <div class="wf-row" style="margin-top:10px;">
                    <div class="wf-field" title="Tilt about the blade axis, applied after auto-orientation — fix a wrongly-rolled import (±90 stands a flat blade up)">
                        <label>Extra roll °</label>
                        <input type="number" id="impRoll" value="0" min="-180" max="180" step="15"></div>
                    <label style="font-size:11px;color:var(--text-muted);padding-bottom:7px;" title="Rotate 180° so the grip and tip swap ends"><input type="checkbox" id="impFlip"> flip grip/tip</label>
                    <label style="font-size:11px;color:var(--text-muted);padding-bottom:7px;" title="Straighten the blade centerline (off by default — don't bend a finished model unless it needs it)"><input type="checkbox" id="impStraighten"> straighten centerline</label>
                    <label style="font-size:11px;color:var(--text-muted);padding-bottom:7px;" title="Show where the hands land: green band = main-hand palm (model origin, exact); blue band ≈ off-hand zone on two-handers (animation-placed, approximate)"><input type="checkbox" id="impShowGrip" checked> grip markers</label>
                </div>
                <div class="wf-row" style="margin-top:10px;">
                    <div class="wf-field wf-slider" style="min-width:240px;" title="Lens cross-section: pushes depth out at the centreline, tapering to nothing at the edges — gives a paper-flat blade a diamond profile without touching its silhouette">
                        <label style="min-width:96px;">Centre thickness</label>
                        <input type="range" id="impProfile" min="0" max="100" step="5" value="0">
                        <span class="val" id="impProfileVal">off</span>
                    </div>
                    <div class="wf-field wf-slider" style="min-width:240px;" title="Multiplies the embedded texture's brightness: +100 ≈ double, −100 ≈ half; blacks stay black">
                        <label style="min-width:96px;">Brightness</label>
                        <input type="range" id="impBright" min="-100" max="100" step="5" value="0">
                        <span class="val" id="impBrightVal">0</span>
                    </div>
                    <div class="wf-field wf-slider" style="min-width:240px;" title="Saturation: +100 vivid, −100 grayscale — lift a muted texture with brightness and saturation together">
                        <label style="min-width:96px;">Saturation</label>
                        <input type="range" id="impSat" min="-100" max="100" step="5" value="0">
                        <span class="val" id="impSatVal">0</span>
                    </div>
                </div>
                <div class="wf-row" style="margin-top:10px;">
                    <div class="wf-field wf-slider" title="Target triangle budget — the decimator collapses down to this before preview/forge">
                        <label style="min-width:96px;">Target triangles</label>
                        <input type="range" id="impTarget" min="100" max="1000" step="25" value="500">
                        <span class="val" id="impTargetVal">500 tris</span>
                    </div>
                    <button class="wf-btn secondary" data-action="uploadGlb">Preview mesh</button>
                    <button class="wf-btn" data-action="forgeGlb">Forge item</button>
                </div>
                <div class="wf-note">
                    Requirements: single mesh, <code>TEXCOORD_0</code>, normals, embedded texture. After the first
                    preview, moving the slider re-previews automatically at the new budget. Vanilla look ≈ 100–250 tris;
                    500 is a comfortable default; the forge refuses anything still above 1000.
                </div>
            </div>

            <div class="wf-card">
                <h3><span class="phase">TBC</span> Import from TBC client</h3>
                <p>Browse the weapon models of a <strong>TBC (2.4.3) client</strong> and forge them into vanilla
                   items. The TBC mesh and texture pass through the same pipeline as a GLB import: the geometry is
                   re-emitted as a native vanilla M2 on the selected family's donor scaffold (TBC files are v260+,
                   which the 1.12 client refuses as-is), and the TBC texture is decoded and re-encoded as a vanilla
                   BLP. Set the <strong>TBC Client Data Path</strong> on the <a href="/Settings">Settings page</a>.</p>
                <div id="tbcState" style="font-size:12px;color:var(--text-muted);margin-bottom:10px;">Checking TBC mount…</div>
                <div class="wf-row">
                    <button class="wf-btn secondary" data-action="tbcBrowse" id="tbcBrowseBtn" disabled>
                        <i class="fa-solid fa-magnifying-glass"></i> Browse TBC weapons…</button>
                    <div class="wf-field" style="flex:1;min-width:200px;"><label>Selected model</label>
                        <input type="text" id="tbcSelected" readonly placeholder="nothing selected" style="width:100%;"></div>
                    <div class="wf-field" title="Drives the vanilla gameplay row and the donor scaffold — pick what this weapon should BE in vanilla">
                        <label>Weapon type</label>
                        <select id="tbcType"><option value="sword1h" selected>1H Sword</option></select>
                    </div>
                    <div class="wf-field"><label>Name (optional)</label>
                        <input type="text" id="tbcName" placeholder="auto from model"></div>
                </div>
                <div class="wf-row" style="margin-top:10px;">
                    <div class="wf-field wf-slider" title="'keep' preserves the TBC triangle count (still decimates anything above the 1000 M2 ceiling); set a value to decimate to budget">
                        <label style="min-width:96px;">Target triangles</label>
                        <input type="range" id="tbcTarget" min="0" max="1000" step="25" value="0">
                        <span class="val" id="tbcTargetVal">keep</span>
                    </div>
                    <button class="wf-btn secondary" data-action="tbcPreview" id="tbcPreviewBtn" disabled>Preview</button>
                    <button class="wf-btn" data-action="tbcForge" id="tbcForgeBtn" disabled>Forge item</button>
                </div>
                <div class="wf-note">
                    The forged item gets the chosen family's stats/sheath/sounds; enchant-glow attachment points come
                    from the vanilla donor scaffold, not the TBC model. Multi-texture TBC models keep their base texture.
                </div>
            </div>

            <div class="wf-card">
                <h3><span class="phase">Registry</span> Forged Weapons</h3>
                <p>The weapons currently in the registry — the exact contents of <code>patch-5.MPQ</code>.
                   <strong>View</strong> renders a weapon's stored M2+BLP in the viewer. <strong>Delete</strong>
                   removes it from the game: world-database row, packaged patch, and registry entry; its IDs return
                   to the pool. All forge and delete actions are recorded in the Activity Log.</p>
                <div id="wfWeapons" class="wf-weapons"><span style="color:var(--text-muted);font-size:12px;">Loading…</span></div>
                <div class="wf-row" style="margin-top:10px;">
                    <button class="wf-btn secondary" data-action="rebuildPatch">Rebuild patch</button>
                    <a class="wf-btn secondary" href="/WeaponForge/DownloadPatch" style="text-decoration:none;">
                        <i class="fa-solid fa-download"></i> Download current patch-5.MPQ</a>
                </div>
            </div>

        </div>

        <div class="wf-preview">
            <div class="wf-viewer" id="wfViewer"><div class="hint" id="wfHint">Preview a model to inspect it here</div>
                <div class="wf-cameras"><button data-camera="three">3/4</button><button data-camera="front">front</button><button data-camera="edge">edge</button><button id="wfExpand" title="Expand viewer">⤢ expand</button></div></div>
            <div class="wf-result" id="wfResult">
                <div class="title">Ready</div>
                <div style="color:var(--text-muted);">Results, IDs, downloads, and diagnostics appear here.</div>
            </div>
        </div>
    </div>
</div>
    </div>
</div>

<div class="wf-modal-backdrop" id="tbcModal">
    <div class="wf-modal">
        <h3>Browse TBC weapons
            <button class="wf-close" id="tbcModalClose" title="Close">✕</button></h3>
        <div class="wf-row">
            <div class="wf-field" style="flex:1;">
                <input type="text" id="tbcSearch" placeholder="Search by item name, model, or item ID (e.g. Gorehowl, sword_2h, arcanite)…" style="width:100%;">
            </div>
        </div>
        <div class="wf-modal-list" id="tbcList"><div style="padding:14px;color:var(--text-muted);font-size:12px;">Loading…</div></div>
        <div class="wf-modal-foot">
            <span id="tbcPageInfo">—</span>
            <span>
                <button class="wf-btn secondary" id="tbcPrev" style="padding:4px 10px;font-size:12px;">‹ Prev</button>
                <button class="wf-btn secondary" id="tbcNext" style="padding:4px 10px;font-size:12px;">Next ›</button>
            </span>
        </div>
    </div>
</div>

@section Scripts {
    <script type="importmap">
        {
          "imports": {
            "three": "/lib/three/build/three.module.js",
            "three/addons/": "/lib/three/examples/jsm/"
          }
        }
    </script>
    <script type="module">
        import * as THREE from 'three';
        import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
        import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

        // ---------- 3D viewer ----------
        const host = document.getElementById('wfViewer');
        const hint = document.getElementById('wfHint');
        let renderer, scene, camera, controls, current = null;

        function initViewer() {
            const w = host.clientWidth, h = host.clientHeight;
            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setPixelRatio(window.devicePixelRatio || 1);
            renderer.setSize(w, h);
            host.appendChild(renderer.domElement);

            scene = new THREE.Scene();
            camera = new THREE.PerspectiveCamera(45, w / h, 0.01, 100);
            camera.position.set(1.4, 0.9, 1.4);

            controls = new OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;

            scene.add(new THREE.HemisphereLight(0xffffff, 0x30343c, 1.1));
            const dir = new THREE.DirectionalLight(0xffffff, 1.4);
            dir.position.set(2, 3, 2); scene.add(dir);
            const grid = new THREE.GridHelper(2, 20, 0x3a4150, 0x262b33);
            grid.position.y = -0.001; scene.add(grid);

            window.addEventListener('resize', onResize);
            animate();
        }
        function onResize() {
            if (!renderer) return;
            const w = host.clientWidth, h = host.clientHeight;
            renderer.setSize(w, h); camera.aspect = w / h; camera.updateProjectionMatrix();
        }
        function animate() { requestAnimationFrame(animate); controls && controls.update(); renderer && renderer.render(scene, camera); }

        const loader = new GLTFLoader();
        function loadGlb(url) {
            if (!url) return;
            hint.style.display = 'none';
            loader.load(url + '?t=' + Date.now(), (gltf) => {
                if (current) { scene.remove(current); }
                const model = gltf.scene;
                // Re-material for readable, lit previews (in-game weapons are unlit; this reveals form).
                model.traverse((o) => {
                    if (o.isMesh) {
                        const map = o.material && o.material.map ? o.material.map : null;
                        // alphaTest 0.5 mirrors the in-game alpha-key pass for cutout blades;
                        // harmless for opaque textures (their alpha is 1 everywhere).
                        o.material = new THREE.MeshStandardMaterial({
                            map: map, color: map ? 0xffffff : 0xb8bec9, metalness: 0.15, roughness: 0.65,
                            flatShading: true, side: THREE.DoubleSide, alphaTest: map ? 0.5 : 0 });
                    }
                });
                current = model; scene.add(model);
                frameObject(model);
                drawGripMarkers();
            }, undefined, (err) => setResult({ title: 'Preview failed', error: String(err) }));
        }

        // ---------- grip markers ----------
        // The weapon mounts to the character's hand bone AT ITS ORIGIN, so the green band at x=0 is
        // exactly where the palm wraps. The blue band (two-handers) marks the approximate off-hand
        // zone — the character animation places that hand, not the weapon file.
        let lastGrip = null, gripGroup = null;
        function drawGripMarkers() {
            if (gripGroup) { scene.remove(gripGroup); gripGroup = null; }
            const on = document.getElementById('impShowGrip').checked;
            if (!on || !lastGrip || !current) return;
            gripGroup = new THREE.Group();
            addGripBand(0, lastGrip.palm.radius, 0x38e06c);
            if (lastGrip.secondHand) addGripBand(lastGrip.secondHand.x, lastGrip.secondHand.radius, 0x38b6ff);
            scene.add(gripGroup);
        }
        function addGripBand(x, r, color) {
            const R = Math.max((r || 0) * 1.3, 0.028);
            const mat = new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0.9, depthTest: false });
            const band = new THREE.Mesh(new THREE.TorusGeometry(R, Math.max(R * 0.10, 0.006), 12, 48), mat);
            band.rotation.y = Math.PI / 2;   // torus axis → +X so the band wraps the shaft
            band.position.set(x, 0, 0);
            band.renderOrder = 2;
            gripGroup.add(band);
            // A short axis tick through the band makes the station readable edge-on.
            const tick = new THREE.Mesh(new THREE.CylinderGeometry(R * 0.045, R * 0.045, R * 2.6, 8), mat);
            tick.position.set(x, 0, 0);
            tick.renderOrder = 2;
            gripGroup.add(tick);
        }
        document.getElementById('impShowGrip').addEventListener('change', drawGripMarkers);
        function frameObject(obj) {
            const box = new THREE.Box3().setFromObject(obj);
            const size = box.getSize(new THREE.Vector3());
            const center = box.getCenter(new THREE.Vector3());
            const maxDim = Math.max(size.x, size.y, size.z) || 1;
            controls.target.copy(center);
            camera.position.copy(center).add(new THREE.Vector3(maxDim * 1.6, maxDim * 1.1, maxDim * 1.6));
            camera.near = maxDim / 100; camera.far = maxDim * 100; camera.updateProjectionMatrix();
            controls.update();
        }
        function setDiagnosticCamera(kind) {
            if (!current) return; const box = new THREE.Box3().setFromObject(current), size=box.getSize(new THREE.Vector3()), center=box.getCenter(new THREE.Vector3());
            const d=Math.max(size.x,size.y,size.z)*1.7; controls.target.copy(center);
            const offset = kind==='front' ? new THREE.Vector3(0,0,d) : (kind==='edge' ? new THREE.Vector3(0,d,0) : new THREE.Vector3(d*.8,d*.55,d*.8));
            camera.position.copy(center).add(offset); camera.up.set(0,1,0); camera.lookAt(center); controls.update();
        }
        document.querySelectorAll('[data-camera]').forEach(b => b.addEventListener('click', () => setDiagnosticCamera(b.dataset.camera)));
        document.getElementById('wfExpand').addEventListener('click', () => {
            const v = document.getElementById('wfViewer');
            const on = v.classList.toggle('expanded');
            document.getElementById('wfExpand').textContent = on ? '⤢ close' : '⤢ expand';
            requestAnimationFrame(() => { onResize(); if (current) frameObject(current); });
        });
        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                const v = document.getElementById('wfViewer');
                if (v.classList.contains('expanded')) { v.classList.remove('expanded'); document.getElementById('wfExpand').textContent = '⤢ expand'; requestAnimationFrame(() => { onResize(); if (current) frameObject(current); }); }
            }
        });

        // ---------- helpers ----------
        function esc(s) { return String(s).replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c])); }
        function setResult({ title, kv, diagnostics, downloads, note, error }) {
            const r = document.getElementById('wfResult');
            let html = `<div class="title">${esc(title || 'Result')}</div>`;
            if (error) html += `<div class="wf-diag err">${esc(error)}</div>`;
            if (kv) {
                html += '<div class="wf-kv">';
                for (const [k, v] of Object.entries(kv)) html += `<span>${esc(k)}</span><b>${esc(v)}</b>`;
                html += '</div>';
            }
            if (downloads && downloads.length) {
                html += '<div>';
                for (const d of downloads)
                    html += `<a class="wf-dl" href="${d.url}"><i class="fa-solid fa-download"></i> ${esc(d.label)}</a>`;
                html += '</div>';
            }
            if (diagnostics && diagnostics.length) {
                html += '<div class="wf-diag">';
                for (const d of diagnostics) {
                    const cls = d.includes('[Error]') ? 'err' : (d.includes('[Warning]') ? 'warn' : '');
                    html += `<div class="${cls}">${esc(d)}</div>`;
                }
                html += '</div>';
            }
            if (note) html += `<div class="wf-note">${esc(note)}</div>`;
            r.innerHTML = html;
        }
        function busy(btn, on) { btn.disabled = on; btn.dataset._t = btn.dataset._t || btn.textContent; btn.textContent = on ? 'Working…' : btn.dataset._t; }
        function previewUrl(data) { return (data.preview && data.preview.glbWebPath) || data.previewGlbWebPath || null; }
        function applyLine(ok, label, msg) { return `${ok ? '✓' : '✗'} ${label}: ${msg}`; }
        function forgeResult(d, titleOk) {
            if (!d.ok) return setResult({ title: 'Forge failed', error: d.error || d.message, diagnostics: d.diagnostics });
            const a = d.apply || {};
            const allApplied = a.sqlApplied && a.reloaded && a.patchDeployed;
            lastGrip = d.grip || null;
            setResult({
                title: titleOk + (allApplied ? ' & applied to server' : ' — some apply steps need attention'),
                kv: {
                    'Item entry': d.itemEntry, 'Display id': d.displayId,
                    'Type': d.weaponTypeLabel || d.weaponType || '1H Sword', 'Model': d.modelMember,
                    'Weapons in patch': d.packagedWeaponCount + (d.skippedWeaponCount ? ` (${d.skippedWeaponCount} skipped)` : ''),
                    'Verified': d.allMembersVerified ? 'yes' : 'NO', 'Triangles': d.triangleCount,
                },
                downloads: [
                    { label: 'patch-5.MPQ', url: d.mpqDownloadUrl },
                    { label: 'item_template.sql', url: d.sqlDownloadUrl },
                ],
                diagnostics: [
                    applyLine(a.sqlApplied, 'World DB', a.sqlMessage || ''),
                    applyLine(a.reloaded, 'Reload', a.reloadMessage || ''),
                    applyLine(a.patchDeployed, 'Patch deploy', a.patchDeployMessage || ''),
                    ...(d.diagnostics || []),
                ],
                note: allApplied
                    ? `Live on the server. Restart the client(s), then .additem ${d.itemEntry}.`
                    : 'One or more steps require manual action — see the lines above; the downloads contain the files. Then restart the client and .additem.'
            });
            loadGlb(previewUrl(d));
            loadWeapons();
        }

        // ---------- import actions ----------
        const targetEl = document.getElementById('impTarget');
        const targetVal = document.getElementById('impTargetVal');
        let previewedOnce = false, sliderTimer = null;
        function targetTris() { return +targetEl.value; }
        function importParams(fd) {
            fd.append('weaponType', document.getElementById('impType').value || 'sword1h');
            fd.append('targetTriangles', targetTris());
            fd.append('rollDegrees', +document.getElementById('impRoll').value || 0);
            fd.append('flipGripEnd', document.getElementById('impFlip').checked);
            fd.append('straightenBlade', document.getElementById('impStraighten').checked);
            fd.append('bladeProfile', +document.getElementById('impProfile').value || 0);
            fd.append('brightness', +document.getElementById('impBright').value || 0);
            fd.append('saturation', +document.getElementById('impSat').value || 0);
        }
        function schedulePreviewIfLive() {
            // After the first preview, orientation/budget changes re-preview automatically.
            if (!previewedOnce || !document.getElementById('glbFile').files[0]) return;
            clearTimeout(sliderTimer);
            sliderTimer = setTimeout(() => actions.uploadGlb(null), 500);
        }
        targetEl.addEventListener('input', () => {
            targetVal.textContent = targetTris() + ' tris';
            schedulePreviewIfLive();
        });
        document.getElementById('impRoll').addEventListener('input', schedulePreviewIfLive);
        document.getElementById('impFlip').addEventListener('change', schedulePreviewIfLive);
        document.getElementById('impStraighten').addEventListener('change', schedulePreviewIfLive);
        document.getElementById('impType').addEventListener('change', schedulePreviewIfLive);
        function bindGrade(id, valId, fmt) {
            const el = document.getElementById(id), lab = document.getElementById(valId);
            el.addEventListener('input', () => { lab.textContent = fmt(+el.value); schedulePreviewIfLive(); });
        }
        bindGrade('impProfile', 'impProfileVal', v => v === 0 ? 'off' : v + '%');
        bindGrade('impBright', 'impBrightVal', v => (v > 0 ? '+' : '') + v);
        bindGrade('impSat', 'impSatVal', v => (v > 0 ? '+' : '') + v);

        const actions = {
            async uploadGlb(btn) {
                const f = document.getElementById('glbFile').files[0];
                if (!f) return setResult({ title: 'No file', error: 'Choose a .glb first.' });
                const fd = new FormData();
                fd.append('file', f);
                importParams(fd);
                const d = await (await fetch('/WeaponForge/UploadGlb', { method: 'POST', body: fd })).json();
                lastGrip = d.grip || null;
                setResult({
                    title: d.ok ? 'Imported & decimated (preview only)' : 'Import finished with issues',
                    kv: {
                        'Type': d.weaponTypeLabel || d.weaponType || '1H Sword',
                        'Source triangles': (d.originalTriangleCount ?? 0).toLocaleString(),
                        'After decimation': (d.triangleCount ?? 0).toLocaleString() + (d.withinForgeBudget === false ? '  — OVER the 1000 forge ceiling' : ''),
                        'Vertices': (d.vertexCount ?? 0).toLocaleString(),
                        'Texture': d.hasTexture ? 'embedded ✓' : 'MISSING',
                        'Source sha': (d.sourceSha256 || '').slice(0, 12),
                    },
                    diagnostics: [...(d.decimation ? [d.decimation] : []), ...(d.diagnostics || [])],
                    note: [d.grip && d.grip.note, d.note].filter(Boolean).join(' '), error: d.error,
                });
                previewedOnce = true;
                loadGlb(previewUrl(d));
            },
            async forgeGlb(btn) {
                const f = document.getElementById('glbFile').files[0];
                if (!f) return setResult({ title: 'No file', error: 'Choose a .glb first.' });
                const fd = new FormData();
                fd.append('file', f);
                importParams(fd);
                const name = document.getElementById('glbName').value.trim();
                if (name) fd.append('name', name);
                const d = await (await fetch('/WeaponForge/ForgeGlb', { method: 'POST', body: fd })).json();
                forgeResult(d, 'GLB forged');
            },
            async tbcBrowse(btn) {
                document.getElementById('tbcModal').classList.add('open');
                document.getElementById('tbcSearch').focus();
                await loadTbcPage(1);
            },
            async tbcPreview(btn) {
                if (!tbcSel) return setResult({ title: 'No TBC weapon selected', error: 'Browse and pick one first.' });
                const q = new URLSearchParams({
                    entry: tbcSel.entry, model: tbcSel.model, displayRow: tbcSel.displayRow,
                    weaponType: document.getElementById('tbcType').value || 'sword1h',
                    targetTriangles: tbcTargetTris(),
                });
                const d = await (await fetch('/WeaponForge/TbcPreviewWeapon?' + q)).json();
                lastGrip = d.grip || null;
                setResult({
                    title: d.ok ? `TBC preview — ${d.itemName || tbcSel.name}` : 'TBC preview failed',
                    kv: d.ok ? {
                        'Type': d.weaponTypeLabel || '1H Sword',
                        'Model': d.model,
                        'Triangles': (d.triangleCount ?? 0).toLocaleString(),
                        'Vertices': (d.vertexCount ?? 0).toLocaleString(),
                        'Texture': d.hasTexture ? d.texture : 'MISSING — donor texture will be used',
                    } : undefined,
                    diagnostics: d.diagnostics, note: d.grip && d.grip.note, error: d.error,
                });
                loadGlb(previewUrl(d));
            },
            async tbcForge(btn) {
                if (!tbcSel) return setResult({ title: 'No TBC weapon selected', error: 'Browse and pick one first.' });
                const fd = new FormData();
                fd.append('entry', tbcSel.entry);
                fd.append('model', tbcSel.model);
                fd.append('displayRow', tbcSel.displayRow);
                fd.append('weaponType', document.getElementById('tbcType').value || 'sword1h');
                fd.append('targetTriangles', tbcTargetTris());
                const name = document.getElementById('tbcName').value.trim();
                if (name) fd.append('name', name);
                const d = await (await fetch('/WeaponForge/ForgeTbc', { method: 'POST', body: fd })).json();
                forgeResult(d, 'TBC weapon forged');
            },
            async rebuildPatch(btn) {
                const d = await (await fetch('/WeaponForge/RebuildPatch', { method: 'POST' })).json();
                if (!d.ok) return setResult({ title: 'Rebuild failed', error: d.error });
                setResult({
                    title: 'Patch repackaged',
                    kv: { 'Weapons': d.weaponCount, 'Patch': d.patchRemoved ? 'removed (no weapons in registry)' : 'rebuilt' },
                    downloads: d.patchDownloadUrl ? [{ label: 'patch-5.MPQ', url: d.patchDownloadUrl }] : [],
                    diagnostics: [applyLine(d.patchDeployed || d.patchRemoved, 'Deploy', d.patchDeployMessage || ''), ...(d.diagnostics || [])]
                });
                loadWeapons();
            },
        };
        document.querySelectorAll('[data-action]').forEach(btn => {
            btn.addEventListener('click', async () => {
                busy(btn, true);
                try { await actions[btn.dataset.action](btn); }
                catch (e) { setResult({ title: 'Request failed', error: String(e) }); }
                finally { busy(btn, false); }
            });
        });

        // ---------- TBC import ----------
        let tbcSel = null, tbcPage = 1, tbcSearchTimer = null;
        function tbcTargetTris() { return +document.getElementById('tbcTarget').value || 0; }
        const tbcTargetEl = document.getElementById('tbcTarget');
        tbcTargetEl.addEventListener('input', () => {
            document.getElementById('tbcTargetVal').textContent = tbcTargetTris() === 0 ? 'keep' : tbcTargetTris() + ' tris';
            if (tbcSel) { clearTimeout(sliderTimer); sliderTimer = setTimeout(() => actions.tbcPreview(null), 500); }
        });
        document.getElementById('tbcType').addEventListener('change', () => { if (tbcSel) actions.tbcPreview(null); });

        async function loadTbcStatus() {
            const el = document.getElementById('tbcState');
            try {
                const s = await (await fetch('/WeaponForge/TbcStatus')).json();
                if (!s.configured) {
                    el.innerHTML = 'No TBC Data path configured — set <b>TBC Client Data Path</b> on the Settings page.';
                    return;
                }
                if (s.error) { el.innerHTML = `<span style="color:#b42318;">TBC mount problem: ${esc(s.error)}</span>`; return; }
                el.innerHTML = `Mounted <b>${s.archiveCount}</b> archive(s) from <code>${esc(s.path)}</code> — ` +
                               (s.itemCount > 0
                                   ? `<b>${s.itemCount.toLocaleString()}</b> named TBC weapons browsable ` +
                                     `(${s.weaponCount.toLocaleString()} models).`
                                   : `<b>${s.weaponCount.toLocaleString()}</b> weapon models browsable (no item-name catalog).`);
                const enable = s.weaponCount > 0;
                for (const id of ['tbcBrowseBtn']) document.getElementById(id).disabled = !enable;
            } catch (e) { el.textContent = 'TBC status unavailable: ' + e; }
        }

        // WoW quality colors (0 poor … 5 legendary).
        const QUALITY_COLORS = ['#9d9d9d', '#e6e8ea', '#1eff00', '#0070dd', '#a335ee', '#ff8000', '#e6cc80'];

        async function loadTbcPage(page) {
            tbcPage = page;
            const list = document.getElementById('tbcList');
            list.innerHTML = '<div style="padding:14px;color:var(--text-muted);font-size:12px;">Loading…</div>';
            const q = new URLSearchParams({ page, search: document.getElementById('tbcSearch').value.trim() });
            try {
                const d = await (await fetch('/WeaponForge/TbcWeapons?' + q)).json();
                if (!d.ok) { list.innerHTML = `<div style="padding:14px;font-size:12px;color:#b42318;">${esc(d.error || 'failed')}</div>`; return; }
                if (!d.weapons.length) { list.innerHTML = '<div style="padding:14px;color:var(--text-muted);font-size:12px;">No matches.</div>'; }
                else {
                    const itemMode = d.mode === 'items';
                    let html = itemMode
                        ? '<table><tr><th>Name</th><th>ilvl</th><th>Type</th><th>Model</th><th>ID</th></tr>'
                        : '<table><tr><th>Model</th><th>Texture</th><th>Row</th></tr>';
                    for (const w of d.weapons) {
                        const attrs = `data-entry="${w.entry || 0}" data-model="${esc(w.model)}" data-row="${w.displayRow}"` +
                                      ` data-type="${esc(w.typeKey || '')}" data-name="${esc(w.name)}"`;
                        if (itemMode) {
                            const col = QUALITY_COLORS[w.quality] || QUALITY_COLORS[1];
                            html += `<tr ${attrs}><td style="color:${col};font-weight:600;">${esc(w.name)}</td>` +
                                    `<td class="muted">${w.itemLevel || '—'}</td><td class="muted">${esc(w.typeLabel || '—')}</td>` +
                                    `<td class="muted">${esc(w.model)}</td><td class="muted">${w.entry}</td></tr>`;
                        } else {
                            html += `<tr ${attrs}><td>${esc(w.model)}</td><td class="muted">${esc(w.texture)}</td>` +
                                    `<td class="muted">${w.displayRow}</td></tr>`;
                        }
                    }
                    list.innerHTML = html + '</table>';
                    list.querySelectorAll('tr[data-model]').forEach(tr => tr.addEventListener('click', () => selectTbc(tr)));
                }
                document.getElementById('tbcPageInfo').textContent =
                    `${d.total.toLocaleString()} weapon(s) — page ${d.page}/${d.pages}`;
                document.getElementById('tbcPrev').disabled = d.page <= 1;
                document.getElementById('tbcNext').disabled = d.page >= d.pages;
                tbcPage = d.page;
            } catch (e) { list.innerHTML = `<div style="padding:14px;font-size:12px;color:#b42318;">${esc(String(e))}</div>`; }
        }

        function selectTbc(tr) {
            tbcSel = {
                entry: +tr.dataset.entry || 0,
                model: tr.dataset.model,
                displayRow: +tr.dataset.row,
                name: tr.dataset.name || tr.dataset.model,
                typeKey: tr.dataset.type || '',
            };
            document.getElementById('tbcSelected').value =
                tbcSel.entry ? `${tbcSel.name} (item ${tbcSel.entry})` : `${tbcSel.model} (row ${tbcSel.displayRow})`;
            // Pre-select the family from the TBC subclass; the name field defaults to the item name.
            const typeSel = document.getElementById('tbcType');
            if (tbcSel.typeKey && [...typeSel.options].some(o => o.value === tbcSel.typeKey && !o.disabled))
                typeSel.value = tbcSel.typeKey;
            document.getElementById('tbcName').placeholder = tbcSel.name;
            document.getElementById('tbcPreviewBtn').disabled = false;
            document.getElementById('tbcForgeBtn').disabled = false;
            document.getElementById('tbcModal').classList.remove('open');
            actions.tbcPreview(null);
        }

        document.getElementById('tbcModalClose').addEventListener('click', () => document.getElementById('tbcModal').classList.remove('open'));
        document.getElementById('tbcModal').addEventListener('click', (e) => { if (e.target === e.currentTarget) e.currentTarget.classList.remove('open'); });
        document.getElementById('tbcPrev').addEventListener('click', () => loadTbcPage(tbcPage - 1));
        document.getElementById('tbcNext').addEventListener('click', () => loadTbcPage(tbcPage + 1));
        document.getElementById('tbcSearch').addEventListener('input', () => {
            clearTimeout(tbcSearchTimer);
            tbcSearchTimer = setTimeout(() => loadTbcPage(1), 350);
        });

        // ---------- forged weapons registry ----------
        async function loadWeapons() {
            const host = document.getElementById('wfWeapons');
            try {
                const d = await (await fetch('/WeaponForge/ListWeapons')).json();
                if (!d.ok) { host.innerHTML = `<span class="empty">Could not load: ${esc(d.error || 'unknown')}</span>`; return; }
                if (!d.weapons.length) { host.innerHTML = '<span class="empty">Nothing forged yet.</span>'; return; }
                let html = '<table><tr><th>Name</th><th>Type</th><th>Entry</th><th>Display</th><th>Source</th><th>Created</th><th></th></tr>';
                for (const w of d.weapons) {
                    html += `<tr><td>${esc(w.name)}</td><td class="muted">${esc(w.weaponTypeLabel || '—')}</td>` +
                            `<td class="muted">${w.itemEntry || '—'}</td>` +
                            `<td class="muted">${w.displayId}</td><td class="muted">${esc(w.sourceKind)}</td>` +
                            `<td class="muted">${esc(w.createdAt)}</td>` +
                            `<td style="white-space:nowrap;"><button class="wf-del" data-view="${w.displayId}" data-name="${esc(w.name)}" style="background:var(--bg-input,#1c2029);color:var(--text-primary);border-color:var(--border-color);margin-right:5px;">View</button>` +
                            `<button class="wf-del" data-del="${w.displayId}" data-name="${esc(w.name)}">Delete</button></td></tr>`;
                }
                host.innerHTML = html + '</table>';
                host.querySelectorAll('[data-del]').forEach(btn => btn.addEventListener('click', () => deleteWeapon(btn)));
                host.querySelectorAll('[data-view]').forEach(btn => btn.addEventListener('click', () => viewForged(btn)));
            } catch (e) { host.innerHTML = `<span class="empty">Could not load: ${esc(e)}</span>`; }
        }
        async function viewForged(btn) {
            const id = btn.dataset.view, name = btn.dataset.name || ('display ' + id);
            btn.disabled = true;
            try {
                const d = await (await fetch(`/WeaponForge/PreviewForged?displayId=${encodeURIComponent(id)}`)).json();
                if (!d.ok) return setResult({ title: 'Could not load weapon', error: d.error });
                lastGrip = null; // stored-bytes view has no grip payload
                loadGlb(previewUrl(d));
                setResult({ title: `Viewing ${name}`, kv: { 'Display': id, 'Texture': d.hasTexture ? 'yes' : 'no' },
                    note: 'Rendered from the stored M2+BLP in the registry.' });
            } catch (e) { setResult({ title: 'Load failed', error: String(e) }); }
            finally { btn.disabled = false; }
        }
        async function deleteWeapon(btn) {
            const id = btn.dataset.del, name = btn.dataset.name;
            if (!confirm(`Delete "${name}" (display ${id})?\n\nRemoves the item from the world database and the packaged patch. Its IDs return to the pool.`)) return;
            btn.disabled = true;
            try {
                const d = await (await fetch(`/WeaponForge/DeleteWeapon?displayId=${encodeURIComponent(id)}`, { method: 'POST' })).json();
                if (!d.ok) return setResult({ title: 'Delete failed', error: d.error });
                setResult({
                    title: `Deleted "${d.deleted.name}" everywhere`,
                    kv: { 'Weapons remaining': d.weaponsRemaining, 'Patch': d.patchRemoved ? 'removed' : 'repackaged & redeployed' },
                    diagnostics: [
                        applyLine(d.itemRowDeleted, 'World DB', d.itemRowMessage || ''),
                        applyLine(d.reloaded, 'Reload', d.reloadMessage || ''),
                        applyLine(d.patchDeployed || d.patchRemoved, 'Patch', d.patchDeployMessage || ''),
                    ],
                    downloads: d.patchDownloadUrl ? [{ label: 'patch-5.MPQ', url: d.patchDownloadUrl }] : [],
                    note: 'IDs returned to the pool. Restart the client to clear its model caches.'
                });
            } finally { btn.disabled = false; loadWeapons(); }
        }

        // ---------- status pills + weapon-type dropdown ----------
        async function loadStatus() {
            try {
                const s = await (await fetch('/WeaponForge/Status')).json();
                pill('pillFixture', s.fixtureVerified, 'fixture verified', 'fixture FAILED');
                pill('pillDonor', s.donorM2Found, `donor ${(s.donorM2Bytes || 0).toLocaleString()} B`, 'donor not mounted', true);
                document.getElementById('pillContract').textContent = 'contract v' + s.coordinateContractVersion;
                fillWeaponTypes(s.weaponTypes || []);
            } catch { pill('pillFixture', false, '', 'status unavailable'); }
        }
        // Options come from the server catalog; a family whose stock donor could not be resolved is
        // listed but disabled so the reason is visible instead of the type silently missing.
        function fillWeaponTypes(types) {
            if (!types.length) return;
            for (const id of ['impType', 'tbcType']) {
                const sel = document.getElementById(id);
                const keep = sel.value;
                sel.innerHTML = '';
                for (const t of types) {
                    const o = document.createElement('option');
                    o.value = t.key;
                    o.textContent = t.ok ? t.label : `${t.label} (no donor)`;
                    o.disabled = !t.ok;
                    if (t.ok && t.donorModel) o.title = `donor: ${t.donorModel} (row ${t.donorDisplayRow})`;
                    sel.appendChild(o);
                }
                sel.value = [...sel.options].some(o => o.value === keep && !o.disabled) ? keep : 'sword1h';
            }
        }
        function pill(id, ok, okText, badText, warnIfBad) {
            const el = document.getElementById(id);
            el.textContent = ok ? okText : badText;
            el.className = 'wf-pill ' + (ok ? 'ok' : (warnIfBad ? 'warn' : 'bad'));
        }

        // ---------- collapsible control cards: folded on load, header click toggles ----------
        document.querySelectorAll('.wf-controls > .wf-card').forEach(card => {
            card.classList.add('collapsed');
            const h3 = card.querySelector(':scope > h3');
            if (h3) h3.addEventListener('click', e => {
                if (e.target.closest('button, a, input, select, textarea')) return;
                card.classList.toggle('collapsed');
            });
        });

        initViewer();
        loadStatus();
        loadTbcStatus();
        loadWeapons();
    </script>
}
