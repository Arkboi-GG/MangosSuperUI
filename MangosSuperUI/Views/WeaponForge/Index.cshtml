            card.querySelector('.ib-spell-trigger').value = nativeTrigger;
            configurePpmField(card);
            card.querySelector('.ib-spell-charges').value = effect.charges ?? 0;
            card.querySelector('.ib-spell-ppm').value = effect.ppmRate ?? 0;
            card.querySelector('.ib-spell-cooldown').value = effect.cooldownMs >= 0 ? effect.cooldownMs / 1000 : '';
            card.querySelector('.ib-spell-category').value = effect.category ?? 0;
            card.querySelector('.ib-spell-category-cooldown').value = effect.categoryCooldownMs >= 0 ? effect.categoryCooldownMs / 1000 : '';
            card.querySelector('.wf-spell-results').classList.remove('open');
            card.dataset.effectName = effect.name || `Spell ${effect.id}`;
            card.dataset.resolvedId = String(effect.id);
            card.dataset.resolvedTrigger = String(nativeTrigger);
            setSpellResolution(card, true, `${effect.name || 'Installed spell'} (#${effect.id}) · ${effect.triggerLabel || ITEM_TRIGGER_NAMES[nativeTrigger]}`);
            updateItemBuildReview();
