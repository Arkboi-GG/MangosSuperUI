        function formatCopper(value) {
            value = Math.max(0, Math.floor(Number(value) || 0));
            const g = Math.floor(value / 10000), s = Math.floor(value % 10000 / 100), c = value % 100;
            return [g ? `${g}g` : '', s ? `${s}s` : '', c || (!g && !s) ? `${c}c` : ''].filter(Boolean).join(' ');
        }
        function itemReviewHtml(config) {
            const statText = config.stats.length ? config.stats.map(s => `${s.value > 0 ? '+' : ''}${s.value} ${ITEM_STAT_NAMES[s.type] || '?'}`).join(', ') : 'None';
            const spellText = config.spells.length ? config.spells.map((s, i) => {
                const card = document.querySelectorAll('#ibSpells .wf-spell-card')[i];
                const effectName = card?.dataset.effectName || `Spell #${s.spellId || '?'}`;
                return `${esc(effectName)} (${esc(ITEM_TRIGGER_NAMES[s.trigger] || '?')})`;
            }).join('<br>') : 'None';
            const resistTotal = config.holyRes + config.fireRes + config.natureRes + config.frostRes + config.shadowRes + config.arcaneRes;
            const classCount = config.allowableClass === -1 ? 'All' : document.querySelectorAll('[data-mask="class"]:checked').length;
            const raceCount = config.allowableRace === -1 ? 'All' : document.querySelectorAll('[data-mask="race"]:checked').length;
            return `<div class="wf-review-block"><h5>Identity</h5>
                <div class="wf-review-line"><span>Name</span><b style="color:${QUALITY_COLORS[config.quality] || 'inherit'}">${esc(config.name || 'Name required')}</b></div>
