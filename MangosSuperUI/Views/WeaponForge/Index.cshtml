                        'Source sha': (d.sourceSha256 || '').slice(0, 12),
                    },
                    diagnostics: [...(d.decimation ? [d.decimation] : []), ...(d.diagnostics || [])],
                    note: [d.grip && d.grip.note, d.note].filter(Boolean).join(' '), error: d.error,
                });
                previewedOnce = true;
                loadGlb(previewUrl(d));
            },
            async forgeGlb(btn) {
                const f = document.getElementById('glbFile').files[0];
                if (!f) return setResult({ title: 'No file', error: 'Choose a .glb first.' });
                itemBuildOpen('glb');
            },
            async tbcBrowse(btn) { await laneBrowse(LEGACY.tbc); },
            async tbcPreview(btn) { await lanePreview(LEGACY.tbc); },
            async tbcForge(btn) { laneForge(LEGACY.tbc); },
            async wotlkBrowse(btn) { await laneBrowse(LEGACY.wotlk); },
            async wotlkPreview(btn) { await lanePreview(LEGACY.wotlk); },
            async wotlkForge(btn) { laneForge(LEGACY.wotlk); },
            async rebuildPatch(btn) {
                const d = await (await fetch('/WeaponForge/RebuildPatch', { method: 'POST' })).json();
                if (!d.ok) return setResult({ title: 'Rebuild failed', error: d.error });
                setResult({
                    title: 'Patch repackaged',
                    kv: { 'Weapons': d.weaponCount, 'Patch': d.patchRemoved ? 'removed (no weapons in registry)' : 'rebuilt' },
                    downloads: d.patchDownloadUrl ? [{ label: 'patch-5.MPQ', url: d.patchDownloadUrl }] : [],
                    diagnostics: [applyLine(d.patchDeployed || d.patchRemoved, 'Deploy', d.patchDeployMessage || ''), ...(d.diagnostics || [])]
                });
                loadWeapons();
            },
        };
        document.querySelectorAll('[data-action]').forEach(btn => {
            btn.addEventListener('click', async () => {
                busy(btn, true);
                try { await actions[btn.dataset.action](btn); }
                catch (e) { setResult({ title: 'Request failed', error: String(e) }); }
                finally { busy(btn, false); }
            });
        });

        // ---------- Later-client import lanes: TBC + WotLK ----------
        // Both lanes are the same UI and the same server contract; only element ids (`${key}Xxx`),
        // endpoint urls and labels differ. The item-build modal receives the lane key as its mode.
        function makeLane(key, label, urls) {
            const lane = {
                key, label, urls, sel: null, page: 1, searchTimer: null, previewSerial: 0, previewTimer: null,
                el(suffix) { return document.getElementById(key + suffix); },
                targetTris() { return +(lane.el('Target')?.value || 0); },
                invalidatePreview() { ++lane.previewSerial; lane.el('ForgeBtn').disabled = true; },
            };
            return lane;
        }
        // Glow controls of a lane → request fields (bind to itemVisual / glowSpread).
        function laneGlowParams(lane, target) {
            const add = (k, v) => target.append(k, v);
            add('itemVisual', +lane.el('Visual').value);
            add('glowSpread', lane.el('GlowSpread').checked);
        }
        function wireLaneGlow(lane) {
            const schedule = () => { if (!lane.sel) return; lane.invalidatePreview(); clearTimeout(lane.previewTimer); lane.previewTimer = setTimeout(() => lanePreview(lane), 450); };
            lane.el('Visual').addEventListener('change', schedule);
            lane.el('GlowSpread').addEventListener('change', schedule);
        }
        async function loadItemVisuals() {
            try {
                const d = await (await fetch('/WeaponForge/ItemVisuals')).json();
                if (!d.ok) return;
                const selects = [...LEGACY_LANES.map(lane => lane.el('Visual')), document.getElementById('impVisual')];
                for (const sel of selects) {
                    if (!sel) continue;
                    for (const v of d.visuals) {
                        const o = document.createElement('option');
                        o.value = v.id; o.textContent = `${v.label} (#${v.id})`;
                        if (v.effects && v.effects.length) o.title = v.effects.join(' + ');
                        sel.appendChild(o);
                    }
                }
            } catch (e) { console.warn('ItemVisuals unavailable', e); }
        }
        const LEGACY = {
            tbc: makeLane('tbc', 'TBC', {
                status: '/WeaponForge/TbcStatus', weapons: '/WeaponForge/TbcWeapons',
                preview: '/WeaponForge/TbcPreviewWeapon', forge: '/WeaponForge/ForgeTbc' }),
            wotlk: makeLane('wotlk', 'WotLK', {
                status: '/WeaponForge/WotlkStatus', weapons: '/WeaponForge/WotlkWeapons',
                preview: '/WeaponForge/WotlkPreviewWeapon', forge: '/WeaponForge/ForgeWotlk' }),
        };
        const LEGACY_LANES = [LEGACY.tbc, LEGACY.wotlk];

        function wireLane(lane) {
            lane.el('Target').addEventListener('input', () => {
                lane.el('TargetVal').textContent = lane.targetTris() === 0 ? 'exact source' : lane.targetTris() + ' tris';
                if (lane.sel) {
                    lane.invalidatePreview();
                    clearTimeout(lane.previewTimer);
                    lane.previewTimer = setTimeout(() => lanePreview(lane), 500);
                }
            });
            lane.el('Type').addEventListener('change', () => {
                if (!lane.sel) return;
                lane.invalidatePreview();
                lanePreview(lane);
            });
            lane.el('ModalClose').addEventListener('click', () => lane.el('Modal').classList.remove('open'));
            lane.el('Modal').addEventListener('click', (e) => { if (e.target === e.currentTarget) e.currentTarget.classList.remove('open'); });
            lane.el('Prev').addEventListener('click', () => loadLanePage(lane, lane.page - 1));
            lane.el('Next').addEventListener('click', () => loadLanePage(lane, lane.page + 1));
            lane.el('Search').addEventListener('input', () => {
                clearTimeout(lane.searchTimer);
                lane.searchTimer = setTimeout(() => loadLanePage(lane, 1), 350);
            });
            wireLaneGlow(lane);
        }

        async function loadLaneStatus(lane) {
            const el = lane.el('State');
            try {
                const s = await (await fetch(lane.urls.status)).json();
                if (!s.configured) {
                    el.innerHTML = `No ${lane.label} Data path configured — set <b>${lane.label} Client Data Path</b> on the Settings page.`;
                    return;
                }
                if (s.error) { el.innerHTML = `<span style="color:#b42318;">${lane.label} mount problem: ${esc(s.error)}</span>`; return; }
                el.innerHTML = `Mounted <b>${s.archiveCount}</b> archive(s) from <code>${esc(s.path)}</code> — ` +
                               (s.itemCount > 0
                                   ? `<b>${s.itemCount.toLocaleString()}</b> named ${lane.label} weapons browsable ` +
                                     `(${s.weaponCount.toLocaleString()} models).`
                                   : `<b>${s.weaponCount.toLocaleString()}</b> weapon models browsable (no item-name catalog).`);
                lane.el('BrowseBtn').disabled = !(s.weaponCount > 0);
            } catch (e) { el.textContent = `${lane.label} status unavailable: ` + e; }
        }

        // WoW quality colors (0 poor … 6 artifact).
        const QUALITY_COLORS = ['#9d9d9d', '#e6e8ea', '#1eff00', '#0070dd', '#a335ee', '#ff8000', '#e6cc80'];

        async function loadLanePage(lane, page) {
            lane.page = page;
            const list = lane.el('List');
            list.innerHTML = '<div style="padding:14px;color:var(--text-muted);font-size:12px;">Loading…</div>';
            const q = new URLSearchParams({ page, search: lane.el('Search').value.trim() });
            try {
                const d = await (await fetch(lane.urls.weapons + '?' + q)).json();
                if (!d.ok) { list.innerHTML = `<div style="padding:14px;font-size:12px;color:#b42318;">${esc(d.error || 'failed')}</div>`; return; }
                if (!d.weapons.length) { list.innerHTML = '<div style="padding:14px;color:var(--text-muted);font-size:12px;">No matches.</div>'; }
                else {
                    const itemMode = d.mode === 'items';
                    let html = itemMode
                        ? '<table><tr><th>Name</th><th>ilvl</th><th>Type</th><th>Slot</th><th>Model</th><th>ID</th></tr>'
                        : '<table><tr><th>Model</th><th>Texture</th><th>Row</th></tr>';
                    for (const w of d.weapons) {
                        const attrs = `data-entry="${w.entry || 0}" data-model="${esc(w.model)}" data-row="${w.displayRow}"` +
                                      ` data-type="${esc(w.typeKey || '')}" data-name="${esc(w.name)}"` +
                                      ` data-inventory-type="${w.inventoryType ?? ''}" data-slot-label="${esc(w.inventoryTypeLabel || '')}"`;
                        if (itemMode) {
                            const col = QUALITY_COLORS[w.quality] || QUALITY_COLORS[1];
                            html += `<tr ${attrs}><td style="color:${col};font-weight:600;">${esc(w.name)}</td>` +
                                    `<td class="muted">${w.itemLevel || '—'}</td><td class="muted">${esc(w.typeLabel || '—')}</td>` +
                                    `<td class="muted">${esc(w.inventoryTypeLabel || '—')}</td>` +
                                    `<td class="muted">${esc(w.model)}</td><td class="muted">${w.entry}</td></tr>`;
                        } else {
                            html += `<tr ${attrs}><td>${esc(w.model)}</td><td class="muted">${esc(w.texture)}</td>` +
                                    `<td class="muted">${w.displayRow}</td></tr>`;
                        }
                    }
                    list.innerHTML = html + '</table>';
                    list.querySelectorAll('tr[data-model]').forEach(tr => tr.addEventListener('click', () => selectLane(lane, tr)));
                }
                lane.el('PageInfo').textContent = `${d.total.toLocaleString()} weapon(s) — page ${d.page}/${d.pages}`;
                lane.el('Prev').disabled = d.page <= 1;
                lane.el('Next').disabled = d.page >= d.pages;
                lane.page = d.page;
            } catch (e) { list.innerHTML = `<div style="padding:14px;font-size:12px;color:#b42318;">${esc(String(e))}</div>`; }
        }

        function selectLane(lane, tr) {
            lane.sel = {
                entry: +tr.dataset.entry || 0,
                model: tr.dataset.model,
                displayRow: +tr.dataset.row,
                name: tr.dataset.name || tr.dataset.model,
                typeKey: tr.dataset.type || '',
                inventoryType: +(tr.dataset.inventoryType || 0),
                inventoryTypeLabel: tr.dataset.slotLabel || '',
            };
            lane.el('Selected').value =
                lane.sel.entry
                    ? `${lane.sel.name} — ${lane.sel.inventoryTypeLabel || 'unknown slot'} (item ${lane.sel.entry})`
                    : `${lane.sel.model} (row ${lane.sel.displayRow})`;
            // Pre-select the family from the source subclass; the name field defaults to the item name.
            const typeSel = lane.el('Type');
            if (lane.sel.typeKey && [...typeSel.options].some(o => o.value === lane.sel.typeKey && !o.disabled))
                typeSel.value = lane.sel.typeKey;
            lane.el('Name').placeholder = lane.sel.name;
            lane.el('PreviewBtn').disabled = false;
            lane.el('Visual').value = '-1';
            lane.invalidatePreview();
            lane.el('Modal').classList.remove('open');
            lanePreview(lane);
        }

        async function laneBrowse(lane) {
            lane.el('Modal').classList.add('open');
            lane.el('Search').focus();
            await loadLanePage(lane, 1);
        }

        async function lanePreview(lane) {
            if (!lane.sel) return setResult({ title: `No ${lane.label} weapon selected`, error: 'Browse and pick one first.' });
            const requestId = ++lane.previewSerial;
            const selected = { ...lane.sel };
            const weaponType = lane.el('Type').value || 'sword1h';
            const targetTriangles = lane.targetTris();
            const configureButton = lane.el('ForgeBtn');
            configureButton.disabled = true;
            const q = new URLSearchParams({
                entry: selected.entry, model: selected.model, displayRow: selected.displayRow,
                weaponType,
                targetTriangles,
            });
            laneGlowParams(lane, q);
            let d;
            try {
                const response = await fetch(lane.urls.preview + '?' + q);
                d = await response.json();
                if (!response.ok) throw new Error(d.error || `${lane.label} preview failed.`);
            } catch (error) {
                if (requestId !== lane.previewSerial) return;
                configureButton.disabled = true;
                setResult({ title: `${lane.label} preview failed`, error: String(error) });
                return;
            }
            if (requestId !== lane.previewSerial) return;
            lastGrip = d.grip || null;
            configureButton.disabled = !d.ok || d.withinForgeBudget === false;
            const p = d.particles || {};
            const sug = d.suggestedItemVisual;
            const autoOpt = lane.el('Visual').querySelector('option[value="-1"]');
            if (autoOpt) autoOpt.textContent = sug && sug.id ? `Auto — ${sug.label} (#${sug.id})` : 'Auto (this model has no glow → none)';
            // Two possible glow sources, reported separately so it is obvious which one this weapon
            // actually uses: the display row's own ItemVisual (the common case), or model emitters.
            const parts = [];
            if (p.sourceVisual) {
                parts.push(`The source display row carries <b>ItemVisual ${p.sourceVisual.id}</b>` +
                    (p.sourceVisual.effects && p.sourceVisual.effects.length ? ` (${esc(p.sourceVisual.effects.join(' + '))})` : '') +
                    ` \u2192 <b>${esc(p.sourceVisual.mappedLabel || 'no 1.12 equivalent')}</b>` +
                    (p.sourceVisual.reason ? ` \u2014 ${esc(p.sourceVisual.reason)}` : '') + '.');
            }
            if (p.count) {
                parts.push(`Model has <b>${p.count}</b> particle emitter(s)${p.textures && p.textures.length ? ' \u2014 ' + esc(p.textures.join(', ')) : ''}` +
                    (p.colours && p.colours.length ? ' ' + p.colours.map(c => `<span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:${esc(c)};border:1px solid #0006;vertical-align:middle;"></span>`).join('') : '') +
                    (p.emitterSuggested ? `, nearest vanilla: <b>${esc(p.emitterSuggested.label)}</b>` : '') + '.');
            }
            if (!parts.length) parts.push('This model has no glow of its own \u2014 no ItemVisual on its display row, no particle emitters. Pick one anyway if you want one.');
            // Where the glow will hang. Vanilla fills all five anchor slots, so a clustered source
            // set is the difference between an enchant along the weapon and a lump on the blade.
            if (p.anchorsSpread) parts.push('Anchors spread evenly hilt-to-tip.');
            else if (p.anchorSpanPercent != null && p.anchorSpanPercent < 25)
                parts.push(`The source's glow anchors span only <b>${p.anchorSpanPercent}%</b> of the weapon \u2014 tick <b>spread glow along weapon</b> for the hilt-to-tip look.`);
            parts.push(`Forging with: <b>${esc(p.chosen ? p.chosen.label : 'none')}</b>. Glows render in-game only.`);
            lane.el('VisualNote').innerHTML = parts.join(' ');
            setResult({
                title: d.ok ? `${lane.label} preview — ${d.itemName || selected.name}` : `${lane.label} preview failed`,
                kv: d.ok ? {
                    'Type': d.weaponTypeLabel || '1H Sword',
                    'Equip slot': d.inventoryTypeLabel || (d.inventoryType != null ? `Inventory type ${d.inventoryType}` : '—'),
                    'Model': d.model,
                    'Triangles': (d.triangleCount ?? 0).toLocaleString() +
                        (d.withinForgeBudget === false ? ' — OVER vanilla UInt16 limit' : ''),
                    'Vertices': (d.vertexCount ?? 0).toLocaleString(),
                    'Texture': d.hasTexture ? d.texture : 'MISSING — fidelity import stopped',
                    'Glow': p.chosen ? p.chosen.label + (sug && sug.id === (p.chosen.id|0) ? ' (suggested)' : '') : 'none',
                } : undefined,
                diagnostics: d.diagnostics, note: d.grip && d.grip.note, error: d.error,
            });
            loadGlb(previewUrl(d));
        }

        function laneForge(lane) {
            if (!lane.sel) return setResult({ title: `No ${lane.label} weapon selected`, error: 'Browse and pick one first.' });
            itemBuildOpen(lane.key);
        }

        LEGACY_LANES.forEach(wireLane);

        // ---------- forged weapons registry ----------
        async function loadWeapons() {
            const host = document.getElementById('wfWeapons');
            try {
                const d = await (await fetch('/WeaponForge/ListWeapons')).json();
                if (!d.ok) { host.innerHTML = `<span class="empty">Could not load: ${esc(d.error || 'unknown')}</span>`; return; }
                if (!d.weapons.length) { host.innerHTML = '<span class="empty">Nothing forged yet.</span>'; return; }
                let html = '<table><tr><th>Name</th><th>Type</th><th>Slot</th><th>Entry</th><th>Display</th><th>Source</th><th>Created</th><th></th></tr>';
                for (const w of d.weapons) {
                    html += `<tr><td>${esc(w.name)}</td><td class="muted">${esc(w.weaponTypeLabel || '—')}</td>` +
                            `<td class="muted">${esc(w.inventoryTypeLabel || (w.inventoryType != null ? `Inventory type ${w.inventoryType}` : '—'))}</td>` +
                            `<td class="muted">${w.itemEntry || '—'}</td>` +
                            `<td class="muted">${w.displayId}</td><td class="muted">${esc(w.sourceKind)}</td>` +
                            `<td class="muted">${esc(w.createdAt)}</td>` +
                            `<td style="white-space:nowrap;"><button class="wf-del" data-view="${w.displayId}" data-name="${esc(w.name)}" style="background:var(--bg-input,#1c2029);color:var(--text-primary);border-color:var(--border-color);margin-right:5px;">View</button>` +
                            `<button class="wf-del" data-del="${w.displayId}" data-name="${esc(w.name)}">Delete</button></td></tr>`;
                }
                host.innerHTML = html + '</table>';
                host.querySelectorAll('[data-del]').forEach(btn => btn.addEventListener('click', () => deleteWeapon(btn)));
                host.querySelectorAll('[data-view]').forEach(btn => btn.addEventListener('click', () => viewForged(btn)));
            } catch (e) { host.innerHTML = `<span class="empty">Could not load: ${esc(e)}</span>`; }
        }
        async function viewForged(btn) {
            const id = btn.dataset.view, name = btn.dataset.name || ('display ' + id);
            btn.disabled = true;
            try {
                const d = await (await fetch(`/WeaponForge/PreviewForged?displayId=${encodeURIComponent(id)}`)).json();
                if (!d.ok) return setResult({ title: 'Could not load weapon', error: d.error });
                lastGrip = null; // stored-bytes view has no grip payload
                loadGlb(previewUrl(d));
                setResult({ title: `Viewing ${name}`, kv: { 'Display': id, 'Texture': d.hasTexture ? 'yes' : 'no' },
                    note: 'Rendered from the stored M2+BLP in the registry.' });
            } catch (e) { setResult({ title: 'Load failed', error: String(e) }); }
            finally { btn.disabled = false; }
        }
        async function deleteWeapon(btn) {
            const id = btn.dataset.del, name = btn.dataset.name;
            if (!confirm(`Delete "${name}" (display ${id})?\n\nRemoves the item from the world database and the packaged patch. Its IDs return to the pool.`)) return;
            btn.disabled = true;
            try {
                const d = await (await fetch(`/WeaponForge/DeleteWeapon?displayId=${encodeURIComponent(id)}`, { method: 'POST' })).json();
                if (!d.ok) return setResult({ title: 'Delete failed', error: d.error });
                setResult({
                    title: `Deleted "${d.deleted.name}" everywhere`,
                    kv: { 'Weapons remaining': d.weaponsRemaining, 'Patch': d.patchRemoved ? 'removed' : 'repackaged & redeployed' },
                    diagnostics: [
                        applyLine(d.itemRowDeleted, 'World DB', d.itemRowMessage || ''),
                        applyLine(d.reloaded, 'Reload', d.reloadMessage || ''),
                        applyLine(d.patchDeployed || d.patchRemoved, 'Patch', d.patchDeployMessage || ''),
                    ],
                    downloads: d.patchDownloadUrl ? [{ label: 'patch-5.MPQ', url: d.patchDownloadUrl }] : [],
                    note: 'IDs returned to the pool. Fully restart the client. If a reused entry shows cached item metadata, close WoW and remove WDB\\itemcache.wdb (or the whole WDB cache directory); WoW recreates it.'
                });
            } finally { btn.disabled = false; loadWeapons(); }
        }

        // ---------- status pills + weapon-type dropdown ----------
        async function loadStatus() {
            try {
                const s = await (await fetch('/WeaponForge/Status')).json();
                pill('pillFixture', s.fixtureVerified, 'fixture verified', 'fixture FAILED');
                pill('pillDonor', s.donorM2Found, `donor ${(s.donorM2Bytes || 0).toLocaleString()} B`, 'donor not mounted', true);
                document.getElementById('pillContract').textContent = 'contract v' + s.coordinateContractVersion;
                const dp = s.deployedPatch || {};
                const dpEl = document.getElementById('pillDeploy');
                dpEl.textContent = !dp.configured ? 'deploy: no client path' : dp.stale ? 'patch-5 STALE in client — close WoW, Rebuild patch' : (dp.deployedExists ? 'patch-5 deployed ✓' : 'patch-5 not deployed yet');
                dpEl.className = 'wf-pill ' + (!dp.configured ? 'warn' : dp.stale ? 'bad' : 'ok');
                dpEl.title = dp.message || dpEl.title;
                fillWeaponTypes(s.weaponTypes || []);
            } catch { pill('pillFixture', false, '', 'status unavailable'); }
        }
        // Options come from the server catalog; a family whose stock donor could not be resolved is
        // listed but disabled so the reason is visible instead of the type silently missing.
        function fillWeaponTypes(types) {
            if (!types.length) return;
            weaponTypeMeta.clear();
            for (const t of types) weaponTypeMeta.set(t.key, t);
            for (const id of ['impType', 'tbcType', 'wotlkType']) {
                const sel = document.getElementById(id);
                const keep = sel.value;
                sel.innerHTML = '';
                for (const t of types) {
                    const o = document.createElement('option');
                    o.value = t.key;
                    // Families without an arbitrary-GLB route (shields: no long axis/grip to find)
                    // are client-import only (TBC/WotLK), so the GLB card lists them disabled with the reason.
                    const glbBlocked = id === 'impType' && t.glbImport === false;
                    o.textContent = !t.ok ? `${t.label} (no donor)` : glbBlocked ? `${t.label} (TBC/WotLK import only)` : t.label;
                    o.disabled = !t.ok || glbBlocked;
                    if (glbBlocked) o.title = 'Shields have no long axis or grip for the GLB heuristics — import them from the TBC or WotLK browse instead.';
                    else if (t.ok && t.donorModel) o.title = `donor: ${t.donorModel} (row ${t.donorDisplayRow})`;
                    else if (!t.ok && t.error) o.title = t.error;
                    sel.appendChild(o);
                }
                sel.value = [...sel.options].some(o => o.value === keep && !o.disabled) ? keep : 'sword1h';
            }
        }
        function pill(id, ok, okText, badText, warnIfBad) {
            const el = document.getElementById(id);
            el.textContent = ok ? okText : badText;
            el.className = 'wf-pill ' + (ok ? 'ok' : (warnIfBad ? 'warn' : 'bad'));
        }

        // ---------- collapsible control cards: folded on load, header click toggles ----------
        document.querySelectorAll('.wf-controls > .wf-card').forEach(card => {
            card.classList.add('collapsed');
            const h3 = card.querySelector(':scope > h3');
            if (h3) h3.addEventListener('click', e => {
                if (e.target.closest('button, a, input, select, textarea')) return;
                card.classList.toggle('collapsed');
            });
        });

        initViewer();
        loadStatus();
        LEGACY_LANES.forEach(loadLaneStatus);
        loadItemVisuals();
        loadGlowCoverage();

        // How much of the mounted client's weapon glow this lane can actually reproduce. DBC-only on
        // the server, so it is instant; failures leave the line blank rather than shouting.
        async function loadGlowCoverage() {
            for (const lane of LEGACY_LANES) {
                const el = document.getElementById(lane.key + 'GlowCoverage');
                if (!el) continue;
                try {
                    const d = await (await fetch(`/WeaponForge/GlowCoverage?expansion=${lane.key}`)).json();
                    if (!d.ok) { el.textContent = ''; continue; }
                    const pct = d.weaponRows ? Math.round(d.withGlow * 1000 / d.weaponRows) / 10 : 0;
                    el.innerHTML = `<b>Glow coverage:</b> ${d.withGlow.toLocaleString()} of ${d.weaponRows.toLocaleString()} ` +
                        `${lane.label} weapon models (${pct}%) carry a permanent glow on their display row — ` +
                        `${d.exact.toLocaleString()} copy across to 1.12 unchanged, ${d.mapped.toLocaleString()} map to the nearest vanilla glow, ` +
                        `${d.unmatched.toLocaleString()} are cast animations with no equivalent.`;
                    el.title = d.note || '';
                } catch (e) { el.textContent = ''; }
            }
        }
        loadWeapons();
    </script>
}
