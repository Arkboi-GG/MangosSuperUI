        };

        const noBusy = new Set(['openSetup', 'closeSetup', 'copySetup', 'saveWorkflow', 'savePipelineProfile', 'importPipelineProfile']);
        document.querySelectorAll('[data-action]').forEach(btn => {
            btn.addEventListener('click', async () => {
                const skipBusy = noBusy.has(btn.dataset.action);
                if (!skipBusy) busy(btn, true);
                try { await actions[btn.dataset.action](btn); }
                catch (e) { setResult({ title: 'Request failed', error: String(e) }); }
                finally { if (!skipBusy) busy(btn, false); }
            });
        });

        // ── Material-zone atlas (WEAPON_FORGE.md quadrant atlas) ──────────────────────────────
        let lastPreviewPath = null;   // /weapon_forge_cache/xxx.glb — the geometry source for zoning
        let pendingTextured = false;  // next loadGlb is a textured re-preview, don't overwrite the map
        let lastRefined = null;       // data URL of the last img2img-refined atlas, for Forge refined
        let reworkDisplayId = null;   // forged weapon currently opened for rework
        let reworkRefined = null;     // data URL of its reworked atlas, for Apply

        async function viewForged(btn) {
            const id = btn.dataset.view, name = btn.dataset.name || ('display ' + id);
            btn.disabled = true;
            try {
                const d = await (await fetch(`/WeaponForge/PreviewForged?displayId=${encodeURIComponent(id)}`)).json();
                if (!d.ok) return setResult({ title: 'Could not load weapon', error: d.error });
                reworkDisplayId = id; reworkRefined = null;
                document.getElementById('reworkLabel').textContent = `${name} · display ${id}`;
                document.getElementById('reworkAtlasImg').style.display = 'none';
                document.getElementById('reworkPanel').style.display = 'block';
                pendingTextured = true; loadGlb(previewUrl(d));
                setResult({ title: `Viewing ${name}`, kv: { 'Display': id, 'Texture': d.hasTexture ? 'yes' : 'no' },
                    note: 'Loaded from the registry. Rework its texture below.' });
            } catch (e) { setResult({ title: 'Load failed', error: String(e) }); }
            finally { btn.disabled = false; }
        }
        let zoneCellsBuilt = false;
        const ZONE_COLORS = [0x4aa3ff, 0xffcf4a, 0x6ee07a, 0xff6b6b]; // blade guard grip pommel
        const ZONE_LABELS = ['blade', 'guard', 'grip', 'pommel'];
        // Default per-zone material colours: steel / gold / leather / dark iron.
        const cellFills = [
            { kind: 'solid', color: '#c9ced6', imageDataUrl: null },
            { kind: 'solid', color: '#d8b24a', imageDataUrl: null },
            { kind: 'solid', color: '#6f4a2f', imageDataUrl: null },
            { kind: 'solid', color: '#4a4e57', imageDataUrl: null },
        ];
        const zonePanel = document.getElementById('zonePanel');

        function readBoundaries() {
            let bg = +document.getElementById('zbBladeGuard').value;
            let gg = +document.getElementById('zbGuardGrip').value;
            let gp = +document.getElementById('zbGripPommel').value;
            // Keep strictly descending so zones never cross (server clamps identically).
            if (gg > bg - 0.01) gg = bg - 0.01;
            if (gp > gg - 0.01) gp = gg - 0.01;
            return { bg, gg, gp };
        }
        function meshXRange() {
            let min = Infinity, max = -Infinity;
            if (current) current.traverse(o => {
                if (!o.isMesh) return;
                const p = o.geometry.attributes.position;
                for (let i = 0; i < p.count; i++) { const x = p.getX(i); if (x < min) min = x; if (x > max) max = x; }
            });
            if (!isFinite(min)) { min = 0; max = 1; }
            return { min, max, range: Math.max(max - min, 1e-6) };
        }
        function applyZoneColors() {
            if (!current) return;
            const b = readBoundaries(), r = meshXRange();
            current.traverse(o => {
                if (!o.isMesh) return;
                const geo = o.geometry, pos = geo.attributes.position;
                const colors = new Float32Array(pos.count * 3);
                for (let i = 0; i < pos.count; i++) {
                    const t = (pos.getX(i) - r.min) / r.range;
                    const z = t >= b.bg ? 0 : t >= b.gg ? 1 : t >= b.gp ? 2 : 3;
                    const c = new THREE.Color(ZONE_COLORS[z]);
                    colors[i * 3] = c.r; colors[i * 3 + 1] = c.g; colors[i * 3 + 2] = c.b;
                }
                geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
                o.material.vertexColors = true; o.material.map = null;
                o.material.color = new THREE.Color(0xffffff); o.material.needsUpdate = true;
            });
        }
        function autoSegment() {
            const r = meshXRange();
            const tOrigin = Math.min(0.9, Math.max(0.05, (0 - r.min) / r.range));
            const bg = Math.min(0.97, tOrigin + 0.10);
            const gg = Math.max(0.05, tOrigin - 0.04);
            const gp = Math.max(0.02, gg - 0.14);
            document.getElementById('zbBladeGuard').value = bg.toFixed(3);
            document.getElementById('zbGuardGrip').value = Math.min(gg, bg - 0.01).toFixed(3);
            document.getElementById('zbGripPommel').value = Math.min(gp, gg - 0.01).toFixed(3);
        }
        function updateAtlasThumb() {
            const cv = document.createElement('canvas'); cv.width = 128; cv.height = 64;
            const ctx = cv.getContext('2d');
            const rects = [[0, 0], [64, 0], [0, 32], [64, 32]];
            let pending = 0;
            const finish = () => { document.getElementById('zoneAtlasImg').src = cv.toDataURL('image/png'); };
            ctx.fillStyle = '#8a8f99'; ctx.fillRect(0, 0, 128, 64);
            cellFills.forEach((f, i) => {
                const [x, y] = rects[i];
                if (f.kind === 'image' && f.imageDataUrl) {
                    pending++;
                    const im = new Image();
                    im.onload = () => { ctx.drawImage(im, x, y, 64, 32); if (--pending === 0) finish(); };
                    im.onerror = () => { if (--pending === 0) finish(); };
                    im.src = f.imageDataUrl;
                } else {
                    ctx.fillStyle = f.color || '#9a9fa8'; ctx.fillRect(x, y, 64, 32);
                }
            });
            if (pending === 0) finish();
        }
        function buildZoneCells() {
            if (zoneCellsBuilt) return; zoneCellsBuilt = true;
            const host = document.getElementById('zoneCells');
            host.innerHTML = '';
            const modeBtn = (i, k, label) =>
                `<button type="button" class="zmode" data-z="${i}" data-k="${k}"
                    style="flex:1;padding:4px 2px;font-size:10.5px;cursor:pointer;border:1px solid var(--border-color);
                           background:var(--bg-input,#1c2029);color:var(--text-primary);border-radius:5px;">${label}</button>`;
            cellFills.forEach((f, i) => {
                const box = document.createElement('div');
                box.style.cssText = 'border:1px solid var(--border-color);border-radius:6px;padding:7px;font-size:11px;';
                box.innerHTML =
                    `<div style="display:flex;align-items:center;gap:6px;margin-bottom:6px;">
                        <span style="width:11px;height:11px;border-radius:2px;background:#${ZONE_COLORS[i].toString(16).padStart(6,'0')};"></span>
                        <strong>Q${i+1} · ${ZONE_LABELS[i]}</strong></div>
                     <div style="display:flex;gap:4px;margin-bottom:6px;">
                        ${modeBtn(i,'solid','🎨 Colour')}${modeBtn(i,'upload','⬆ Upload')}${modeBtn(i,'generate','✦ Generate')}</div>
                     <div class="zk-solid" data-z="${i}"><input type="color" value="${f.color}" data-z="${i}" class="zc" style="width:100%;height:28px;padding:0;border:none;background:none;cursor:pointer;"></div>
                     <div class="zk-upload" data-z="${i}" style="display:none;">
                        <input type="file" accept="image/png,image/jpeg" data-z="${i}" class="zf" style="width:100%;font-size:10.5px;">
                        <div style="color:var(--text-muted);font-size:10px;margin-top:3px;">128×64 PNG/JPEG — fills this quadrant (front + back share it).</div></div>
                     <div class="zk-generate" data-z="${i}" style="display:none;">
                        <input type="text" placeholder="e.g. polished steel, seamless" data-z="${i}" class="zp" style="width:100%;margin-bottom:4px;font-size:11px;">
                        <button type="button" class="wf-btn secondary zg" data-z="${i}" style="width:100%;padding:4px;font-size:10.5px;">✦ Text → image (ComfyUI · Flux)</button>
                        <div class="zgs" data-z="${i}" style="color:var(--text-muted);font-size:10px;margin-top:3px;min-height:12px;"></div></div>`;
                host.appendChild(box);
            });
            const setMode = (i, kind) => {
                for (const k of ['solid', 'upload', 'generate'])
                    host.querySelector(`.zk-${k}[data-z="${i}"]`).style.display = k === kind ? 'block' : 'none';
                host.querySelectorAll(`button.zmode[data-z="${i}"]`).forEach(b => {
                    const on = b.dataset.k === kind;
                    b.style.background = on ? 'var(--accent,#2563eb)' : 'var(--bg-input,#1c2029)';
                    b.style.color = on ? '#fff' : 'var(--text-primary)';
                    b.style.borderColor = on ? 'var(--accent,#2563eb)' : 'var(--border-color)';
                });
                cellFills[i].kind = (kind !== 'solid' && cellFills[i].imageDataUrl) ? 'image' : 'solid';
                cellFills[i].mode = kind;
                updateAtlasThumb();
            };
            host.querySelectorAll('button.zmode').forEach(b => b.addEventListener('click', () => setMode(+b.dataset.z, b.dataset.k)));
            host.querySelectorAll('input.zc').forEach(inp => inp.addEventListener('input', () => {
                const i = +inp.dataset.z; cellFills[i].color = inp.value;
                if ((cellFills[i].mode || 'solid') === 'solid') cellFills[i].kind = 'solid';
                updateAtlasThumb();
            }));
            host.querySelectorAll('input.zf').forEach(inp => inp.addEventListener('change', () => {
                const i = +inp.dataset.z, file = inp.files[0]; if (!file) return;
                const reader = new FileReader();
                reader.onload = () => { cellFills[i].imageDataUrl = reader.result; cellFills[i].kind = 'image'; cellFills[i].mode = 'upload'; updateAtlasThumb(); };
                reader.readAsDataURL(file);
            }));
            host.querySelectorAll('button.zg').forEach(btn => btn.addEventListener('click', async () => {
                const i = +btn.dataset.z;
                const status = host.querySelector(`.zgs[data-z="${i}"]`);
                const prompt = host.querySelector(`input.zp[data-z="${i}"]`).value.trim();
                if (!prompt) { status.textContent = 'Enter a prompt first.'; return; }
                busy(btn, true); status.textContent = 'Generating on the local pool… (Flux is slow, ~30–60s)';
                try {
                    const fd = new FormData(); fd.append('prompt', prompt);
                    const d = await (await fetch('/WeaponForge/GenerateCellTexture', { method: 'POST', body: fd })).json();
                    if (!d.ok) { status.textContent = d.error || 'Generation failed.'; }
                    else { cellFills[i].imageDataUrl = d.imageDataUrl; cellFills[i].kind = 'image'; cellFills[i].mode = 'generate'; updateAtlasThumb(); status.textContent = 'Generated ✓ — mapped into Q' + (i + 1) + '.'; }
                } catch (e) { status.textContent = 'Generation failed: ' + String(e); }
                finally { busy(btn, false); }
            }));
            cellFills.forEach((_, i) => setMode(i, cellFills[i].mode || 'solid'));
        }
        function onFreshPreview() {
            buildZoneCells();
            zonePanel.style.display = 'block';
            autoSegment();
            applyZoneColors();
            updateAtlasThumb();
        }
        function zoneForm() {
            const b = readBoundaries(), fd = new FormData();
            fd.append('previewPath', lastPreviewPath);
            fd.append('bladeGuard', b.bg); fd.append('guardGrip', b.gg); fd.append('gripPommel', b.gp);
            fd.append('fillsJson', JSON.stringify(cellFills.map(f => ({ kind: f.kind, color: f.color, image: f.imageDataUrl || null }))));
            return fd;
        }
        ['zbBladeGuard', 'zbGuardGrip', 'zbGripPommel'].forEach(id =>
            document.getElementById(id).addEventListener('input', applyZoneColors));
        document.getElementById('zoneAuto').addEventListener('click', () => { autoSegment(); applyZoneColors(); });
        document.getElementById('wfExpand').addEventListener('click', () => {
            const v = document.getElementById('wfViewer');
            const on = v.classList.toggle('expanded');
            document.getElementById('wfExpand').textContent = on ? '⤢ close' : '⤢ expand';
            requestAnimationFrame(() => { onResize(); if (current) frameObject(current); });
        });
        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                const v = document.getElementById('wfViewer');
                if (v.classList.contains('expanded')) { v.classList.remove('expanded'); document.getElementById('wfExpand').textContent = '⤢ expand'; requestAnimationFrame(() => { onResize(); if (current) frameObject(current); }); }
            }
        });

        initViewer();
        loadStatus();
        loadWeapons();
        loadSetupInfo();
    </script>
}
