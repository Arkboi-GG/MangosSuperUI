                if (mode === 'glb') document.getElementById('glbName').value = config.name;
                else LEGACY[mode].el('Name').value = config.name;
                closeItemBuild(true);
                forgeResult(d, mode === 'glb' ? 'GLB forged' : `${LEGACY[mode].label} weapon forged`);
