                <div class="wf-review-line"><span>Family</span><b>${esc(itemBuildState.familyLabel)}</b></div>
                <div class="wf-review-line"><span>Quality / slot</span><b>${esc(ITEM_QUALITY_NAMES[config.quality] || '?')} · ${esc(ITEM_SLOT_NAMES[config.inventoryType] || '?')}</b></div></div>
                <div class="wf-review-block"><h5>Power</h5>
                <div class="wf-review-line"><span>Levels</span><b>ilvl ${config.itemLevel} · requires ${config.requiredLevel || 'none'}</b></div>
                <div class="wf-review-line"><span>Damage</span><b>${config.damageMin}–${config.damageMax} ${esc(ITEM_DAMAGE_NAMES[config.damageType] || '?')}</b></div>
                <div class="wf-review-line"><span>Speed</span><b>${config.delayMs ? `${(config.delayMs / 1000).toFixed(2)} sec` : 'Preserve source default'}</b></div>
                <div class="wf-review-line"><span>Direct stats</span><b>${esc(statText)}</b></div>
                <div class="wf-review-line"><span>Defense</span><b>${config.armor} armor · ${config.block} block${resistTotal ? ` · ${resistTotal} total resist` : ''}</b></div></div>
                <div class="wf-review-block"><h5>Effects & rules</h5>
                <div class="wf-review-line"><span>Spell slots</span><b>${spellText}</b></div>
                <div class="wf-review-line"><span>Allowed</span><b>${classCount} classes · ${raceCount} races</b></div>
                <div class="wf-review-line"><span>Durability / bind</span><b>${config.maxDurability} · ${document.getElementById('ibBonding').selectedOptions[0]?.textContent || '?'}</b></div>
                <div class="wf-review-line"><span>Vendor</span><b>Buy ${formatCopper(config.buyPrice)} · Sell ${formatCopper(config.sellPrice)}</b></div></div>`;
        }
        function updateQualityReadout() {
