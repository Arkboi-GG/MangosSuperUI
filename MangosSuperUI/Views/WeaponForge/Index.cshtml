        function renumberItemSpells() {
            document.querySelectorAll('#ibSpells .wf-spell-card').forEach((card, i) => card.querySelector('.wf-spell-head strong').textContent = `Spell slot ${i + 1}`);
        }
        function configurePpmField(card) {
            const chance = +card.querySelector('.ib-spell-trigger').value === 2;
            const ppm = card.querySelector('.ib-spell-ppm');
