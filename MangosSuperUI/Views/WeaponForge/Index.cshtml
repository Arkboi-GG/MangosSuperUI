            el.innerHTML = `<strong>Please fix the following:</strong><ul style="margin:5px 0 0 17px;padding:0;">${rows.map(x => `<li>${esc(x)}</li>`).join('')}</ul>`;
            el.classList.add('open');
            el.focus({ preventScroll: true });
            scrollItemBuildToTop();
            document.getElementById('ibReadyState').innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Configuration needs attention.';
            document.getElementById('ibReadyState').style.borderColor = '#b4231855';
            document.getElementById('ibReadyState').style.color = '#e78a83';
