                <div class="wf-spell-primary">
                    <div class="wf-build-field"><label>Find a stock item effect</label><div class="wf-spell-search-wrap">
                        <input type="text" class="ib-spell-search" autocomplete="off" placeholder="Search name, effect, or exact ID">
                        <div class="wf-spell-results"></div></div></div>
                    <div class="wf-build-field"><label>Spell ID</label><input type="number" class="ib-spell-id" min="1" max="65535" step="1" placeholder="ID" required></div>
                    <div class="wf-build-field"><label>Native trigger</label><select class="ib-spell-trigger">
                        <option value="0">Use</option><option value="1">On Equip</option><option value="2">Chance on Hit</option>
                    </select></div>
                </div>
                <div class="wf-spell-resolved">Choose a native effect already used by a stock vanilla item.</div>
                <div class="wf-spell-advanced">
                    <div class="wf-build-field"><label>Charges</label><input type="number" class="ib-spell-charges" min="-32768" max="32767" step="1" value="0" readonly></div>
                    <div class="wf-build-field"><label>PPM</label><input type="number" class="ib-spell-ppm" min="0" max="1000" step="any" value="0" readonly></div>
                    <div class="wf-build-field"><label>Cooldown sec</label><input type="number" class="ib-spell-cooldown" min="0" max="2147483.647" step="0.001" placeholder="spell default" readonly></div>
                    <div class="wf-build-field"><label>Category</label><input type="number" class="ib-spell-category" min="0" max="65535" step="1" value="0" readonly></div>
                    <div class="wf-build-field"><label>Category CD sec</label><input type="number" class="ib-spell-category-cooldown" min="0" max="2147483.647" step="0.001" placeholder="spell default" readonly></div>
