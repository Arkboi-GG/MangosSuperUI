            async reworkForged(btn) {
                if (!reworkDisplayId) return setResult({ title: 'No weapon', error: 'Open a forged weapon with View / rework first.' });
                const prompt = document.getElementById('reworkPrompt').value.trim();
                if (!prompt) return setResult({ title: 'No prompt', error: 'Describe the rework.' });
