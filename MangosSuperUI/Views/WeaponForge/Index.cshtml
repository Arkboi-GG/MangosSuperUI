        }
        function spellRows(payload) {
            if (Array.isArray(payload)) return payload;
            return payload?.effects || payload?.results || [];
        }
        async function queryItemSpellEffects(q, trigger, limit = 12) {
            const params = new URLSearchParams({ q: String(q), trigger: String(trigger), limit: String(limit) });
            const response = await fetch('/WeaponForge/ItemSpellEffects?' + params);
            const payload = await response.json().catch(() => null);
            if (!response.ok || payload?.ok === false)
                throw new Error(payload?.error || payload?.note || 'Effect lookup is unavailable.');
            return spellRows(payload);
        }
        function wireItemSpellSearch(card) {
            const search = card.querySelector('.ib-spell-search');
            const idInput = card.querySelector('.ib-spell-id');
            const trigger = card.querySelector('.ib-spell-trigger');
            let timer = null, serial = 0;
            search.addEventListener('input', () => {
                clearTimeout(timer);
                card.dataset.exactSerial = String((+card.dataset.exactSerial || 0) + 1);
                card.dataset.resolvedId = ''; card.dataset.resolvedTrigger = '';
                const mine = ++serial;
                const q = search.value.trim();
                if (q.length < 2 && !/^\d+$/.test(q)) { card.querySelector('.wf-spell-results').classList.remove('open'); return; }
                timer = setTimeout(async () => {
                    try {
                        const rows = await queryItemSpellEffects(q, +trigger.value);
                        if (mine === serial) renderItemSpellResults(card, rows);
                    } catch (e) { if (mine === serial) setSpellResolution(card, false, String(e)); }
                }, 240);
            });
            idInput.addEventListener('change', () => { serial++; resolveExactItemSpell(card); });
            trigger.addEventListener('change', () => {
                serial++; configurePpmField(card); card.dataset.resolvedId = ''; card.dataset.resolvedTrigger = '';
                if (+idInput.value > 0) resolveExactItemSpell(card);
                else if (search.value.trim().length >= 2) search.dispatchEvent(new Event('input'));
                updateItemBuildReview();
            });
        }
        function nativeSlotSummary(effect) {
            const cooldown = effect.cooldownMs >= 0 ? `${effect.cooldownMs}ms` : 'spell default';
            const categoryCooldown = effect.categoryCooldownMs >= 0 ? `${effect.categoryCooldownMs}ms` : 'inherit';
            return `charges ${effect.charges ?? 0} · PPM ${effect.ppmRate ?? 0} · cooldown ${cooldown} · category ${effect.category ?? 0} · category CD ${categoryCooldown}`;
        }
        function renderItemSpellResults(card, rows) {
            const host = card.querySelector('.wf-spell-results');
            if (!rows.length) {
                host.innerHTML = '<div class="wf-spell-result"><span>No native stock-item effects match.</span></div>';
                host.classList.add('open'); return;
            }
            host.innerHTML = rows.map((r, i) => `<button type="button" class="wf-spell-result" data-result-index="${i}">
                <b>${esc(r.name || `Spell ${r.id}`)} <small>#${r.id}</small></b>
                <span>${esc(r.triggerLabel || ITEM_TRIGGER_NAMES[r.trigger] || 'Item effect')} · ${esc(nativeSlotSummary(r))} · used by ${r.usedByCount || 0} stock item(s)${r.hidden ? ' · hidden helper' : ''}${r.description ? ` — ${esc(r.description)}` : ''}</span></button>`).join('');
            host.querySelectorAll('[data-result-index]').forEach(el => el.addEventListener('click', () => selectItemSpell(card, rows[+el.dataset.resultIndex])));
