            return value;
        }
        function collectPrice(prefix) {
            const g = inputNumber(`ib${prefix}Gold`) || 0, s = inputNumber(`ib${prefix}Silver`) || 0, c = inputNumber(`ib${prefix}Copper`) || 0;
            return g * 10000 + s * 100 + c;
        }
        function collectItemConfig() {
            const config = {
                name: document.getElementById('ibName').value.trim(),
                quality: inputNumber('ibQuality'), inventoryType: inputNumber('ibInventoryType'),
                itemLevel: inputNumber('ibItemLevel'), requiredLevel: inputNumber('ibRequiredLevel'),
                damageMin: inputNumber('ibDamageMin'), damageMax: inputNumber('ibDamageMax'), damageType: inputNumber('ibDamageType'),
                stats: [], armor: inputNumber('ibArmor'), block: inputNumber('ibBlock'),
                holyRes: inputNumber('ibHolyRes'), fireRes: inputNumber('ibFireRes'), natureRes: inputNumber('ibNatureRes'),
                frostRes: inputNumber('ibFrostRes'), shadowRes: inputNumber('ibShadowRes'), arcaneRes: inputNumber('ibArcaneRes'),
                maxDurability: inputNumber('ibMaxDurability'), bonding: inputNumber('ibBonding'),
                allowableClass: collectMask('class'), allowableRace: collectMask('race'),
                requiredSkill: inputNumber('ibRequiredSkill'), requiredSkillRank: inputNumber('ibRequiredSkillRank'),
                requiredSpell: inputNumber('ibRequiredSpell'), requiredHonorRank: inputNumber('ibRequiredHonorRank'),
                requiredReputationFaction: inputNumber('ibRequiredReputationFaction'), requiredReputationRank: inputNumber('ibRequiredReputationRank'),
                buyPrice: collectPrice('Buy'), sellPrice: collectPrice('Sell'), spells: [],
            };
            const description = document.getElementById('ibDescription').value.trim();
            if (description) config.description = description;
            const speed = optionalNumber('ibSpeed');
            if (speed !== undefined) config.delayMs = Math.round(speed * 1000);
            document.querySelectorAll('#ibStats .wf-stat-row').forEach(row => {
                const rawType = row.querySelector('.ib-stat-type').value;
                config.stats.push({ type: rawType === '' ? null : Number(rawType), value: Number(row.querySelector('.ib-stat-value').value) });
            });
            document.querySelectorAll('#ibSpells .wf-spell-card').forEach(card => {
                const cooldown = card.querySelector('.ib-spell-cooldown').value.trim();
                const categoryCooldown = card.querySelector('.ib-spell-category-cooldown').value.trim();
                const trigger = Number(card.querySelector('.ib-spell-trigger').value);
                config.spells.push({
                    spellId: Number(card.querySelector('.ib-spell-id').value), trigger,
                    charges: Number(card.querySelector('.ib-spell-charges').value) || 0,
                    ppmRate: trigger === 2 ? (Number(card.querySelector('.ib-spell-ppm').value) || 0) : 0,
                    cooldownMs: cooldown === '' ? -1 : Math.round(Number(cooldown) * 1000),
                    category: Number(card.querySelector('.ib-spell-category').value) || 0,
                    categoryCooldownMs: categoryCooldown === '' ? -1 : Math.round(Number(categoryCooldown) * 1000),
                });
