        async function submitItemBuild() {
            if (itemBuildSubmitting) return;

            // Run native browser range/step validation while controls are still enabled.
            hideItemBuildErrors();
            let config = collectItemConfig();
            const errors = validateItemConfig(config);
            if (errors.length) { showItemBuildErrors(errors); return; }

            itemBuildSubmitting = true;
            const btn = document.getElementById('ibSubmit');
            const modalShell = document.querySelector('#itemBuildModal .wf-build-modal');
            const controls = [...modalShell.querySelectorAll('button, input, select, textarea')];
            const previousDisabled = controls.map(control => control.disabled);
            const status = document.getElementById('ibReadyState');
            const old = btn.innerHTML;
            controls.forEach(control => { control.disabled = true; });
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Validating…';
            modalShell.setAttribute('aria-busy', 'true');
            status.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Validating item configuration…';
            status.style.borderColor = ''; status.style.color = '';
            status.focus({ preventScroll: true });
            try {

                // Capture the reviewed source and geometry controls before asynchronous spell validation.
                const mode = itemBuildState.mode;
                const familyKey = itemBuildState.familyKey;
                const fd = new FormData();
                if (mode === 'glb') {
                    const file = document.getElementById('glbFile').files[0];
                    if (!file) throw new Error('The selected GLB is no longer available.');
                    fd.append('file', file);
                    importParams(fd);
                    fd.set('weaponType', familyKey);
                } else {
                    const lane = LEGACY[mode];
                    if (!lane || !lane.sel) throw new Error(`The selected ${lane ? lane.label : 'import'} weapon is no longer available.`);
                    fd.append('entry', lane.sel.entry);
                    fd.append('model', lane.sel.model);
                    fd.append('displayRow', lane.sel.displayRow);
                    fd.append('weaponType', familyKey);
                    fd.append('targetTriangles', lane.targetTris());
                    laneGlowParams(lane, fd);
                }

                const spellErrors = await validateItemSpells(config);
                if (spellErrors.length) { showItemBuildErrors(spellErrors); setItemBuildTab('effects'); return; }

                // Exact-ID resolution may have populated the selected stock slot values.
                config = collectItemConfig();
                const resolvedErrors = validateItemConfig(config);
                if (resolvedErrors.length) { showItemBuildErrors(resolvedErrors); return; }

                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Forging…';
                status.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Forging the final item…';
                fd.append('name', config.name);
                fd.append('itemConfig', JSON.stringify(config));
                const url = mode === 'glb' ? '/WeaponForge/ForgeGlb' : LEGACY[mode].urls.forge;
                const response = await fetch(url, { method: 'POST', body: fd });
                const d = await response.json().catch(() => null);
                if (!response.ok || !d?.ok) {
                    showItemBuildErrors([d?.error || d?.message || 'Forge failed.', ...(d?.errors || []), ...(d?.diagnostics || [])]);
                    return;
