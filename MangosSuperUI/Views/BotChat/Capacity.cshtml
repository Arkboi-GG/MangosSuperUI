@{
    ViewData["Title"] = "Chat Capacity";
}

<div class="app-shell">
    <partial name="_Sidebar" />

    <div class="main-content">
        <div class="content-header">
            <div>
                <h1><i class="fa-solid fa-server" style="color: var(--accent);"></i> Chat Capacity</h1>
                <p>Inference profiles, kill switches, and the broker surface</p>
            </div>
            <a class="btn-sm btn-outline-subtle" href="/BotChat/Settings">
                <i class="fa-solid fa-comments"></i> Chat Feel
            </a>
        </div>

        <div class="content-body">

            <!-- Kill switches (§14.3: rendered BIG) -->
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fa-solid fa-power-off" style="color: var(--status-error);"></i> Kill Switches
                </div>
                <div class="card-body">
                    <div class="kill-grid">
                        <button class="kill-switch" id="ksChat" data-key="global.chat_enabled">
                            <i class="fa-solid fa-comments"></i>
                            <span class="ks-label">CHAT</span>
                            <span class="ks-state">…</span>
                        </button>
                        <button class="kill-switch" id="ksAmbient" data-key="global.ambient_enabled">
                            <i class="fa-solid fa-wind"></i>
                            <span class="ks-label">AMBIENT</span>
                            <span class="ks-state">…</span>
                        </button>
                    </div>
                    <div class="ks-note">Hot-applied within 5 s (settings snapshot TTL). Chat OFF silences everything; Ambient OFF leaves reactive replies alive.</div>
                </div>
            </div>

            <!-- Inference profiles -->
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="fa-solid fa-microchip" style="color: var(--accent);"></i> Inference Profiles</span>
                    <button class="btn-sm btn-outline-subtle" id="btnAddProfile">
                        <i class="fa-solid fa-plus"></i> Add Profile
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-scroll">
                        <table class="profile-table" id="profileTable">
                            <thead>
                                <tr>
                                    <th>Active</th><th>Name</th><th>Endpoint</th><th>API</th>
                                    <th>Model (Reactive)</th><th>Model (Ambient)</th><th>Model (Batch)</th>
                                    <th>Ctx</th><th>Conc</th><th>Rsvd</th><th>Amb×</th><th></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <div class="ks-note">API: ollama = /api/generate; openai = /v1/chat/completions (vLLM, LM Studio…). On an openai profile, empty model tags auto-resolve from /v1/models. Empty batch model = batch lane disabled on that profile. Activation is storage-only until the InferenceBroker lands (C5).</div>
                </div>
            </div>

            <!-- Broker status (stub — live in C5) -->
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fa-solid fa-heart-pulse" style="color: var(--accent);"></i> Broker Status
                    <span class="phase-tag">live in C5</span>
                </div>
                <div class="card-body">
                    <div class="broker-grid stubbed">
                        <div class="broker-cell"><div class="b-label">Endpoint</div><div class="b-value">—</div></div>
                        <div class="broker-cell"><div class="b-label">Models (/api/tags)</div><div class="b-value">—</div></div>
                        <div class="broker-cell"><div class="b-label">Slots (busy/total)</div><div class="b-value">—</div></div>
                        <div class="broker-cell"><div class="b-label">Reactive queue</div><div class="b-value">—</div></div>
                        <div class="broker-cell"><div class="b-label">Ambient queue</div><div class="b-value">—</div></div>
                        <div class="broker-cell"><div class="b-label">Latency EMA</div><div class="b-value">—</div></div>
                    </div>
                </div>
            </div>

            <!-- Batch controls (disabled until their phases) -->
            <div class="card">
                <div class="card-header">
                    <i class="fa-solid fa-layer-group" style="color: var(--accent);"></i> Batch Lane
                </div>
                <div class="card-body">
                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn-sm btn-outline-subtle" disabled>
                            <i class="fa-solid fa-compress"></i> Run compaction now <span class="phase-tag">C8</span>
                        </button>
                        <button class="btn-sm btn-outline-subtle" id="btnBuildVoices">
                            <i class="fa-solid fa-masks-theater"></i> Build voice library
                        </button>
                        <button class="btn-sm btn-outline-subtle" id="btnRerollSeeds" title="Reassign pre-library personas onto library voices (replaces their cards)">
                            <i class="fa-solid fa-dice"></i> Reroll seed personas
                        </button>
                        <button class="btn-sm btn-outline-subtle" disabled>
                            <i class="fa-solid fa-scroll"></i> Recompile era pack <span class="phase-tag">C10</span>
                        </button>
                    </div>
                    <div class="ks-note" id="voiceStatus">Voice library: loading…</div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Styles {
    <style>
        /* ── Kill switches — BIG ── */
        .kill-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; max-width: 620px; }
        .kill-switch { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 22px 10px; border-radius: 10px; border: 2px solid var(--border); background: transparent; cursor: pointer; transition: all 0.12s; }
        .kill-switch i { font-size: 26px; }
        .kill-switch .ks-label { font-size: 13px; font-weight: 700; letter-spacing: 1.5px; }
        .kill-switch .ks-state { font-size: 11px; text-transform: uppercase; letter-spacing: 0.6px; }
        .kill-switch.on { border-color: var(--status-online); }
        .kill-switch.on i, .kill-switch.on .ks-state { color: var(--status-online); }
        .kill-switch.off { border-color: var(--status-error); background: rgba(220, 60, 60, 0.08); }
        .kill-switch.off i, .kill-switch.off .ks-state { color: var(--status-error); }
        .ks-note { margin-top: 10px; font-size: 11px; color: var(--text-muted); }

        /* ── Profile table ── */
        .table-scroll { overflow-x: auto; }
        .profile-table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .profile-table th { text-align: left; padding: 6px 8px; color: var(--text-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.4px; border-bottom: 1px solid var(--border); }
        .profile-table td { padding: 6px 8px; border-bottom: 1px solid var(--border); vertical-align: middle; }
        .profile-table input[type="text"], .profile-table input[type="number"] { width: 100%; min-width: 60px; font-size: 12px; font-family: monospace; }
        .profile-table .col-name { min-width: 110px; }
        .profile-table .col-url { min-width: 200px; }
        .profile-table .col-model { min-width: 190px; }
        .profile-table .col-num { max-width: 70px; }
        .profile-table .row-actions { white-space: nowrap; }
        .profile-table tr.active-row td { background: rgba(80, 200, 120, 0.06); }

        .phase-tag { font-size: 10px; border: 1px solid var(--border); border-radius: 4px; padding: 1px 6px; margin-left: 6px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.4px; }

        /* ── Broker stub ── */
        .broker-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
        .broker-grid.stubbed { opacity: 0.45; }
        .broker-cell { border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; }
        .broker-cell .b-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.4px; color: var(--text-muted); }
        .broker-cell .b-value { font-size: 16px; font-weight: 600; margin-top: 2px; }

        /* ── Toast ── */
        .chat-toast { position: fixed; bottom: 24px; right: 24px; padding: 10px 16px; border-radius: 8px; font-size: 13px; z-index: 3000; animation: toastIn 0.15s ease-out; }
        .chat-toast.success { background: var(--status-online); color: white; }
        .chat-toast.error { background: var(--status-error); color: white; }
        @@keyframes toastIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
}

@section Scripts {
    <script src="~/js/chatcapacity.js" asp-append-version="true"></script>
}
