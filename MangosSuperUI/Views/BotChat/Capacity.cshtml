@{
    ViewData["Title"] = "Chat Capacity";
}

<div class="app-shell">
    <partial name="_Sidebar" />

    <div class="main-content">
        <div class="content-header">
            <div>
                <h1><i class="fa-solid fa-server" style="color: var(--accent);"></i> Chat Capacity</h1>
                <p>Inference profiles, kill switches, the voice library, and chat health</p>
            </div>
            <a class="btn-sm btn-outline-subtle" href="/BotChat/Settings">
                <i class="fa-solid fa-comments"></i> Chat Feel
            </a>
        </div>

        <div class="content-body">

            <!-- Kill switches (§14.3: rendered BIG) -->
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fa-solid fa-power-off" style="color: var(--status-error);"></i> Kill Switches
                </div>
                <div class="card-body">
                    <div class="kill-grid">
                        <button class="kill-switch" id="ksChat" data-key="global.chat_enabled">
                            <i class="fa-solid fa-comments"></i>
                            <span class="ks-label">CHAT</span>
                            <span class="ks-state">…</span>
                        </button>
                        <button class="kill-switch" id="ksAmbient" data-key="global.ambient_enabled">
                            <i class="fa-solid fa-wind"></i>
                            <span class="ks-label">AMBIENT</span>
                            <span class="ks-state">…</span>
                        </button>
                    </div>
                    <div class="ks-note">Hot-applied within 5 s (settings snapshot TTL). Chat OFF silences everything; Ambient OFF leaves reactive replies alive.</div>
                </div>
            </div>

            <!-- Inference profiles -->
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="fa-solid fa-microchip" style="color: var(--accent);"></i> Inference Profiles</span>
                    <span>
                        <button class="btn-sm btn-outline-subtle" id="btnDetectModels" title="Ask each endpoint what it serves and turn the model fields into pick-lists">
                            <i class="fa-solid fa-satellite-dish"></i> Detect models
                        </button>
                        <button class="btn-sm btn-outline-subtle" id="btnAddProfile">
                            <i class="fa-solid fa-plus"></i> Add Profile
                        </button>
                    </span>
                </div>
                <div class="card-body">
                    <div class="table-scroll">
                        <table class="profile-table" id="profileTable">
                            <thead>
                                <tr>
                                    <th>Active</th>
                                    <th>Name</th>
                                    <th>Endpoint</th>
                                    <th>API</th>
                                    <th>Model (Reactive)</th>
                                    <th>Model (Ambient)</th>
                                    <th>Model (Batch)</th>
                                    <th>Ctx</th>
                                    <th>Conc</th>
                                    <th>Rsvd</th>
                                    <th>Amb×</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <div class="ks-note">
                        API: ollama = /api/generate; openai = /v1/chat/completions (vLLM, LM Studio…).
                        <strong>Model (Batch)</strong> is what builds the voice library — the one inference run every
                        bot on the server inherits from. Leave it empty and the build silently falls back to the
                        reactive model. Hit <em>Detect models</em> to fill the pick-lists from the endpoint itself.
                    </div>
                </div>
            </div>

            <!-- ─────────────── Voice library ─────────────── -->
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="fa-solid fa-masks-theater" style="color: var(--accent);"></i> Voice Library</span>
                    <button class="btn-sm btn-outline-subtle" id="btnRefreshLibHealth" title="Re-run the checks">
                        <i class="fa-solid fa-rotate"></i>
                    </button>
                </div>
                <div class="card-body">

                    <div class="health-checks" id="libChecks">
                        <div class="hc-loading">Running checks…</div>
                    </div>

                    <div class="stat-grid" id="libStats"></div>

                    <div class="dist-row">
                        <div class="dist-col"><div class="dist-title">Swear register</div><div id="libSwear"></div></div>
                        <div class="dist-col"><div class="dist-title">Typing caps</div><div id="libCaps"></div></div>
                        <div class="dist-col"><div class="dist-title">Most-used names</div><div id="libNames"></div></div>
                        <div class="dist-col"><div class="dist-title">Example-line openers</div><div id="libBigrams"></div></div>
                    </div>

                    <details class="sample-details">
                        <summary>Spot-read 3 random cards</summary>
                        <pre id="libSamples" class="card-sample"></pre>
                    </details>

                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <button class="btn-sm btn-outline-subtle" id="btnBuildVoices">
                            <i class="fa-solid fa-hammer"></i> Build / top up library
                        </button>
                        <button class="btn-sm btn-danger-subtle" id="btnRebuildVoices"
                                title="Retire every voice, detach every persona, and build a clean library">
                            <i class="fa-solid fa-trash-arrow-up"></i> Rebuild from scratch
                        </button>
                        <button class="btn-sm btn-outline-subtle" id="btnReassignAll"
                                title="Redraw EVERY persona from the current library (their cards are replaced)">
                            <i class="fa-solid fa-shuffle"></i> Reassign all personas
                        </button>
                        <button class="btn-sm btn-outline-subtle" id="btnRerollSeeds"
                                title="Reassign only personas that never had a library voice">
                            <i class="fa-solid fa-dice"></i> Reroll seed personas
                        </button>
                    </div>
                    <div class="ks-note" id="voiceStatus">Voice library: loading…</div>
                </div>
            </div>

            <!-- ─────────────── Chat health ─────────────── -->
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="fa-solid fa-wave-square" style="color: var(--accent);"></i> Chat Health <span class="phase-tag" id="chatHealthWindow">last 7 days</span></span>
                    <span>
                        <select class="form-control d-inline-block" id="healthDays" style="width: auto; font-size: 12px;">
                            <option value="1">1 day</option>
                            <option value="7" selected>7 days</option>
                            <option value="30">30 days</option>
                        </select>
                        <button class="btn-sm btn-outline-subtle" id="btnRefreshChatHealth"><i class="fa-solid fa-rotate"></i></button>
                    </span>
                </div>
                <div class="card-body">
                    <div class="health-checks" id="chatChecks">
                        <div class="hc-loading">Running checks…</div>
                    </div>

                    <div class="stat-grid" id="chatStats"></div>

                    <div class="dist-row">
                        <div class="dist-col"><div class="dist-title">Most repeated lines</div><div id="chatRepeats"></div></div>
                        <div class="dist-col"><div class="dist-title">Opening bigrams (register)</div><div id="chatBigrams"></div></div>
                        <div class="dist-col"><div class="dist-title">Discarded before send</div><div id="chatDiscards"></div></div>
                    </div>
                    <div class="ks-note">
                        Exact duplication and <em>opening variety</em> are different failures. A fleet can be 92%
                        "distinct" and still open every single line the same way — that's register collapse, and it
                        comes from the persona few-shot anchors, not the sampler.
                    </div>
                </div>
            </div>

            <!-- Broker status (stub — live in C5) -->
            <div class="card">
                <div class="card-header">
                    <i class="fa-solid fa-heart-pulse" style="color: var(--accent);"></i> Broker Status
                    <span class="phase-tag">live in C5</span>
                </div>
                <div class="card-body">
                    <div class="broker-grid stubbed">
                        <div class="broker-cell"><div class="b-label">Endpoint</div><div class="b-value">—</div></div>
                        <div class="broker-cell"><div class="b-label">Models</div><div class="b-value">—</div></div>
                        <div class="broker-cell"><div class="b-label">Slots (busy/total)</div><div class="b-value">—</div></div>
                        <div class="broker-cell"><div class="b-label">Reactive queue</div><div class="b-value">—</div></div>
                        <div class="broker-cell"><div class="b-label">Ambient queue</div><div class="b-value">—</div></div>
                        <div class="broker-cell"><div class="b-label">Latency EMA</div><div class="b-value">—</div></div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <button class="btn-sm btn-outline-subtle" disabled>
                            <i class="fa-solid fa-compress"></i> Run compaction now <span class="phase-tag">C8</span>
                        </button>
                        <button class="btn-sm btn-outline-subtle" disabled>
                            <i class="fa-solid fa-scroll"></i> Recompile era pack <span class="phase-tag">C10</span>
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ─────────────── Preflight modal ─────────────── -->
<div class="pf-backdrop" id="pfModal" hidden>
    <div class="pf-dialog">
        <div class="pf-head">
            <span id="pfTitle"><i class="fa-solid fa-clipboard-check"></i> Build preflight</span>
            <button class="btn-sm btn-outline-subtle" id="pfClose"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="pf-body">
            <div class="health-checks" id="pfChecks"></div>
            <div class="pf-summary" id="pfSummary"></div>
            <div class="pf-warn" id="pfDestructive" hidden>
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span id="pfDestructiveText"></span>
            </div>
        </div>
        <div class="pf-foot">
            <label class="pf-force" id="pfForceWrap" hidden>
                <input type="checkbox" id="pfForce"> Run anyway (I know it will fail)
            </label>
            <button class="btn-sm btn-outline-subtle" id="pfCancel">Cancel</button>
            <button class="btn-sm btn-primary-subtle" id="pfConfirm" disabled>Start</button>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* ── Kill switches — BIG ── */
        .kill-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            max-width: 620px;
        }

        .kill-switch {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            padding: 22px 10px;
            border-radius: 10px;
            border: 2px solid var(--border);
            background: transparent;
            cursor: pointer;
            transition: all 0.12s;
        }

            .kill-switch i {
                font-size: 26px;
            }

            .kill-switch .ks-label {
                font-size: 13px;
                font-weight: 700;
                letter-spacing: 1.5px;
            }

            .kill-switch .ks-state {
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 0.6px;
            }

            .kill-switch.on {
                border-color: var(--status-online);
            }

                .kill-switch.on i, .kill-switch.on .ks-state {
                    color: var(--status-online);
                }

            .kill-switch.off {
                border-color: var(--status-error);
                background: rgba(220, 60, 60, 0.08);
            }

                .kill-switch.off i, .kill-switch.off .ks-state {
                    color: var(--status-error);
                }

        .ks-note {
            margin-top: 10px;
            font-size: 11px;
            color: var(--text-muted);
            line-height: 1.5;
        }

        /* ── Profile table ── */
        .table-scroll {
            overflow-x: auto;
        }

        .profile-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }

            .profile-table th {
                text-align: left;
                padding: 6px 8px;
                color: var(--text-muted);
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 0.4px;
                border-bottom: 1px solid var(--border);
            }

            .profile-table td {
                padding: 6px 8px;
                border-bottom: 1px solid var(--border);
                vertical-align: middle;
            }

            .profile-table input[type="text"], .profile-table input[type="number"] {
                width: 100%;
                min-width: 60px;
                font-size: 12px;
                font-family: monospace;
            }

            .profile-table .col-name {
                min-width: 110px;
            }

            .profile-table .col-url {
                min-width: 200px;
            }

            .profile-table .col-model {
                min-width: 190px;
            }

            .profile-table .col-num {
                max-width: 70px;
            }

            .profile-table .row-actions {
                white-space: nowrap;
            }

            .profile-table tr.active-row td {
                background: rgba(80, 200, 120, 0.06);
            }

            .profile-table td.col-batch input {
                border-color: var(--accent);
            }

        .phase-tag {
            font-size: 10px;
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 1px 6px;
            margin-left: 6px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

        /* ── Health checks ── */
        .health-checks {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 14px;
        }

        .hc-loading {
            font-size: 12px;
            color: var(--text-muted);
        }

        .hc {
            display: flex;
            gap: 10px;
            align-items: flex-start;
            padding: 8px 10px;
            border-radius: 6px;
            border: 1px solid var(--border);
            font-size: 12px;
        }

            .hc i {
                margin-top: 2px;
            }

            .hc .hc-label {
                font-weight: 600;
                min-width: 150px;
            }

            .hc .hc-detail {
                color: var(--text-muted);
                line-height: 1.5;
            }

            .hc.pass {
                border-color: rgba(80, 200, 120, 0.35);
            }

                .hc.pass i {
                    color: var(--status-online);
                }

            .hc.warn {
                border-color: rgba(230, 170, 60, 0.45);
                background: rgba(230, 170, 60, 0.05);
            }

                .hc.warn i {
                    color: #e6aa3c;
                }

            .hc.fail {
                border-color: rgba(220, 60, 60, 0.5);
                background: rgba(220, 60, 60, 0.07);
            }

                .hc.fail i {
                    color: var(--status-error);
                }

        /* ── Stats + distributions ── */
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 10px;
            margin-bottom: 14px;
        }

        .stat-cell {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px 10px;
        }

            .stat-cell .s-label {
                font-size: 10px;
                text-transform: uppercase;
                letter-spacing: 0.4px;
                color: var(--text-muted);
            }

            .stat-cell .s-value {
                font-size: 18px;
                font-weight: 600;
                margin-top: 2px;
            }

            .stat-cell.bad .s-value {
                color: var(--status-error);
            }

        .dist-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 14px;
        }

        .dist-col {
            min-width: 0;
        }

        .dist-title {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .bar-row {
            display: grid;
            grid-template-columns: 26px 1fr;
            gap: 8px;
            align-items: center;
            font-size: 11px;
            margin-bottom: 3px;
        }

            .bar-row .b-n {
                text-align: right;
                font-family: monospace;
                color: var(--text-muted);
            }

            .bar-row .b-k {
                position: relative;
                padding: 2px 6px;
                border-radius: 3px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .bar-row .b-fill {
                position: absolute;
                inset: 0;
                background: var(--accent);
                opacity: 0.14;
                border-radius: 3px;
            }

            .bar-row .b-t {
                position: relative;
            }

        .dist-empty {
            font-size: 11px;
            color: var(--text-muted);
            font-style: italic;
        }

        .sample-details {
            margin-top: 14px;
        }

            .sample-details summary {
                font-size: 12px;
                color: var(--text-muted);
                cursor: pointer;
            }

        .card-sample {
            margin-top: 8px;
            padding: 10px;
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: 11px;
            font-family: monospace;
            white-space: pre-wrap;
            max-height: 320px;
            overflow: auto;
        }

        /* ── Buttons ── */
        .btn-danger-subtle {
            border: 1px solid rgba(220, 60, 60, 0.5);
            color: var(--status-error);
            background: transparent;
            border-radius: 6px;
            padding: 5px 10px;
            cursor: pointer;
        }

            .btn-danger-subtle:hover {
                background: rgba(220, 60, 60, 0.1);
            }

        .btn-primary-subtle {
            border: 1px solid var(--accent);
            color: var(--accent);
            background: transparent;
            border-radius: 6px;
            padding: 5px 12px;
            cursor: pointer;
        }

            .btn-primary-subtle:disabled {
                opacity: 0.4;
                cursor: not-allowed;
            }

        /* ── Broker stub ── */
        .broker-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }

            .broker-grid.stubbed {
                opacity: 0.45;
            }

        .broker-cell {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px 12px;
        }

            .broker-cell .b-label {
                font-size: 10px;
                text-transform: uppercase;
                letter-spacing: 0.4px;
                color: var(--text-muted);
            }

            .broker-cell .b-value {
                font-size: 16px;
                font-weight: 600;
                margin-top: 2px;
            }

        /* ── Preflight modal ── */
        .pf-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.55);
            z-index: 2900;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .pf-dialog {
            width: min(760px, 92vw);
            max-height: 86vh;
            display: flex;
            flex-direction: column;
            background: var(--bg-panel, #1c1f24);
            border: 1px solid var(--border);
            border-radius: 10px;
        }

        .pf-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border);
            font-weight: 600;
        }

        .pf-body {
            padding: 16px;
            overflow: auto;
        }

        .pf-foot {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            padding: 12px 16px;
            border-top: 1px solid var(--border);
        }

        .pf-force {
            margin-right: auto;
            font-size: 11px;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .pf-summary {
            font-size: 12px;
            color: var(--text-muted);
            line-height: 1.6;
        }

        .pf-warn {
            margin-top: 12px;
            padding: 10px 12px;
            border: 1px solid rgba(220,60,60,0.5);
            background: rgba(220,60,60,0.08);
            border-radius: 6px;
            font-size: 12px;
            display: flex;
            gap: 10px;
        }

            .pf-warn i {
                color: var(--status-error);
                margin-top: 2px;
            }

        /* ── Toast ── */
        .chat-toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            padding: 10px 16px;
            border-radius: 8px;
            font-size: 13px;
            z-index: 3000;
            animation: toastIn 0.15s ease-out;
            max-width: 420px;
        }

            .chat-toast.success {
                background: var(--status-online);
                color: white;
            }

            .chat-toast.error {
                background: var(--status-error);
                color: white;
            }

        @@keyframes toastIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
}

@section Scripts {
    <script src="~/js/chatcapacity.js" asp-append-version="true"></script>
}
